de-master:4040/jobs/job?id=460"},{"jobUrl":"http://node-master:4040/jobs/job?id=461"},{"jobUrl":"http://node-master:4040/jobs/job?id=462"},{"jobUrl":"http://node-master:4040/jobs/job?id=463"},{"jobUrl":"http://node-master:4040/jobs/job?id=464"},{"jobUrl":"http://node-master:4040/jobs/job?id=465"},{"jobUrl":"http://node-master:4040/jobs/job?id=466"},{"jobUrl":"http://node-master:4040/jobs/job?id=467"},{"jobUrl":"http://node-master:4040/jobs/job?id=468"},{"jobUrl":"http://node-master:4040/jobs/job?id=469"},{"jobUrl":"http://node-master:4040/jobs/job?id=470"},{"jobUrl":"http://node-master:4040/jobs/job?id=471"},{"jobUrl":"http://node-master:4040/jobs/job?id=472"},{"jobUrl":"http://node-master:4040/jobs/job?id=473"},{"jobUrl":"http://node-master:4040/jobs/job?id=474"},{"jobUrl":"http://node-master:4040/jobs/job?id=475"},{"jobUrl":"http://node-master:4040/jobs/job?id=476"},{"jobUrl":"http://node-master:4040/jobs/job?id=477"},{"jobUrl":"http://node-master:4040/jobs/job?id=478"},{"jobUrl":"http://node-master:4040/jobs/job?id=479"},{"jobUrl":"http://node-master:4040/jobs/job?id=480"},{"jobUrl":"http://node-master:4040/jobs/job?id=481"},{"jobUrl":"http://node-master:4040/jobs/job?id=482"},{"jobUrl":"http://node-master:4040/jobs/job?id=483"},{"jobUrl":"http://node-master:4040/jobs/job?id=484"},{"jobUrl":"http://node-master:4040/jobs/job?id=485"},{"jobUrl":"http://node-master:4040/jobs/job?id=486"},{"jobUrl":"http://node-master:4040/jobs/job?id=487"},{"jobUrl":"http://node-master:4040/jobs/job?id=488"},{"jobUrl":"http://node-master:4040/jobs/job?id=489"},{"jobUrl":"http://node-master:4040/jobs/job?id=490"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705650191_975703701","id":"paragraph_1774705650191_975703701","dateCreated":"2026-03-28T21:47:30+0800","dateStarted":"2026-03-28T22:20:57+0800","dateFinished":"2026-03-28T22:21:16+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n\n# Analyze yearly rating trend by crime zone (2018-2022)\n# Algorithm: Time-Series Aggregation with GROUP BY year and crime_zone\n\nbiz_crime = spark.table(\"external_data.v_philly_biz_crime_zone\")\nreview    = spark.table(\"yelp.review\")\n\n# Join reviews with crime zone\nreview_crime = review.join(\n    biz_crime.select(\"business_id\", \"crime_zone\"),\n    review[\"rev_business_id\"] == biz_crime[\"business_id\"],\n    how=\"inner\"\n).filter(\n    (F.col(\"crime_zone\") != \"UNKNOWN\") &\n    (F.col(\"rev_date\") >= \"2018-01-01\") &\n    (F.col(\"rev_date\") <= \"2022-12-31\")\n)\n\n# Yearly avg stars and review count by crime zone\nrating_trend = review_crime.groupBy(\n    \"crime_zone\",\n    F.year(\"rev_date\").alias(\"year\")\n).agg(\n    F.round(F.avg(\"rev_stars\"), 3).alias(\"avg_stars\"),\n    F.count(\"*\").alias(\"review_count\")\n).orderBy(\"crime_zone\", \"year\")\n\nrating_trend.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_rating_trend_by_crime_zone\"\n)\n\nz.show(rating_trend)","user":"anonymous","dateUpdated":"2026-03-28T22:20:32+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"year","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"crime_zone\tyear\tavg_stars\treview_count\nHIGH\t2018\t3.92\t7425\nHIGH\t2019\t3.902\t7831\nHIGH\t2020\t3.915\t4145\nHIGH\t2021\t3.893\t4112\nHIGH\t2022\t3.949\t197\nLOW\t2018\t3.765\t6560\nLOW\t2019\t3.757\t6501\nLOW\t2020\t3.856\t3285\nLOW\t2021\t3.78\t2977\nLOW\t2022\t4.013\t156\nMEDIUM\t2018\t3.917\t14664\nMEDIUM\t2019\t3.93\t13738\nMEDIUM\t2020\t3.956\t6940\nMEDIUM\t2021\t3.933\t7496\nMEDIUM\t2022\t3.955\t375\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=263"},{"jobUrl":"http://node-master:4040/jobs/job?id=264"},{"jobUrl":"http://node-master:4040/jobs/job?id=265"},{"jobUrl":"http://node-master:4040/jobs/job?id=266"},{"jobUrl":"http://node-master:4040/jobs/job?id=267"},{"jobUrl":"http://node-master:4040/jobs/job?id=268"},{"jobUrl":"http://node-master:4040/jobs/job?id=269"},{"jobUrl":"http://node-master:4040/jobs/job?id=270"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705694403_1382549289","id":"paragraph_1774705694403_1382549289","dateCreated":"2026-03-28T21:48:14+0800","dateStarted":"2026-03-28T22:15:38+0800","dateFinished":"2026-03-28T22:16:26+0800","status":"FINISHED"},{"text":"%spark.pyspark\n# Analyze check-in volume correlation with crime zone\n# Algorithm: Pearson Correlation proxy via GROUP BY aggregation\n\nbiz_crime = spark.table(\"external_data.v_philly_biz_crime_zone\")\ncheckin   = spark.table(\"yelp.checkin\")\n\n# Join checkins with crime zone\ncheckin_crime = checkin.join(\n    biz_crime.select(\"business_id\", \"crime_zone\"),\n    on=\"business_id\",\n    how=\"inner\"\n).filter(\n    F.col(\"crime_zone\") != \"UNKNOWN\"\n)\n\n# Avg checkins per business per crime zone\ncheckin_zone = checkin_crime.groupBy(\n    \"crime_zone\", \"business_id\"\n).agg(\n    F.count(\"*\").alias(\"total_checkins\")\n)\n\ncheckin_summary = checkin_zone.groupBy(\"crime_zone\").agg(\n    F.round(F.avg(\"total_checkins\"), 1).alias(\"avg_checkins_per_biz\"),\n    F.sum(\"total_checkins\").alias(\"total_checkins\"),\n    F.count(\"business_id\").alias(\"business_count\")\n).orderBy(\n    F.when(F.col(\"crime_zone\") == \"HIGH\",   1)\n     .when(F.col(\"crime_zone\") == \"MEDIUM\", 2)\n     .otherwise(3)\n)\n\nprint(\"=== ANALYSIS 5: Check-in Volume by Crime Zone ===\")\ncheckin_summary.show()\n\ncheckin_summary.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_checkin_by_crime_zone\"\n)\nprint(\"Saved.\")\n\nz.show(checkin_summary)","user":"anonymous","dateUpdated":"2026-03-29T00:27:47+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"avg_checkins_per_biz","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== ANALYSIS 5: Check-in Volume by Crime Zone ===\n+----------+--------------------+--------------+--------------+\n|crime_zone|avg_checkins_per_biz|total_checkins|business_count|\n+----------+--------------------+--------------+--------------+\n|      HIGH|                 1.0|           658|           658|\n|    MEDIUM|                 1.0|          1092|          1092|\n|       LOW|                 1.0|           620|           620|\n+----------+--------------------+--------------+--------------+\n\nSaved.\n"},{"type":"TABLE","data":"crime_zone\tavg_checkins_per_biz\ttotal_checkins\tbusiness_count\nHIGH\t1.0\t658\t658\nMEDIUM\t1.0\t1092\t1092\nLOW\t1.0\t620\t620\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=282"},{"jobUrl":"http://node-master:4040/jobs/job?id=283"},{"jobUrl":"http://node-master:4040/jobs/job?id=284"},{"jobUrl":"http://node-master:4040/jobs/job?id=285"},{"jobUrl":"http://node-master:4040/jobs/job?id=286"},{"jobUrl":"http://node-master:4040/jobs/job?id=287"},{"jobUrl":"http://node-master:4040/jobs/job?id=288"},{"jobUrl":"http://node-master:4040/jobs/job?id=289"},{"jobUrl":"http://node-master:4040/jobs/job?id=290"},{"jobUrl":"http://node-master:4040/jobs/job?id=291"},{"jobUrl":"http://node-master:4040/jobs/job?id=292"},{"jobUrl":"http://node-master:4040/jobs/job?id=293"},{"jobUrl":"http://node-master:4040/jobs/job?id=294"},{"jobUrl":"http://node-master:4040/jobs/job?id=295"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774706020598_902408665","id":"paragraph_1774706020598_902408665","dateCreated":"2026-03-28T21:53:40+0800","dateStarted":"2026-03-28T22:19:47+0800","dateFinished":"2026-03-28T22:19:55+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n# Join all analysis views into one final summary table\n# Algorithm: Multi-table JOIN with composite metric aggregation\n\nsurvival = spark.table(\"external_data.v_survival_by_crime_zone\")\nratings  = spark.table(\"external_data.v_ratings_by_crime_zone\")\ncheckins = spark.table(\"external_data.v_checkin_by_crime_zone\")\n\n# Join all findings into one summary\nsummary = survival.join(ratings, on=\"crime_zone\") \\\n                  .join(checkins, on=\"crime_zone\") \\\n                  .select(\n                      \"crime_zone\",\n                      \"total_restaurants\",\n                      \"survival_rate_pct\",\n                      ratings[\"avg_stars\"],\n                      ratings[\"avg_review_count\"],\n                      \"avg_checkins_per_biz\"\n                  ).orderBy(\n                      F.when(F.col(\"crime_zone\") == \"HIGH\",   1)\n                       .when(F.col(\"crime_zone\") == \"MEDIUM\", 2)\n                       .otherwise(3)\n                  )\n\nprint(\"=== FINAL SUMMARY: Crime-Dining Correlation ===\")\nsummary.show()\n\nsummary.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_crime_dining_summary\"\n)\nprint(\"\\nAll analysis complete. All views saved to external_data database.\")\n\nz.show(summary)","user":"anonymous","dateUpdated":"2026-03-29T00:28:09+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_restaurants","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== FINAL SUMMARY: Crime-Dining Correlation ===\n+----------+-----------------+-----------------+---------+----------------+--------------------+\n|crime_zone|total_restaurants|survival_rate_pct|avg_stars|avg_review_count|avg_checkins_per_biz|\n+----------+-----------------+-----------------+---------+----------------+--------------------+\n|      HIGH|              678|            68.44|    3.636|            94.5|                 1.0|\n|    MEDIUM|             1125|            60.98|    3.572|           114.1|                 1.0|\n|       LOW|              634|            67.35|    3.497|            86.1|                 1.0|\n+----------+-----------------+-----------------+---------+----------------+--------------------+\n\n\nAll analysis complete. All views saved to external_data database.\n"},{"type":"TABLE","data":"crime_zone\ttotal_restaurants\tsurvival_rate_pct\tavg_stars\tavg_review_count\tavg_checkins_per_biz\nHIGH\t678\t68.44\t3.636\t94.5\t1.0\nMEDIUM\t1125\t60.98\t3.572\t114.1\t1.0\nLOW\t634\t67.35\t3.497\t86.1\t1.0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK 