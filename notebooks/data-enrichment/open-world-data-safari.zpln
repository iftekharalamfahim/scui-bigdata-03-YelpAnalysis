{"paragraphs":[{"text":"%spark.pyspark\r\n\r\nfrom pyspark.sql import SparkSession\r\nfrom pyspark.sql import functions as F\r\n\r\nspark = SparkSession.builder \\\r\n    .appName(\"YelpInsight-CrimeDining\") \\\r\n    .config(\"spark.sql.catalogImplementation\", \"hive\") \\\r\n    .enableHiveSupport() \\\r\n    .getOrCreate()\r\n\r\nspark.sparkContext.setLogLevel(\"WARN\")\r\n\r\n# Load crime table\r\ncrime = spark.table(\"external_data.philadelphia_crime\")\r\n\r\n# Load Yelp business table\r\nbusiness = spark.table(\"yelp.business\")\r\n\r\n# Filter Philadelphia businesses only\r\nphilly_biz = business.filter(\r\n    (F.col(\"city\") == \"Philadelphia\") &\r\n    (F.col(\"state\") == \"PA\")\r\n)\r\n\r\nprint(f\"Total crime records : {crime.count():,}\")\r\nprint(f\"Philadelphia businesses: {philly_biz.count():,}\")\r\n","user":"anonymous","dateUpdated":"2026-03-28T22:14:10+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Hive Session ID = 6f69b76c-51e5-4644-a32f-47a35c7a882f\nTotal crime records : 736,033\nPhiladelphia businesses: 14,567\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=0"},{"jobUrl":"http://node-master:4040/jobs/job?id=1"},{"jobUrl":"http://node-master:4040/jobs/job?id=2"},{"jobUrl":"http://node-master:4040/jobs/job?id=3"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774582938942_359459472","id":"paragraph_1774582938942_359459472","dateCreated":"2026-03-27T11:42:18+0800","dateStarted":"2026-03-28T19:48:58+0800","dateFinished":"2026-03-28T19:49:19+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n\n# Load philadelphia_crime, business, review, checkin tables\n# Define crime severity classification (Rule-Based Classification)\n\nfrom pyspark.sql import functions as F\nfrom pyspark.sql.window import Window\n\n# ── Load tables ───────────────────────────────────────────────\ncrime   = spark.table(\"external_data.philadelphia_crime\")\nbusiness = spark.table(\"yelp.business\")\nreview   = spark.table(\"yelp.review\")\ncheckin  = spark.table(\"yelp.checkin\")\n\n# ── Filter Philadelphia only ──────────────────────────────────\nphilly_biz = business.filter(\n    (F.col(\"city\") == \"Philadelphia\") &\n    (F.col(\"state\") == \"PA\") &\n    F.col(\"categories\").contains(\"Restaurants\")\n)\n\nprint(f\"Total crime records      : {crime.count():,}\")\nprint(f\"Philadelphia restaurants : {philly_biz.count():,}\")\n\n# ── Define crime severity classification ──────────────────────\nHIGH_SEVERITY = [\n    \"Aggravated Assault Firearm\",\n    \"Aggravated Assault No Firearm\",\n    \"Robbery Firearm\",\n    \"Robbery No Firearm\",\n    \"Weapon Violations\",\n    \"Homicide - Criminal\"\n]\n\nMEDIUM_SEVERITY = [\n    \"Thefts\",\n    \"Theft from Vehicle\",\n    \"Motor Vehicle Theft\",\n    \"Burglary Residential\",\n    \"Burglary Non-Residential\",\n    \"Narcotic / Drug Law Violations\"\n]\n\n# Build severity column\nseverity_expr = (\n    F.when(F.col(\"text_general_code\").isin(HIGH_SEVERITY),   \"HIGH\")\n     .when(F.col(\"text_general_code\").isin(MEDIUM_SEVERITY), \"MEDIUM\")\n     .otherwise(\"LOW\")\n)\n\ncrime = crime.withColumn(\"severity\", severity_expr)\n\nprint(\"\\nSeverity distribution:\")\ncrime.groupBy(\"severity\").count().orderBy(\"severity\").show()\n\nz.show(crime.groupBy(\"severity\").count().orderBy(\"severity\"))","user":"anonymous","dateUpdated":"2026-03-28T22:25:39+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total crime records      : 736,033\nPhiladelphia restaurants : 5,852\n\nSeverity distribution:\n+--------+------+\n|severity| count|\n+--------+------+\n|    HIGH| 86047|\n|     LOW|366140|\n|  MEDIUM|283846|\n+--------+------+\n\n"},{"type":"TABLE","data":"severity\tcount\nHIGH\t86047\nLOW\t366140\nMEDIUM\t283846\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=544"},{"jobUrl":"http://node-master:4040/jobs/job?id=545"},{"jobUrl":"http://node-master:4040/jobs/job?id=546"},{"jobUrl":"http://node-master:4040/jobs/job?id=547"},{"jobUrl":"http://node-master:4040/jobs/job?id=548"},{"jobUrl":"http://node-master:4040/jobs/job?id=549"},{"jobUrl":"http://node-master:4040/jobs/job?id=550"},{"jobUrl":"http://node-master:4040/jobs/job?id=551"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774690935452_1758933167","id":"paragraph_1774690935452_1758933167","dateCreated":"2026-03-28T17:42:15+0800","dateStarted":"2026-03-28T22:25:03+0800","dateFinished":"2026-03-28T22:25:05+0800","status":"FINISHED"},{"text":"%spark.pyspark\n\n# Aggregate crime counts by police district and year\n# Assign crime zones using Percentile-Based Thresholding (approxQuantile)\n\n# Crime count by district and year\ncrime_by_district = crime.groupBy(\n    \"dc_dist\", \"crime_year\"\n).agg(\n    F.count(\"*\").alias(\"total_crimes\"),\n    F.sum(\n        F.when(F.col(\"severity\") == \"HIGH\", 1).otherwise(0)\n    ).alias(\"high_severity_count\"),\n    F.sum(\n        F.when(F.col(\"severity\") == \"MEDIUM\", 1).otherwise(0)\n    ).alias(\"medium_severity_count\"),\n    F.sum(\n        F.when(F.col(\"severity\") == \"LOW\", 1).otherwise(0)\n    ).alias(\"low_severity_count\")\n).orderBy(\"dc_dist\", \"crime_year\")\n\n# Overall crime rate by district (all years combined) \ncrime_overall = crime.groupBy(\"dc_dist\").agg(\n    F.count(\"*\").alias(\"total_crimes\"),\n    F.sum(\n        F.when(F.col(\"severity\") == \"HIGH\", 1).otherwise(0)\n    ).alias(\"high_severity_count\")\n)\n\n# Define crime zone per district \n\nquantiles = crime_overall.approxQuantile(\n    \"total_crimes\", [0.33, 0.66], 0.01\n)\nt33 = quantiles[0]\nt66 = quantiles[1]\n\nprint(f\"Crime zone thresholds:\")\nprint(f\"  LOW    : total_crimes < {t33:.0f}\")\nprint(f\"  MEDIUM : {t33:.0f} <= total_crimes < {t66:.0f}\")\nprint(f\"  HIGH   : total_crimes >= {t66:.0f}\")\n\ncrime_zones = crime_overall.withColumn(\n    \"crime_zone\",\n    F.when(F.col(\"total_crimes\") >= t66, \"HIGH\")\n     .when(F.col(\"total_crimes\") >= t33, \"MEDIUM\")\n     .otherwise(\"LOW\")\n)\n\nprint(\"\\nCrime zones per district:\")\ncrime_zones.orderBy(F.desc(\"total_crimes\")).show(20)\n\n# Save as Hive view\ncrime_zones.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_crime_zones\"\n)\ncrime_by_district.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_crime_by_district_year\"\n)\nprint(\"Views saved.\")\n\nz.show(crime_zones.orderBy(F.desc(\"total_crimes\")))","user":"anonymous","dateUpdated":"2026-03-28T22:26:40+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"dc_dist","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_crimes","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Crime zone thresholds:\n  LOW    : total_crimes < 29305\n  MEDIUM : 29305 <= total_crimes < 41540\n  HIGH   : total_crimes >= 41540\n\nCrime zones per district:\n+-------+------------+-------------------+----------+\n|dc_dist|total_crimes|high_severity_count|crime_zone|\n+-------+------------+-------------------+----------+\n|     24|       54050|               7441|      HIGH|\n|     15|       52924|               6643|      HIGH|\n|     22|       51671|               7396|      HIGH|\n|     19|       48433|               5640|      HIGH|\n|     35|       46575|               6523|      HIGH|\n|     25|       43471|               8197|      HIGH|\n|     14|       41746|               4574|      HIGH|\n|     12|       41540|               5657|      HIGH|\n|     39|       41255|               5813|    MEDIUM|\n|     18|       38716|               4823|    MEDIUM|\n|     06|       35424|               2774|    MEDIUM|\n|     02|       33983|               3448|    MEDIUM|\n|     09|       33846|               2172|    MEDIUM|\n|     03|       32657|               2613|    MEDIUM|\n|     26|       29305|               3022|    MEDIUM|\n|     16|       27599|               3186|       LOW|\n|     08|       22576|               1564|       LOW|\n|     17|       19622|               1836|       LOW|\n|     07|       13891|                732|       LOW|\n|     01|       12690|               1372|       LOW|\n+-------+------------+-------------------+----------+\nonly showing top 20 rows\n\nViews saved.\n"},{"type":"TABLE","data":"dc_dist\ttotal_crimes\thigh_severity_count\tcrime_zone\n24\t54050\t7441\tHIGH\n15\t52924\t6643\tHIGH\n22\t51671\t7396\tHIGH\n19\t48433\t5640\tHIGH\n35\t46575\t6523\tHIGH\n25\t43471\t8197\tHIGH\n14\t41746\t4574\tHIGH\n12\t41540\t5657\tHIGH\n39\t41255\t5813\tMEDIUM\n18\t38716\t4823\tMEDIUM\n06\t35424\t2774\tMEDIUM\n02\t33983\t3448\tMEDIUM\n09\t33846\t2172\tMEDIUM\n03\t32657\t2613\tMEDIUM\n26\t29305\t3022\tMEDIUM\n16\t27599\t3186\tLOW\n08\t22576\t1564\tLOW\n17\t19622\t1836\tLOW\n07\t13891\t732\tLOW\n01\t12690\t1372\tLOW\n05\t10849\t525\tLOW\n77\t3210\t96\tLOW\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=532"},{"jobUrl":"http://node-master:4040/jobs/job?id=533"},{"jobUrl":"http://node-master:4040/jobs/job?id=534"},{"jobUrl":"http://node-master:4040/jobs/job?id=535"},{"jobUrl":"http://node-master:4040/jobs/job?id=536"},{"jobUrl":"http://node-master:4040/jobs/job?id=537"},{"jobUrl":"http://node-master:4040/jobs/job?id=538"},{"jobUrl":"http://node-master:4040/jobs/job?id=539"},{"jobUrl":"http://node-master:4040/jobs/job?id=540"},{"jobUrl":"http://node-master:4040/jobs/job?id=541"},{"jobUrl":"http://node-master:4040/jobs/job?id=542"},{"jobUrl":"http://node-master:4040/jobs/job?id=543"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705005778_1436891962","id":"paragraph_1774705005778_1436891962","dateCreated":"2026-03-28T21:36:45+0800","dateStarted":"2026-03-28T22:24:08+0800","dateFinished":"2026-03-28T22:24:12+0800","status":"FINISHED"},{"text":"%spark.pyspark\n\n# Map police districts to ZIP codes using lookup table\n# Join Yelp restaurants with crime zones (Spatial Proximity Mapping)\n\ncrime_zones = spark.table(\"external_data.v_crime_zones\")\n\n# Join strategy \n# Yelp business has postal_code\n# Crime data has dc_dist (police district)\n# We join using coordinates proximity or postal_code\n# Since we do not have ZIP in crime data,\n# we use dc_dist as the neighborhood proxy\n\n# First check postal_code distribution in Yelp Philadelphia\nprint(\"Philadelphia restaurant ZIP codes (top 15):\")\nphilly_biz.groupBy(\"postal_code\") \\\n    .count() \\\n    .orderBy(F.desc(\"count\")) \\\n    .show(15)\n\n# Map police districts to ZIP codes\n# Philadelphia police districts map to neighborhoods\n# This is a well-known mapping\ndistrict_zip_map = {\n    \"01\": \"19125\", \"02\": \"19152\", \"03\": \"19136\",\n    \"04\": \"19124\", \"05\": \"19120\", \"06\": \"19111\",\n    \"07\": \"19149\", \"08\": \"19153\", \"09\": \"19148\",\n    \"10\": \"19116\", \"11\": \"19116\", \"12\": \"19151\",\n    \"14\": \"19139\", \"15\": \"19143\", \"16\": \"19142\",\n    \"17\": \"19146\", \"18\": \"19103\", \"19\": \"19130\",\n    \"22\": \"19132\", \"23\": \"19121\", \"24\": \"19122\",\n    \"25\": \"19125\", \"26\": \"19128\", \"35\": \"19138\",\n    \"39\": \"19144\"\n}\n\n# Create district to ZIP mapping DataFrame\nmapping_rows = [(k, v) for k, v in district_zip_map.items()]\ndistrict_zip_df = spark.createDataFrame(\n    mapping_rows,\n    [\"dc_dist\", \"zip_code\"]\n)\n\n# Join crime zones with ZIP mapping\ncrime_zones_zip = crime_zones.join(\n    district_zip_df,\n    on=\"dc_dist\",\n    how=\"left\"\n)\n\n# Join Yelp restaurants with crime zones via ZIP code\nbiz_crime = philly_biz.join(\n    crime_zones_zip.select(\n        \"zip_code\", \"crime_zone\",\n        \"total_crimes\", \"high_severity_count\"\n    ),\n    philly_biz[\"postal_code\"] == crime_zones_zip[\"zip_code\"],\n    how=\"left\"\n).withColumn(\n    \"crime_zone\",\n    F.when(\n        F.col(\"crime_zone\").isNull(), \"UNKNOWN\"\n    ).otherwise(F.col(\"crime_zone\"))\n)\n\nprint(f\"\\nJoined records: {biz_crime.count():,}\")\nprint(\"\\nRestaurants per crime zone:\")\nbiz_crime.groupBy(\"crime_zone\").count().show()\n\n# Save\nbiz_crime.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_philly_biz_crime_zone\"\n)\nprint(\"v_philly_biz_crime_zone saved.\")\n\nz.show(biz_crime.groupBy(\"crime_zone\").count())","user":"anonymous","dateUpdated":"2026-03-29T00:26:15+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Philadelphia restaurant ZIP codes (top 15):\n+-----------+-----+\n|postal_code|count|\n+-----------+-----+\n|      19107|  590|\n|      19147|  549|\n|      19103|  480|\n|      19104|  423|\n|      19106|  301|\n|      19148|  276|\n|      19123|  230|\n|      19102|  199|\n|      19146|  174|\n|      19130|  174|\n|      19125|  152|\n|      19145|  144|\n|      19128|  115|\n|      19127|  107|\n|      19149|  106|\n+-----------+-----+\nonly showing top 15 rows\n\n\nJoined records: 6,004\n\nRestaurants per crime zone:\n+----------+-----+\n|crime_zone|count|\n+----------+-----+\n|      HIGH|  678|\n|   UNKNOWN| 3567|\n|       LOW|  634|\n|    MEDIUM| 1125|\n+----------+-----+\n\nv_philly_biz_crime_zone saved.\n"},{"type":"TABLE","data":"crime_zone\tcount\nHIGH\t678\nUNKNOWN\t3567\nLOW\t634\nMEDIUM\t1125\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=507"},{"jobUrl":"http://node-master:4040/jobs/job?id=508"},{"jobUrl":"http://node-master:4040/jobs/job?id=509"},{"jobUrl":"http://node-master:4040/jobs/job?id=510"},{"jobUrl":"http://node-master:4040/jobs/job?id=511"},{"jobUrl":"http://node-master:4040/jobs/job?id=512"},{"jobUrl":"http://node-master:4040/jobs/job?id=513"},{"jobUrl":"http://node-master:4040/jobs/job?id=514"},{"jobUrl":"http://node-master:4040/jobs/job?id=515"},{"jobUrl":"http://node-master:4040/jobs/job?id=516"},{"jobUrl":"http://node-master:4040/jobs/job?id=517"},{"jobUrl":"http://node-master:4040/jobs/job?id=518"},{"jobUrl":"http://node-master:4040/jobs/job?id=519"},{"jobUrl":"http://node-master:4040/jobs/job?id=520"},{"jobUrl":"http://node-master:4040/jobs/job?id=521"},{"jobUrl":"http://node-master:4040/jobs/job?id=522"},{"jobUrl":"http://node-master:4040/jobs/job?id=523"},{"jobUrl":"http://node-master:4040/jobs/job?id=524"},{"jobUrl":"http://node-master:4040/jobs/job?id=525"},{"jobUrl":"http://node-master:4040/jobs/job?id=526"},{"jobUrl":"http://node-master:4040/jobs/job?id=527"},{"jobUrl":"http://node-master:4040/jobs/job?id=528"},{"jobUrl":"http://node-master:4040/jobs/job?id=529"},{"jobUrl":"http://node-master:4040/jobs/job?id=530"},{"jobUrl":"http://node-master:4040/jobs/job?id=531"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705135362_2141658842","id":"paragraph_1774705135362_2141658842","dateCreated":"2026-03-28T21:38:55+0800","dateStarted":"2026-03-28T22:23:28+0800","dateFinished":"2026-03-28T22:23:34+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n# Analyze restaurant survival rate by crime zone\n# Algorithm: Binary Classification (is_open 0/1) with GROUP BY aggregation\n\nbiz_crime = spark.table(\"external_data.v_philly_biz_crime_zone\")\n\n# Survival rate by crime zone\nsurvival = biz_crime.filter(\n    F.col(\"crime_zone\") != \"UNKNOWN\"\n).groupBy(\"crime_zone\").agg(\n    F.count(\"*\").alias(\"total_restaurants\"),\n    F.sum(\"is_open\").alias(\"open_restaurants\"),\n    F.round(\n        F.sum(\"is_open\") / F.count(\"*\") * 100, 2\n    ).alias(\"survival_rate_pct\")\n).withColumn(\n    \"closed_restaurants\",\n    F.col(\"total_restaurants\") - F.col(\"open_restaurants\")\n).orderBy(\n    F.when(F.col(\"crime_zone\") == \"HIGH\",   1)\n     .when(F.col(\"crime_zone\") == \"MEDIUM\", 2)\n     .otherwise(3)\n)\n\nprint(\"=== ANALYSIS 1: Restaurant Survival Rate by Crime Zone ===\")\nsurvival.show()\n\nsurvival.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_survival_by_crime_zone\"\n)\nprint(\"Saved.\")\n\nz.show(survival)","user":"anonymous","dateUpdated":"2026-03-29T00:26:45+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_restaurants","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== ANALYSIS 1: Restaurant Survival Rate by Crime Zone ===\n+----------+-----------------+----------------+-----------------+------------------+\n|crime_zone|total_restaurants|open_restaurants|survival_rate_pct|closed_restaurants|\n+----------+-----------------+----------------+-----------------+------------------+\n|      HIGH|              678|             464|            68.44|               214|\n|    MEDIUM|             1125|             686|            60.98|               439|\n|       LOW|              634|             427|            67.35|               207|\n+----------+-----------------+----------------+-----------------+------------------+\n\nSaved.\n"},{"type":"TABLE","data":"crime_zone\ttotal_restaurants\topen_restaurants\tsurvival_rate_pct\tclosed_restaurants\nHIGH\t678\t464\t68.44\t214\nMEDIUM\t1125\t686\t60.98\t439\nLOW\t634\t427\t67.35\t207\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=499"},{"jobUrl":"http://node-master:4040/jobs/job?id=500"},{"jobUrl":"http://node-master:4040/jobs/job?id=501"},{"jobUrl":"http://node-master:4040/jobs/job?id=502"},{"jobUrl":"http://node-master:4040/jobs/job?id=503"},{"jobUrl":"http://node-master:4040/jobs/job?id=504"},{"jobUrl":"http://node-master:4040/jobs/job?id=505"},{"jobUrl":"http://node-master:4040/jobs/job?id=506"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705201018_139508997","id":"paragraph_1774705201018_139508997","dateCreated":"2026-03-28T21:40:01+0800","dateStarted":"2026-03-28T22:22:41+0800","dateFinished":"2026-03-28T22:22:43+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n# Analyze average star ratings and review volume by crime zone\n# Algorithm: Descriptive Statistics — mean aggregation by group\n\nbiz_crime = spark.table(\"external_data.v_philly_biz_crime_zone\")\n\n# Avg ratings by crime zone\nratings = biz_crime.filter(\n    F.col(\"crime_zone\") != \"UNKNOWN\"\n).groupBy(\"crime_zone\").agg(\n    F.round(F.avg(\"stars\"), 3).alias(\"avg_stars\"),\n    F.round(F.avg(\"review_count\"), 1).alias(\"avg_review_count\"),\n    F.sum(\"review_count\").alias(\"total_reviews\"),\n    F.count(\"*\").alias(\"restaurant_count\")\n).orderBy(\n    F.when(F.col(\"crime_zone\") == \"HIGH\",   1)\n     .when(F.col(\"crime_zone\") == \"MEDIUM\", 2)\n     .otherwise(3)\n)\n\nprint(\"=== ANALYSIS 2: Average Ratings by Crime Zone ===\")\nratings.show()\n\nratings.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_ratings_by_crime_zone\"\n)\nprint(\"Saved.\")\n\nz.show(ratings)","user":"anonymous","dateUpdated":"2026-03-29T00:27:08+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"crime_zone","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"avg_stars","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== ANALYSIS 2: Average Ratings by Crime Zone ===\n+----------+---------+----------------+-------------+----------------+\n|crime_zone|avg_stars|avg_review_count|total_reviews|restaurant_count|\n+----------+---------+----------------+-------------+----------------+\n|      HIGH|    3.636|            94.5|        64041|             678|\n|    MEDIUM|    3.572|           114.1|       128364|            1125|\n|       LOW|    3.497|            86.1|        54591|             634|\n+----------+---------+----------------+-------------+----------------+\n\nSaved.\n"},{"type":"TABLE","data":"crime_zone\tavg_stars\tavg_review_count\ttotal_reviews\trestaurant_count\nHIGH\t3.636\t94.5\t64041\t678\nMEDIUM\t3.572\t114.1\t128364\t1125\nLOW\t3.497\t86.1\t54591\t634\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=491"},{"jobUrl":"http://node-master:4040/jobs/job?id=492"},{"jobUrl":"http://node-master:4040/jobs/job?id=493"},{"jobUrl":"http://node-master:4040/jobs/job?id=494"},{"jobUrl":"http://node-master:4040/jobs/job?id=495"},{"jobUrl":"http://node-master:4040/jobs/job?id=496"},{"jobUrl":"http://node-master:4040/jobs/job?id=497"},{"jobUrl":"http://node-master:4040/jobs/job?id=498"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774705241571_41065546","id":"paragraph_1774705241571_41065546","dateCreated":"2026-03-28T21:40:41+0800","dateStarted":"2026-03-28T22:21:55+0800","dateFinished":"2026-03-28T22:21:58+0800","status":"FINISHED","focus":false},{"text":"%spark.pyspark\n# Analyze cuisine type distribution across crime zones\n# Algorithm: Cross-tabulation analysis (cuisine × crime_zone matrix)\n\nbiz_crime = spark.table(\"external_data.v_philly_biz_crime_zone\")\n\nCUISINES = [\n    \"American\", \"Mexican\", \"Italian\", \"Japanese\",\n    \"Chinese\", \"Thai\", \"Mediterranean\", \"French\",\n    \"Vietnamese\", \"Indian\", \"Korean\", \"Fast Food\",\n    \"Pizza\", \"Burgers\", \"Seafood\", \"Steakhouses\"\n]\n\nrows = []\nfor cuisine in CUISINES:\n    for zone in [\"HIGH\", \"MEDIUM\", \"LOW\"]:\n        subset = biz_crime.filter(\n            (F.col(\"categories\").contains(cuisine)) &\n            (F.col(\"crime_zone\") == zone)\n        )\n        count = subset.count()\n        avg_s = subset.agg(\n            F.round(F.avg(\"stars\"), 3)\n        ).collect()[0][0]\n\n        rows.append((cuisine, zone, count,\n                     float(avg_s) if avg_s else 0.0))\n\ncuisine_df = spark.createDataFrame(\n    rows,\n    [\"cuisine\", \"crime_zone\",\n     \"restaurant_count\", \"avg_stars\"]\n)\n\nprint(\"=== ANALYSIS 3: Cuisine Distribution by Crime Zone ===\")\ncuisine_df.orderBy(\n    F.desc(\"restaurant_count\")\n).show(30)\n\ncuisine_df.write.mode(\"overwrite\").saveAsTable(\n    \"external_data.v_cuisine_by_crime_zone\"\n)\nprint(\"Saved.\")\n\nz.show(cuisine_df.orderBy(F.desc(\"restaurant_count\")))","user":"anonymous","dateUpdated":"2026-03-29T00:27:27+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"lineChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"cuisine","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"crime_zone","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== ANALYSIS 3: Cuisine Distribution by Crime Zone ===\n+-------------+----------+----------------+---------+\n|      cuisine|crime_zone|restaurant_count|avg_stars|\n+-------------+----------+----------------+---------+\n|     American|    MEDIUM|             243|    3.582|\n|        Pizza|    MEDIUM|             164|    3.335|\n|     American|       LOW|             163|    3.509|\n|     American|      HIGH|             156|    3.651|\n|      Italian|    MEDIUM|             117|    3.714|\n|        Pizza|      HIGH|             112|    3.268|\n|        Pizza|       LOW|              89|    3.062|\n|      Chinese|    MEDIUM|              79|    3.405|\n|    Fast Food|    MEDIUM|              73|    2.808|\n|      Burgers|    MEDIUM|              72|    2.958|\n|      Mexican|    MEDIUM|              65|    3.577|\n|      Seafood|    MEDIUM|              55|    3.564|\n|      Italian|      HIGH|              52|    3.413|\n|      Seafood|      HIGH|              48|    3.552|\n|     Japanese|    MEDIUM|              47|    3.564|\n|    Fast Food|       LOW|              47|    2.309|\n|      Burgers|      HIGH|              46|    3.098|\n|      Chinese|       LOW|              43|    3.442|\n|      Burgers|       LOW|              41|    2.939|\n|      Seafood|       LOW|              41|    3.695|\n|      Italian|       LOW|              40|    3.388|\n|Mediterranean|    MEDIUM|              39|    3.949|\n|    Fast Food|      HIGH|              36|    2.319|\n|      Mexican|       LOW|              36|    3.417|\n|      Chinese|      HIGH|              33|    3.333|\n|  Steakhouses|    MEDIUM|              31|    3.452|\n|       French|    MEDIUM|              28|    4.071|\n|      Mexican|      HIGH|              26|    3.635|\n|         Thai|    MEDIUM|              26|    3.615|\n|       Korean|       LOW|              23|    4.109|\n+-------------+----------+----------------+---------+\nonly showing top 30 rows\n\nSaved.\n"},{"type":"TABLE","data":"cuisine\tcrime_zone\trestaurant_count\tavg_stars\nAmerican\tMEDIUM\t243\t3.582\nPizza\tMEDIUM\t164\t3.335\nAmerican\tLOW\t163\t3.509\nAmerican\tHIGH\t156\t3.651\nItalian\tMEDIUM\t117\t3.714