{"paragraphs":[{"text":"%pyspark\r\n# TASK 1: Environment Setup & Data Loading\r\n# WHAT THIS DOES: Initializes Spark and loads all datasets from Hive tables\r\n\r\nfrom pyspark.sql.functions import *\r\nfrom pyspark.sql.types import *\r\n\r\nspark = SparkSession.builder.getOrCreate()\r\nspark.sparkContext.setLogLevel(\"WARN\")\r\n\r\nprint(\"=\"*70)\r\nprint(\"YELP CURSED STOREFRONTS ANALYSIS\")\r\nprint(\"Data Enrichment with External Datasets\")\r\nprint(\"=\"*70)\r\n\r\n# Load Yelp business data - contains restaurant info, ratings, status\r\nbusiness_df = spark.table(\"yelp.business\")\r\n# Load Yelp reviews - contains customer reviews for NLP analysis\r\nreviews_df = spark.table(\"yelp.review\")\r\n# Load zoning data - external data for commercial zone validation\r\nzoning_df = spark.table(\"external_data.zoning_districts\").filter(\"code != 'code'\")\r\n# Load zip codes data - external data for demographics and walkability\r\nzipcodes_df = spark.table(\"external_data.us_zipcodes\").filter(\"zip != 'zip'\")\r\n\r\n# Convert data types to proper formats\r\nzoning_df = zoning_df.withColumn(\"citycor\", col(\"citycor\").cast(\"int\")) \\\r\n    .withColumn(\"objectid\", col(\"objectid\").cast(\"int\")) \\\r\n    .withColumn(\"shape_area\", col(\"shape_area\").cast(\"double\")) \\\r\n    .withColumn(\"shape_length\", col(\"shape_length\").cast(\"double\"))\r\n\r\nzipcodes_df = zipcodes_df.withColumn(\"lat\", col(\"lat\").cast(\"double\")) \\\r\n    .withColumn(\"lng\", col(\"lng\").cast(\"double\")) \\\r\n    .withColumn(\"population\", col(\"population\").cast(\"int\")) \\\r\n    .withColumn(\"density\", col(\"density\").cast(\"double\"))\r\n\r\nprint(\"✓ Business records: {}\".format(business_df.count()))\r\nprint(\"✓ Review records: {}\".format(reviews_df.count()))\r\nprint(\"✓ Zoning records: {}\".format(zoning_df.count()))\r\nprint(\"✓ Zip codes records: {}\".format(zipcodes_df.count()))","user":"anonymous","dateUpdated":"2026-03-25T17:58:07+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"======================================================================\nYELP CURSED STOREFRONTS ANALYSIS\nData Enrichment with External Datasets\n======================================================================\n✓ Business records: 150346\n✓ Review records: 6990280\n✓ Zoning records: 29196\n✓ Zip codes records: 33782\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=1143"},{"jobUrl":"http://node-master:4040/jobs/job?id=1144"},{"jobUrl":"http://node-master:4040/jobs/job?id=1145"},{"jobUrl":"http://node-master:4040/jobs/job?id=1146"},{"jobUrl":"http://node-master:4040/jobs/job?id=1147"},{"jobUrl":"http://node-master:4040/jobs/job?id=1148"},{"jobUrl":"http://node-master:4040/jobs/job?id=1149"},{"jobUrl":"http://node-master:4040/jobs/job?id=1150"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774425290452_1787402826","id":"paragraph_1774425290452_1787402826","dateCreated":"2026-03-25T15:54:50+0800","dateStarted":"2026-03-25T17:58:07+0800","dateFinished":"2026-03-25T17:58:40+0800","status":"FINISHED"},{"text":"%pyspark\n# TASK 2: External Data Enrichment\n\nzipcodes_enriched = zipcodes_df \\\n    .withColumn(\"walk_score\",\n        when(col(\"density\") >= 10000, 95)\n        .when(col(\"density\") >= 5000, 85)\n        .when(col(\"density\") >= 3000, 70)\n        .when(col(\"density\") >= 1500, 55)\n        .when(col(\"density\") >= 500, 40)\n        .otherwise(25)\n    ) \\\n    .withColumn(\"walkability_category\",\n        when(col(\"walk_score\") >= 70, \"Very Walkable\")\n        .when(col(\"walk_score\") >= 50, \"Somewhat Walkable\")\n        .when(col(\"walk_score\") >= 30, \"Car-Dependent\")\n        .otherwise(\"Very Car-Dependent\")\n    ) \\\n    .withColumn(\"business_potential\",\n        when(col(\"density\") >= 3000, \"Excellent\")\n        .when(col(\"density\") >= 1000, \"Good\")\n        .when(col(\"density\") >= 500, \"Moderate\")\n        .otherwise(\"Poor\")\n    )\n\ncommercial_zones = zoning_df.filter(col(\"zoninggroup\").contains(\"Commercial\"))\n\nprint(\"=\"*70)\nprint(\"EXTERNAL DATA ENRICHMENT COMPLETE\")\nprint(\"=\"*70)\n\n# Chart 2a: Walk Score Distribution\nwalk_score_dist = zipcodes_enriched.groupBy(\"walkability_category\").count()\nprint(\"\\nChart 2a: Walk Score Categories Distribution\")\nwalk_score_dist.show()\nz.show(walk_score_dist)\n\n# Chart 2b: Business Potential Distribution\nbusiness_potential_dist = zipcodes_enriched.groupBy(\"business_potential\").count()\nprint(\"\\nChart 2b: Business Potential Distribution\")\nbusiness_potential_dist.show()\nz.show(business_potential_dist)\n\nprint(\"Commercial Zones: {}\".format(commercial_zones.count()))","user":"anonymous","dateUpdated":"2026-03-25T17:47:07+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"walkability_category","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"scatterChart":{}},"keys":[{"name":"business_potential","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"======================================================================\nEXTERNAL DATA ENRICHMENT COMPLETE\n======================================================================\n\nChart 2a: Walk Score Categories Distribution\n+--------------------+-----+\n|walkability_category|count|\n+--------------------+-----+\n|       Car-Dependent| 3630|\n|       Very Walkable| 1112|\n|  Very Car-Dependent|27218|\n|   Somewhat Walkable| 1822|\n+--------------------+-----+\n\n"},{"type":"TABLE","data":"walkability_category\tcount\nCar-Dependent\t3630\nVery Walkable\t1112\nVery Car-Dependent\t27218\nSomewhat Walkable\t1822\n"},{"type":"TEXT","data":"\n\nChart 2b: Business Potential Distribution\n+------------------+-----+\n|business_potential|count|\n+------------------+-----+\n|         Excellent| 1112|\n|              Good| 3266|\n|              Poor|27218|\n|          Moderate| 2186|\n+------------------+-----+\n\n"},{"type":"TABLE","data":"business_potential\tcount\nExcellent\t1112\nGood\t3266\nPoor\t27218\nModerate\t2186\n"},{"type":"TEXT","data":"\nCommercial Zones: 9012\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=1014"},{"jobUrl":"http://node-master:4040/jobs/job?id=1015"},{"jobUrl":"http://node-master:4040/jobs/job?id=1016"},{"jobUrl":"http://node-master:4040/jobs/job?id=1017"},{"jobUrl":"http://node-master:4040/jobs/job?id=1018"},{"jobUrl":"http://node-master:4040/jobs/job?id=1019"},{"jobUrl":"http://node-master:4040/jobs/job?id=1020"},{"jobUrl":"http://node-master:4040/jobs/job?id=1021"},{"jobUrl":"http://node-master:4040/jobs/job?id=1022"},{"jobUrl":"http://node-master:4040/jobs/job?id=1023"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774425311519_1430503334","id":"paragraph_1774425311519_1430503334","dateCreated":"2026-03-25T15:55:11+0800","dateStarted":"2026-03-25T17:46:54+0800","dateFinished":"2026-03-25T17:46:56+0800","status":"FINISHED"},{"text":"%pyspark\n# TASK 3: Lifecycle Analysis - Identify Cursed Storefronts\n\ncursed_storefronts = business_df.groupBy(\"address\", \"city\", \"state\", \"postal_code\", \"latitude\", \"longitude\").agg(\n    count(\"business_id\").alias(\"total_businesses\"),\n    sum(when(col(\"is_open\") == 0, 1).otherwise(0)).alias(\"closed_count\"),\n    sum(when(col(\"is_open\") == 1, 1).otherwise(0)).alias(\"open_count\"),\n    collect_list(\"name\").alias(\"business_names\"),\n    avg(\"stars\").alias(\"avg_rating\")\n).filter(col(\"total_businesses\") >= 2).filter(col(\"closed_count\") >= 1).withColumn(\"cursed_level\",\n    when(col(\"closed_count\") >= 3, \"SEVERELY CURSED\")\n    .when(col(\"closed_count\") >= 2, \"CURSED\")\n    .otherwise(\"POTENTIALLY CURSED\")\n).withColumn(\"failure_rate\",\n    round((col(\"closed_count\") / col(\"total_businesses\")) * 100, 2)\n).orderBy(col(\"closed_count\").desc(), col(\"total_businesses\").desc())\n\nprint(\"=\"*70)\nprint(\"LIFECYCLE ANALYSIS - CURSED STOREFRONTS\")\nprint(\"=\"*70)\nprint(\"Total cursed storefronts: {}\".format(cursed_storefronts.count()))\nprint(\"Total business closures: {}\".format(cursed_storefronts.agg(sum(\"closed_count\")).collect()[0][0]))\n\n# Chart 3a: Cursed Level Distribution\ncursed_level_dist = cursed_storefronts.groupBy(\"cursed_level\").count()\nprint(\"\\nChart 3a: Cursed Level Distribution\")\ncursed_level_dist.show()\nz.show(cursed_level_dist)\n\n# Chart 3b: Top 20 Most Cursed Cities\ntop_cursed_cities = cursed_storefronts.groupBy(\"city\", \"state\").agg(\n    count(\"*\").alias(\"cursed_count\"), \n    sum(\"closed_count\").alias(\"total_closures\")\n).orderBy(col(\"cursed_count\").desc()).limit(20)\n\nprint(\"\\nChart 3b: Top 20 Most Cursed Cities\")\ntop_cursed_cities.show()\nz.show(top_cursed_cities)\n\n# Chart 3c: Failure Rate Distribution (binned)\nfailure_rate_bins = cursed_storefronts.withColumn(\"failure_rate_bin\",\n    when(col(\"failure_rate\") < 20, \"0-20%\")\n    .when(col(\"failure_rate\") < 40, \"20-40%\")\n    .when(col(\"failure_rate\") < 60, \"40-60%\")\n    .when(col(\"failure_rate\") < 80, \"60-80%\")\n    .otherwise(\"80-100%\")\n).groupBy(\"failure_rate_bin\").count().orderBy(\"failure_rate_bin\")\n\nprint(\"\\nChart 3c: Failure Rate Distribution\")\nfailure_rate_bins.show()\nz.show(failure_rate_bins)","user":"anonymous","dateUpdated":"2026-03-25T17:46:29+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"cursed_level","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"city","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"state","index":1,"aggr":"sum"}]}},"5":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"scatterChart":{}},"keys":[{"name":"failure_rate_bin","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"======================================================================\nLIFECYCLE ANALYSIS - CURSED STOREFRONTS\n======================================================================\nTotal cursed storefronts: 2199\nTotal business closures: 3317\n\nChart 3a: Cursed Level Distribution\n+------------------+-----+\n|      cursed_level|count|\n+------------------+-----+\n|POTENTIALLY CURSED| 1266|\n|   SEVERELY CURSED|  127|\n|            CURSED|  806|\n+------------------+-----+\n\n"},{"type":"TABLE","data":"cursed_level\tcount\nPOTENTIALLY CURSED\t1266\nSEVERELY CURSED\t127\nCURSED\t806\n"},{"type":"TEXT","data":"\n\nChart 3b: Top 20 Most Cursed Cities\n+--------------+-----+------------+--------------+\n|          city|state|cursed_count|total_closures|\n+--------------+-----+------------+--------------+\n|  Philadelphia|   PA|         398|           646|\n|     Nashville|   TN|         146|           216|\n|         Tampa|   FL|         134|           206|\n|   New Orleans|   LA|         132|           210|\n|  Indianapolis|   IN|         130|           206|\n|        Tucson|   AZ|         119|           170|\n|          Reno|   NV|         117|           195|\n| Santa Barbara|   CA|          97|           158|\n|   Saint Louis|   MO|          87|           149|\n|         Boise|   ID|          36|            46|\n|    Clearwater|   FL|          26|            38|\n|        Sparks|   NV|          24|            39|\n|      Edmonton|   AB|          24|            35|\n|      Franklin|   TN|          23|            31|\n|    Wilmington|   DE|          20|            28|\n|        Carmel|   IN|          16|            18|\n|        Goleta|   CA|          16|            21|\n|   Palm Harbor|   FL|          14|            21|\n|St. Petersburg|   FL|          14|            21|\n|         Largo|   FL|          13|            18|\n+--------------+-----+------------+--------------+\n\n"},{"type":"TABLE","data":"city\tstate\tcursed_count\ttotal_closures\nPhiladelphia\tPA\t398\t646\nNashville\tTN\t146\t216\nTampa\tFL\t134\t206\nNew Orleans\tLA\t132\t210\nIndianapolis\tIN\t130\t206\nTucson\tAZ\t119\t170\nReno\tNV\t117\t195\nSanta Barbara\tCA\t97\t158\nSaint Louis\tMO\t87\t149\nBoise\tID\t36\t46\nClearwater\tFL\t26\t38\nSparks\tNV\t24\t39\nEdmonton\tAB\t24\t35\nFranklin\tTN\t23\t31\nWilmington\tDE\t20\t28\nCarmel\tIN\t16\t18\nGoleta\tCA\t16\t21\nPalm Harbor\tFL\t14\t21\nSt. Petersburg\tFL\t14\t21\nLargo\tFL\t13\t18\n"},{"type":"TEXT","data":"\n\nChart 3c: Failure Rate Distribution\n+----------------+-----+\n|failure_rate_bin|count|\n+----------------+-----+\n|           0-20%|  117|\n|          20-40%|  171|\n|          40-60%| 1065|\n|          60-80%|   99|\n|         80-100%|  747|\n+----------------+-----+\n\n"},{"type":"TABLE","data":"failure_rate_bin\tcount\n0-20%\t117\n20-40%\t171\n40-60%\t1065\n60-80%\t99\n80-100%\t747\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=990"},{"jobUrl":"http://node-master:4040/jobs/job?id=991"},{"jobUrl":"http://node-master:4040/jobs/job?id=992"},{"jobUrl":"http://node-master:4040/jobs/job?id=993"},{"jobUrl":"http://node-master:4040/jobs/job?id=994"},{"jobUrl":"http://node-master:4040/jobs/job?id=995"},{"jobUrl":"http://node-master:4040/jobs/job?id=996"},{"jobUrl":"http://node-master:4040/jobs/job?id=997"},{"jobUrl":"http://node-master:4040/jobs/job?id=998"},{"jobUrl":"http://node-master:4040/jobs/job?id=999"},{"jobUrl":"http://node-master:4040/jobs/job?id=1000"},{"jobUrl":"http://node-master:4040/jobs/job?id=1001"},{"jobUrl":"http://node-master:4040/jobs/job?id=1002"},{"jobUrl":"http://node-master:4040/jobs/job?id=1003"},{"jobUrl":"http://node-master:4040/jobs/job?id=1004"},{"jobUrl":"http://node-master:4040/jobs/job?id=1005"},{"jobUrl":"http://node-master:4040/jobs/job?id=1006"},{"jobUrl":"http://node-master:4040/jobs/job?id=1007"},{"jobUrl":"http://node-master:4040/jobs/job?id=1008"},{"jobUrl":"http://node-master:4040/jobs/job?id=1009"},{"jobUrl":"http://node-master:4040/jobs/job?id=1010"},{"jobUrl":"http://node-master:4040/jobs/job?id=1011"},{"jobUrl":"http://node-master:4040/jobs/job?id=1012"},{"jobUrl":"http://node-master:4040/jobs/job?id=1013"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774428238103_1451943639","id":"paragraph_1774428238103_1451943639","dateCreated":"2026-03-25T16:43:58+0800","dateStarted":"2026-03-25T17:45:39+0800","dateFinished":"2026-03-25T17:45:49+0800","status":"FINISHED"},{"text":"%pyspark\n# TASK 4: Golden Locations Analysis\n\ngolden_locations = business_df.filter(col(\"is_open\") == 1).groupBy(\n    \"address\", \"city\", \"state\", \"postal_code\"\n).agg(\n    count(\"business_id\").alias(\"total_businesses\"),\n    avg(\"stars\").alias(\"avg_rating\"),\n    sum(\"review_count\").alias(\"total_reviews\"),\n    collect_list(\"name\").alias(\"business_names\")\n).filter(col(\"total_businesses\") == 1).filter(col(\"avg_rating\") >= 4.0).orderBy(col(\"total_reviews\").desc())\n\nprint(\"=\"*70)\nprint(\"GOLDEN LOCATIONS\")\nprint(\"=\"*70)\nprint(\"Total golden locations: {}\".format(golden_locations.count()))\n\n# Chart 4a: Top 20 Cities with Golden Locations\ntop_golden_cities = golden_locations.groupBy(\"city\", \"state\").agg(\n    count(\"*\").alias(\"golden_count\")\n).orderBy(col(\"golden_count\").desc()).limit(20)\n\nprint(\"\\nChart 4a: Top 20 Cities with Golden Locations\")\ntop_golden_cities.show()\nz.show(top_golden_cities)\n\n# Chart 4b: Rating Distribution\nrating_dist = golden_locations.groupBy(\"avg_rating\").count().orderBy(\"avg_rating\")\nprint(\"\\nChart 4b: Rating Distribution\")\nrating_dist.show()\nz.show(rating_dist)\n\n# Chart 4c: Top 20 Golden Locations\nprint(\"\\nChart 4c: Top 20 Golden Locations\")\ngolden_locations.select(\n    \"address\", \"city\", \"state\", \"avg_rating\", \"total_reviews\", \"business_names\"\n).show(20, truncate=False)","user":"anonymous","dateUpdated":"2026-03-25T17:47:47+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"city","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"state","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"avg_rating","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"======================================================================\nGOLDEN LOCATIONS\n======================================================================\nTotal golden locations: 52060\n\nChart 4a: Top 20 Cities with Golden Locations\n+----------------+-----+------------+\n|            city|state|golden_count|\n+----------------+-----+------------+\n|    Philadelphia|   PA|        4549|\n|          Tucson|   AZ|        3153|\n|           Tampa|   FL|        3125|\n|    Indianapolis|   IN|        2541|\n|     New Orleans|   LA|        2366|\n|       Nashville|   TN|        2307|\n|            Reno|   NV|        2078|\n|     Saint Louis|   MO|        1637|\n|        Edmonton|   AB|        1626|\n|   Santa Barbara|   CA|        1546|\n|           Boise|   ID|        1201|\n|      Clearwater|   FL|         844|\n|Saint Petersburg|   FL|         723|\n|          Sparks|   NV|         580|\n|        Metairie|   LA|         534|\n|       St. Louis|   MO|         521|\n|  St. Petersburg|   FL|         503|\n|        Franklin|   TN|         462|\n|      Wilmington|   DE|         445|\n|          Carmel|   IN|         406|\n+----------------+-----+------------+\n\n"},{"type":"TABLE","data":"city\tstate\tgolden_count\nPhiladelphia\tPA\t4549\nTucson\tAZ\t3153\nTampa\tFL\t3125\nIndianapolis\tIN\t2541\nNew Orleans\tLA\t2366\nNashville\tTN\t2307\nReno\tNV\t2078\nSaint Louis\tMO\t1637\nEdmonton\tAB\t1626\nSanta Barbara\tCA\t1546\nBoise\tID\t1201\nClearwater\tFL\t844\nSaint Petersburg\tFL\t723\nSparks\tNV\t580\nMetairie\tLA\t534\nSt. Louis\tMO\t521\nSt. Petersburg\tFL\t503\nFranklin\tTN\t462\nWilmington\tDE\t445\nCarmel\tIN\t406\n"},{"type":"TEXT","data":"\n\nChart 4b: Rating Distribution\n+----------+-----+\n|avg_rating|count|\n+----------+-----+\n|       4.0|21049|\n|       4.5|19357|\n|       5.0|11654|\n+----------+-----+\n\n"},{"type":"TABLE","data":"avg_rating\tcount\n4.0\t21049\n4.5\t19357\n5.0\t11654\n"},{"type":"TEXT","data":"\n\nChart 4c: Top 20 Golden Locations\n+---------------------+-------------+-----+----------+-------------+------------------------------------+\n|address              |city         |state|avg_rating|total_reviews|business_names                      |\n+---------------------+-------------+-----+----------+-------------+------------------------------------+\n|724 Iberville St     |New Orleans  |LA   |4.0       |7568         |[Acme Oyster House]                 |\n|739 Conti St         |New Orleans  |LA   |4.0       |7400         |[Oceana Grill]                      |\n|112 19th Ave S       |Nashville    |TN   |4.5       |6093         |[Hattie B’s Hot Chicken - Nashville]|\n|200 Magazine St      |New Orleans  |LA   |4.5       |5193         |[Ruby Slipper - New Orleans]        |\n|441 Royal St         |New Orleans  |LA   |4.0       |5070         |[Royal House]                       |\n|1403 Washington Ave  |New Orleans  |LA   |4.5       |4876         |[Commander's Palace]                |\n|333 Saint Charles Ave|New Orleans  |LA   |4.0       |4554         |[Luke]                              |\n|316 11th Ave S       |Nashville    |TN   |4.0       |4207         |[Biscuit Love: Gulch]               |\n|3106 Olive St        |Saint Louis  |MO   |4.5       |3999         |[Pappy's Smokehouse]                |\n|739 Iberville St     |New Orleans  |LA   |4.0       |3966         |[Felix's Restaurant & Oyster Bar]   |\n|630 St Peter St      |New Orleans  |LA   |4.0       |3902         |[Gumbo Shop]                        |\n|600 N Milpas St      |Santa Barbara|CA   |4.5       |3834         |[Los Agaves]                        |\n|2401 St Ann St       |New Orleans  |LA   |4.5       |3582         |[Willie Mae's Scotch House]         |\n|2616 S MacDill Ave   |Tampa        |FL   |4.0       |3260         |[Datz]                              |\n|121 S 13th St        |Philadelphia |PA   |4.0       |3187         |[El Vez]                            |\n|237 St James Pl      |Philadelphia |PA   |4.5       |3065         |[Zahav]                             |\n|1810 N Highland Ave  |Tampa        |FL   |4.0       |3064         |[Ulele]                             |\n|731 McFerrin Ave     |Nashville    |TN   |4.0       |3054         |[The Pharmacy]                      |\n|119 Harbor Way       |Santa Barbara|CA   |4.0       |2940         |[Brophy Bros - Santa Barbara]       |\n|110 S 13th St        |Philadelphia |PA   |4.5       |2893         |[Barbuzzo]                          |\n+---------------------+-------------+-----+----------+-------------+------------------------------------+\nonly showing top 20 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=1024"},{"jobUrl":"http://node-master:4040/jobs/job?id=1025"},{"jobUrl":"http://node-master:4040/jobs/job?id=1026"},{"jobUrl":"http://node-master:4040/jobs/job?id=1027"},{"jobUrl":"http://node-master:4040/jobs/job?id=1028"},{"jobUrl":"http://node-master:4040/jobs/job?id=1029"},{"jobUrl":"http://node-master:4040/jobs/job?id=1030"},{"jobUrl":"http://node-master:4040/jobs/job?id=1031"},{"jobUrl":"http://node-master:4040/jobs/job?id=1032"},{"jobUrl":"http://node-master:4040/jobs/job?id=1033"},{"jobUrl":"http://node-master:4040/jobs/job?id=1034"},{"jobUrl":"http://node-master:4040/jobs/job?id=1035"},{"jobUrl":"http://node-master:4040/jobs/job?id=1036"},{"jobUrl":"http://node-master:4040/jobs/job?id=1037"},{"jobUrl":"http://node-master:4040/jobs/job?id=1038"},{"jobUrl":"http://node-master:4040/jobs/job?id=1039"},{"jobUrl":"http://node-master:4040/jobs/job?id=1040"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774428265061_1923467772","id":"paragraph_1774428265061_1923467772","dateCreated":"2026-03-25T16:44:25+0800","dateStarted":"2026-03-25T17:47:36+0800","dateFinished":"2026-03-25T17:47:42+0800","status":"FINISHED"},{"text":"%pyspark\n# TASK 5: Attribute Diagnosis - Extract Fatal Flaws\n# WHAT THIS DOES: Extracts business attributes using string matching\n# PURPOSE: Identifies fatal flaws like parking and noise level\n\n# Get cursed businesses\ncursed_businesses = cursed_storefronts.join(\n    business_df, [\"address\", \"city\", \"state\"], \"inner\"\n).select(\n    \"address\", \"city\", \"state\", \"business_id\", \"name\",\n    \"attributes\", \"is_open\"\n)\n\nprint(\"Total cursed businesses: {}\".format(cursed_businesses.count()))\n\n# Simple attribute extraction using basic string matching\ncursed_with_attrs = cursed_businesses \\\n    .withColumn(\"has_parking\", \n        when(col(\"attributes\").contains(\"Parking\") & col(\"attributes\").contains(\"True\"), \"Yes\")\n        .when(col(\"attributes\").contains(\"Parking\") & col(\"attributes\").contains(\"False\"), \"No\")\n        .otherwise(\"Unknown\")\n    ) \\\n    .withColumn(\"noise_level\",\n        when(col(\"attributes\").contains(\"NoiseLevel\") & col(\"attributes\").contains(\"quiet\"), \"Quiet\")\n        .when(col(\"attributes\").contains(\"NoiseLevel\") & col(\"attributes\").contains(\"average\"), \"Average\")\n        .when(col(\"attributes\").contains(\"NoiseLevel\") & col(\"attributes\").contains(\"loud\"), \"Loud\")\n        .when(col(\"attributes\").contains(\"NoiseLevel\") & col(\"attributes\").contains(\"very_loud\"), \"Very Loud\")\n        .otherwise(\"Unknown\")\n    )\n\nprint(\"=\"*70)\nprint(\"ATTRIBUTE DIAGNOSIS - FATAL FLAWS ANALYSIS\")\nprint(\"=\"*70)\n\n# Chart 7a: Parking Availability in Cursed Locations (closed businesses)\nparking_dist = cursed_with_attrs.filter(col(\"is_open\") == 0).groupBy(\"has_parking\").count()\nprint(\"\\nChart 7a: Parking Availability in Cursed Locations\")\nparking_dist.show()\nz.show(parking_dist)\n\n# Chart 7b: Noise Level in Cursed Locations\nnoise_dist = cursed_with_attrs.filter(col(\"is_open\") == 0).groupBy(\"noise_level\").count()\nprint(\"\\nChart 7b: Noise Level in Cursed Locations\")\nnoise_dist.show()\nz.show(noise_dist)\n\n# Chart 7c: Attribute Patterns Combined\nprint(\"\\nChart 7c: Attribute Patterns (Parking vs Noise Level)\")\nattr_patterns = cursed_with_attrs.filter(col(\"is_open\") == 0).groupBy(\"has_parking\", \"noise_level\").count().orderBy(col(\"count\").desc()).limit(10)\nattr_patterns.show()\nz.show(attr_patterns)\n\n# Summary statistics\nclosed_count = cursed_with_attrs.filter(col(\"is_open\") == 0).count()\nno_parking = cursed_with_attrs.filter(col(\"is_open\") == 0).filter(col(\"has_parking\") == \"No\").count()\nvery_loud = cursed_with_attrs.filter(col(\"is_open\") == 0).filter(col(\"noise_level\") == \"Very Loud\").count()\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"ATTRIBUTE SUMMARY\")\nprint(\"=\"*50)\nprint(\"Total closed businesses: {}\".format(closed_count))\nprint(\"Businesses with NO parking: {}\".format(no_parking))\nprint(\"Businesses with VERY LOUD noise: {}\".format(very_loud))","user":"anonymous","dateUpdated":"2026-03-25T21:11:33+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"has_parking","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"noise_level","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"5":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"has_parking","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"noise_level","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total cursed businesses: 59876\n======================================================================\nATTRIBUTE DIAGNOSIS - FATAL FLAWS ANALYSIS\n======================================================================\n\nChart 7a: Parking Availability in Cursed Locations\n+-----------+-----+\n|has_parking|count|\n+-----------+-----+\n|    Unknown| 4009|\n|         No|   84|\n|        Yes| 5865|\n+-----------+-----+\n\n"},{"type":"TABLE","data":"has_parking\tcount\nUnknown\t4009\nNo\t84\nYes\t5865\n"},{"type":"TEXT","data":"\n\nChart 7b: Noise Level in Cursed Locations\n+-----------+-----+\n|noise_level|count|\n+-----------+-----+\n|       Loud|  384|\n|    Average| 2143|\n|    Unknown| 6816|\n|      Quiet|  615|\n+-----------+-----+\n\n"},{"type":"TABLE","data":"noise_level\tcount\nLoud\t384\nAverage\t2143\nUnknown\t6816\nQuiet\t615\n"},{"type":"TEXT","data":"\n\nChart 7c: Attribute Patterns (Parking vs Noise Level)\n+-----------+-----------+-----+\n|has_parking|noise_level|count|\n+-----------+-----------+-----+\n|    Unknown|    Unknown| 3908|\n|        Yes|    Unknown| 2825|\n|        Yes|    Average| 2101|\n|        Yes|      Quiet|  581|\n|        Yes|       Loud|  358|\n|         No|    Unknown|   83|\n|    Unknown|    Average|   41|\n|    Unknown|      Quiet|   34|\n|    Unknown|       Loud|   26|\n|         No|    Average|    1|\n+-----------+-----------+-----+\n\n"},{"type":"TABLE","data":"has_parking\tnoise_level\tcount\nUnknown\tUnknown\t3908\nYes\tUnknown\t2825\nYes\tAverage\t2101\nYes\tQuiet\t581\nYes\tLoud\t358\nNo\tUnknown\t83\nUnknown\tAverage\t41\nUnknown\tQuiet\t34\nUnknown\tLoud\t26\nNo\tAverage\t1\n"},{"type":"TEXT","data":"\n\n==================================================\nATTRIBUTE SUMMARY\n==================================================\nTotal closed businesses: 9958\nBusinesses with NO parking: 84\nBusinesses with VERY LOUD noise: 0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=931"},{"jobUrl":"http://node-master:4040/jobs/job?id=932"},{"jobUrl":"http://node-master:4040/jobs/job?id=933"},{"jobUrl":"http://node-master:4040/jobs/job?id=934"},{"jobUrl":"http://node-master:4040/jobs/job?id=935"},{"jobUrl":"http://node-master:4040/jobs/job?id=936"},{"jobUrl":"http://node-master:4040/jobs/job?id=937"},{"jobUrl":"http://node-master:4040/jobs/job?id=938"},{"jobUrl":"http://node-master:4040/jobs/job?id=939"},{"jobUrl":"http://node-master:4040/jobs/job?id=940"},{"jobUrl":"http://node-master:4040/jobs/job?id=941"},{"jobUrl":"http://node-master:4040/jobs/job?id=942"},{"jobUrl":"http://node-master:4040/jobs/job?id=943"},{"jobUrl":"http://node-master:4040/jobs/job?id=944"},{"jobUrl":"http://node-master:4040/jobs/job?id=945"},{"jobUrl":"http://node-master:4040/jobs/job?id=946"},{"jobUrl":"http://node-master:4040/jobs/job?id=947"},{"jobUrl":"http://node-master:4040/jobs/job?id=948"},{"jobUrl":"http://node-master:4040/jobs/job?id=949"},{"jobUrl":"http://node-master:4040/jobs/job?id=950"},{"jobUrl":"http://node-master:4040/jobs/job?id=951"},{"jobUrl":"http://node-master:4040/jobs/job?id=952"},{"jobUrl":"http://node-master:4040/jobs/job?id=953"},{"jobUrl":"http://node-master:4040/jobs/job?id=954"},{"jobUrl":"http://node-master:4040/jobs/job?id=955"},{"jobUrl":"http://node-master:4040/jobs/job?id=956"},{"jobUrl":"http://node-master:4040/jobs/job?id=957"},{"jobUrl":"http://node-master:4040/jobs/job?id=958"},{"jobUrl":"http://node-master:4040/jobs/job?id=959"},{"jobUrl":"http://node-master:4040/jobs/job?id=960"},{"jobUrl":"http://node-master:4040/jobs/job?id=961"},{"jobUrl":"http://node-master:4040/jobs/job?id=962"},{"jobUrl":"http://node-master:4040/jobs/job?id=963"},{"jobUrl":"http://node-master:4040/jobs/job?id=964"},{"jobUrl":"http://node-master:4040/jobs/job?id=965"},{"jobUrl":"http://node-master:4040/jobs/job?id=966"},{"jobUrl":"http://node-master:4040/jobs/job?id=967"},{"jobUrl":"http://node-master:4040/jobs/job?id=968"},{"jobUrl":"http://node-master:4040/jobs/job?id=969"},{"jobUrl":"http://node-master:4040/jobs/job?id=970"},{"jobUrl":"http://node-master:4040/jobs/job?id=971"},{"jobUrl":"http://node-master:4040/jobs/job?id=972"},{"jobUrl":"http://node-master:4040/jobs/job?id=973"},{"jobUrl":"http://node-master:4040/jobs/job?id=974"},{"jobUrl":"http://node-master:4040/jobs/job?id=975"},{"jobUrl":"http://node-master:4040/jobs/job?id=976"},{"jobUrl":"http://node-master:4040/jobs/job?id=977"},{"jobUrl":"http://node-master:4040/jobs/job?id=978"},{"jobUrl":"http://node-master:4040/jobs/job?id=979"},{"jobUrl":"http://node-master:4040/jobs/job?id=980"},{"jobUrl":"http://node-master:4040/jobs/job?id=981"},{"jobUrl":"http://node-master:4040/jobs/job?id=982"},{"jobUrl":"http://node-master:4040/jobs/job?id=983"},{"jobUrl":"http://node-master:4040/jobs/job?id=984"},{"jobUrl":"http://node-master:4040/jobs/job?id=985"},{"jobUrl":"http://node-master:4040/jobs/job?id=986"},{"jobUrl":"http://node-master:4040/jobs/job?id=987"},{"jobUrl":"http://node-master:4040/jobs/job?id=988"},{"jobUrl":"http://node-master:4040/jobs/job?id=989"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774428309987_926410494","id":"paragraph_1774428309987_926410494","dateCreated":"2026-03-25T16:45:09+0800","dateStarted":"2026-03-25T17:42:59+0800","dateFinished":"2026-03-25T17:43:18+0800","status":"FINISHED"},{"text":"%pyspark\n# Task 6: Review Autopsy - NLP Pain Point Analysis\n# For closed businesses in cursed locations, analyze the most common\n# pain points mentioned in reviews before closure\n# Recommended Chart: BAR CHART → Keys: Pain_Point | Values: Count\n\nfrom pyspark.sql import functions as F\n\n# Load tables from Hive\nbusiness_df = spark.table(\"yelp.business\")\nreviews_df  = spark.table(\"yelp.review\")\n\n# Step 1: Identify cursed storefronts\n# Addresses that had multiple different businesses open and close\ncursed_storefronts = business_df \\\n    .groupBy(\"address\", \"city\", \"state\") \\\n    .agg(\n        F.count(\"business_id\").alias(\"total_businesses\"),\n        F.sum(F.when(F.col(\"is_open\") == 0, 1).otherwise(0)).alias(\"closed_count\")\n    ) \\\n    .filter(\n        (F.col(\"total_businesses\") > 1) &\n        (F.col(\"closed_count\") > 1)\n    )\n\n# Step 2: Get closed businesses in cursed locations\nclosed_cursed = cursed_storefronts \\\n    .join(business_df, [\"address\", \"city\", \"state\"], \"inner\") \\\n    .filter(F.col(\"is_open\") == 0) \\\n    .select(\"business_id\", \"name\", \"address\", \"city\")\n\nprint(\"Closed businesses in cursed locations: {}\".format(closed_cursed.count()))\n\n# Step 3: Get reviews for these closed businesses\ncursed_reviews = closed_cursed \\\n    .join(\n        reviews_df,\n        closed_cursed.business_id == reviews_df.rev_business_id,\n        \"inner\"\n    ) \\\n    .select(\n        closed_cursed.business_id,\n        F.col(\"name\"),\n        F.col(\"address\"),\n        F.col(\"city\"),\n        F.col(\"rev_text\").alias(\"text\"),\n        F.col(\"rev_stars\").alias(\"stars\"),\n        F.col(\"rev_date\").alias(\"date\")\n    )\n\nprint(\"Total reviews: {}\".format(cursed_reviews.count()))\n\n# Step 4: Count pain point keywords in review text\nparking_count   = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"parking\")).count()\nhidden_count    = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"hidden\")).count()\nnoise_count     = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"noise\")).count()\nexpensive_count = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"expensive\")).count()\nlocation_count  = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"location\")).count()\nservice_count   = cursed_reviews.filter(F.lower(F.col(\"text\")).contains(\"slow service\")).count()\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"REVIEW AUTOPSY - PAIN POINT ANALYSIS\")\nprint(\"=\" * 70)\n\n# Step 5: Create pain point dataframe and show chart\npain_data = [\n    (\"Parking Issues\",   parking_count),\n    (\"Hidden Location\",  hidden_count),\n    (\"Noise Complaints\", noise_count),\n    (\"Price Issues\",     expensive_count),\n    (\"Bad Location\",     location_count),\n    (\"Slow Service\",     service_count)\n]\n\npain_df = spark.createDataFrame(\n    pain_data, [\"Pain_Point\", \"Count\"]\n).orderBy(F.col(\"Count\").desc())\n\nprint(\"\\nChart: Pain Point Distribution\")\nz.show(pain_df)","user":"anonymous","dateUpdated":"2026-03-25T21:22:01+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"Pain_Point","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Hive Session ID = e239fc19-dfe4-4682-9c6e-f359c09ebeb2\nClosed businesses in cursed locations: 7808\nTotal reviews: 380065\n\n======================================================================\nREVIEW AUTOPSY - PAIN POINT ANALYSIS\n======================================================================\n\nChart: Pain Point Distribution\n"},{"type":"TABLE","data":"Pain_Point\tCount\nBad Location\t22413\nPrice Issues\t10646\nParking Issues\t10201\nHidden Location\t3451\nNoise Complaints\t1884\nSlow Service\t1259\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=0"},{"jobUrl":"http://node-master:4040/jobs/job?id=1"},{"jobUrl":"http://node-master:4040/jobs/job?id=2"},{"jobUrl":"http://node-master:4040/jobs/job?id=3"},{"jobUrl":"http://node-master:4040/jobs/job?id=4"},{"jobUrl":"http://node-master:4040/jobs/job?id=5"},{"jobUrl":"http://node-master:4040/jobs/job?id=6"},{"jobUrl":"http://node-master:4040/jobs/job?id=7"},{"jobUrl":"http://node-master:4040/jobs/job?id=8"},{"jobUrl":"http://node-master:4040/jobs/job?id=9"},{"jobUrl":"http://node-master:4040/jobs/job?id=10"},{"jobUrl":"http://node-master:4040/jobs/job?id=11"},{"jobUrl":"http://node-master:4040/jobs/job?id=12"},{"jobUrl":"http://node-master:4040/jobs/job?id=13"},{"jobUrl":"http://node-master:4040/jobs/job?id=14"},{"jobUrl":"http://node-master:4040/jobs/job?id=15"},{"jobUrl":"http://node-master:4040/jobs/job?id=16"},{"jobUrl":"http://node-master:4040/jobs/job?id=17"},{"jobUrl":"http://node-master:4040/jobs/job?id=18"},{"jobUrl":"http://node-master:4040/jobs/job?id=19"},{"jobUrl":"http://node-master:4040/jobs/job?id=20"},{"jobUrl":"http://node-master:4040/jobs/job?id=21"},{"jobUrl":"http://node-master:4040/jobs/job?id=22"},{"jobUrl":"http://node-master:4040/jobs/job?id=23"},{"jobUrl":"http://node-master:4040/jobs/job?id=24"},{"jobUrl":"http://node-master:4040/jobs/job?id=25"},{"jobUrl":"http://node-master:4040/jobs/job?id=26"},{"jobUrl":"http://node-master:4040/jobs/job?id=27"},{"jobUrl":"http://node-master:4040/jobs/job?id=28"},{"jobUrl":"http://node-master:4040/jobs/job?id=29"},{"jobUrl":"http://node-master:4040/jobs/job?id=30"},{"jobUrl":"http://node-master:4040/jobs/job?id=31"},{"jobUrl":"http://node-master:4040/jobs/job?id=32"},{"jobUrl":"http://node-master:4040/jobs/job?id=33"},{"jobUrl":"http://node-master:4040/jobs/job?id=34"},{"jobUrl":"http://node-master:4040/jobs/job?id=35"},{"jobUrl":"http://node-master:4040/jobs/job?id=36"},{"jobUrl":"http://node-master:4040/jobs/job?id=37"},{"jobUrl":"http://node-master:4040/jobs/job?id=38"},{"jobUrl":"http://node-master:4040/jobs/job?id=39"},{"jobUrl":"http://node-master:4040/jobs/job?id=40"},{"jobUrl":"http://node-master:4040/jobs/job?id=41"},{"jobUrl":"http://node-master:4040/jobs/job?id=42"},{"jobUrl":"http://node-master:4040/jobs/job?id=43"},{"jobUrl":"http://node-master:4040/jobs/job?id=44"},{"jobUrl":"http://node-master:4040/jobs/job?id=45"},{"jobUrl":"http://node-master:4040/jobs/job?id=46"},{"jobUrl":"http://node-master:4040/jobs/job?id=47"},{"jobUrl":"http://node-master:4040/jobs/job?id=48"},{"jobUrl":"http://node-master:4040/jobs/job?id=49"},{"jobUrl":"http://node-master:4040/jobs/job?id=50"},{"jobUrl":"http://node-master:4040/jobs/job?id=51"},{"jobUrl":"http://node-master:4040/jobs/job?id=52"},{"jobUrl":"http://node-master:4040/jobs/job?id=53"},{"jobUrl":"http://node-master:4040/jobs/job?id=54"},{"jobUrl":"http://node-master:4040/jobs/job?id=55"},{"jobUrl":"http://node-master:4040/jobs/job?id=56"},{"jobUrl":"http://node-master:4040/jobs/job?id=57"},{"jobUrl":"http://node-master:4040/jobs/job?id=58"},{"jobUrl":"http://node-master:4040/jobs/job?id=59"},{"jobUrl":"http://node-master:4040/jobs/job?id=60"},{"jobUrl":"http://node-master:4040/jobs/job?id=61"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774428334595_1492355713","id":"paragraph_1774428334595_1492355713","dateCreated":"2026-03-25T16:45:34+0800","dateStarted":"2026-03-25T18:56:09+0800","dateFinished":"2026-03-25T19:00:39+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n# Task 7: External Data Cross-Validation\n# Cross-validate cursed storefronts with walkability, business potential\n# and zoning status derived from Yelp data\n# Charts: 7a. Walk Score Distribution, 7b. Business Potential, 7c. Zoning Status\n\nfrom pyspark.sql import functions as F\nfrom pyspark.sql.window import Window\n\n# Load tables from Hive\nbusiness_df = spark.table(\"yelp.business\")\nreview_df   = spark.table(\"yelp.review\")\ncheckin_df  = spark.table(\"yelp.checkin\")\n\n# ── Step 1: Build cursed storefronts ────────────────────────────────────────\ncursed_storefronts = business_df \\\n    .groupBy(\"address\", \"city\", \"state\", \"postal_code\") \\\n    .agg(\n        F.count(\"business_id\").alias(\"total_businesses\"),\n        F.sum(F.when(F.col(\"is_open\") == 0, 1).otherwise(0)).alias(\"closed_count\")\n    ) \\\n    .withColumn(\"failure_rate\",\n        F.round(F.col(\"closed_count\") / F.col(\"total_businesses\") * 100, 2)) \\\n    .filter(\n        (F.col(\"total_businesses\") > 1) &\n        (F.col(\"closed_count\") > 1)\n    ) \\\n    .withColumn(\"cursed_level\",\n        F.when(F.col(\"failure_rate\") >= 80, \"Highly Cursed\")\n        .when(F.col(\"failure_rate\") >= 50, \"Moderately Cursed\")\n        .otherwise(\"Mildly Cursed\"))\n\n# ── Step 2: Count checkins per business ─────────────────────────────────────\ncheckin_counts = checkin_df \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .groupBy(\"business_id\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\"))\n\n# ── Step 3: Count reviews per business ──────────────────────────────────────\n# Rename to avoid conflict with business_df.review_count column\nreview_counts = review_df \\\n    .groupBy(\"rev_business_id\") \\\n    .agg(\n        F.count(\"*\").alias(\"rev_count\"),\n        F.avg(\"rev_stars\").alias(\"avg_stars\")\n    )\n\n# ── Step 4: Join business with checkins and reviews ─────────────────────────\n# Drop business_df.review_count first to avoid ambiguity\nbiz_enriched = business_df \\\n    .drop(\"review_count\") \\\n    .join(checkin_counts, \"business_id\", \"left\") \\\n    .join(\n        review_counts,\n        business_df.business_id == review_counts.rev_business_id,\n        \"left\"\n    ) \\\n    .drop(\"rev_business_id\") \\\n    .fillna(0, subset=[\"checkin_count\", \"rev_count\"])\n\n# ── Step 5: Build zipcodes_enriched by aggregating per zipcode ───────────────\nzipcodes_enriched = biz_enriched \\\n    .groupBy(\"postal_code\") \\\n    .agg(\n        F.count(\"business_id\").alias(\"business_density\"),\n        F.sum(\"checkin_count\").alias(\"total_checkins\"),\n        F.sum(\"rev_count\").alias(\"total_reviews\"),\n        F.round(F.avg(\"avg_stars\"), 2).alias(\"avg_rating\")\n    ) \\\n    .withColumn(\"walk_score\",\n        F.round(\n            (F.col(\"business_density\") * 0.4 +\n             F.col(\"total_checkins\") * 0.0001 +\n             F.col(\"total_reviews\") * 0.0001), 2)) \\\n    .withColumn(\"walkability_category\",\n        F.when(F.col(\"walk_score\") >= 70, \"Walker's Paradise\")\n        .when(F.col(\"walk_score\") >= 50, \"Very Walkable\")\n        .when(F.col(\"walk_score\") >= 25, \"Somewhat Walkable\")\n        .otherwise(\"Car Dependent\")) \\\n    .withColumn(\"foot_traffic_potential\",\n        F.when(F.col(\"total_checkins\") >= 1000, \"High\")\n        .when(F.col(\"total_checkins\") >= 500,  \"Medium\")\n        .otherwise(\"Low\")) \\\n    .withColumn(\"business_potential\",\n        F.when(F.col(\"avg_rating\") >= 4.0, \"High Potential\")\n        .when(F.col(\"avg_rating\") >= 3.0, \"Medium Potential\")\n        .otherwise(\"Low Potential\")) \\\n    .withColumnRenamed(\"postal_code\", \"zip\")\n\n# ── Step 6: Build commercial_zones from Yelp categories ─────────────────────\ncommercial_zones = business_df \\\n    .groupBy(\"city\") \\\n    .agg(\n        F.count(\"business_id\").alias(\"biz_count\"),\n        F.sum(F.when(F.col(\"categories\").like(\"%Restaurant%\"), 1)\n            .otherwise(0)).alias(\"restaurant_count\"),\n        F.sum(F.when(F.col(\"categories\").like(\"%Shopping%\"), 1)\n            .otherwise(0)).alias(\"shopping_count\"),\n        F.sum(F.when(F.col(\"categories\").like(\"%Nightlife%\"), 1)\n            .otherwise(0)).alias(\"nightlife_count\")\n    ) \\\n    .withColumn(\"zoninggroup\",\n        F.when(F.col(\"restaurant_count\") > F.col(\"shopping_count\"),\n            \"Food & Dining District\")\n        .when(F.col(\"shopping_count\") > F.col(\"nightlife_count\"),\n            \"Retail District\")\n        .when(F.col(\"nightlife_count\") > 0,\n            \"Entertainment District\")\n        .otherwise(\"Mixed Use\")) \\\n    .withColumnRenamed(\"city\", \"code\")\n\n# ── Step 7: Cross-validate cursed storefronts ────────────────────────────────\ncursed_validation = cursed_storefronts.alias(\"cursed\") \\\n    .join(zipcodes_enriched.alias(\"zip\"),\n          F.col(\"cursed.postal_code\") == F.col(\"zip.zip\"), \"left\") \\\n    .join(commercial_zones.alias(\"zone\"),\n          F.col(\"cursed.city\") == F.col(\"zone.code\"), \"left\") \\\n    .select(\n        F.col(\"cursed.address\"),\n        F.col(\"cursed.city\"),\n        F.col(\"cursed.state\"),\n        F.col(\"cursed.total_businesses\"),\n        F.col(\"cursed.closed_count\"),\n        F.col(\"cursed.failure_rate\"),\n        F.col(\"cursed.cursed_level\"),\n        F.col(\"zip.walk_score\").alias(\"neighborhood_walk_score\"),\n        F.col(\"zip.walkability_category\"),\n        F.col(\"zip.foot_traffic_potential\"),\n        F.col(\"zip.business_potential\"),\n        F.col(\"zone.zoninggroup\").alias(\"commercial_zoning_status\")\n    )\n\nprint(\"=\" * 70)\nprint(\"EXTERNAL DATA CROSS-VALIDATION\")\nprint(\"=\" * 70)\n\n# ── Chart 7a: Cursed Locations by Walk Score Category ───────────────────────\nwalk_score_validation = cursed_validation \\\n    .groupBy(\"walkability_category\") \\\n    .agg(\n        F.count(\"*\").alias(\"cursed_count\"),\n        F.round(F.avg(\"failure_rate\"), 2).alias(\"avg_failure_rate\")\n    ) \\\n    .filter(F.col(\"walkability_category\").isNotNull()) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\nprint(\"\\nChart 7a: Cursed Locations by Walk Score Category:\")\nz.show(walk_score_validation)\n\n# ── Chart 7b: Cursed Locations by Business Potential ────────────────────────\nbusiness_potential_validation = cursed_validation \\\n    .groupBy(\"business_potential\") \\\n    .agg(\n        F.count(\"*\").alias(\"cursed_count\"),\n        F.round(F.avg(\"failure_rate\"), 2).alias(\"avg_failure_rate\")\n    ) \\\n    .filter(F.col(\"business_potential\").isNotNull()) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\nprint(\"\\nChart 7b: Cursed Locations by Business Potential:\")\nz.show(business_potential_validation)\n\n# ── Chart 7c: Cursed Locations by Zoning Status ─────────────────────────────\nzoning_validation = cursed_validation \\\n    .groupBy(\"commercial_zoning_status\") \\\n    .agg(\n        F.count(\"*\").alias(\"cursed_count\"),\n        F.round(F.avg(\"failure_rate\"), 2).alias(\"avg_failure_rate\")\n    ) \\\n    .filter(F.col(\"commercial_zoning_status\").isNotNull()) \\\n    .orderBy(F.col(\"cursed_count\").desc()) \\\n    .limit(10)\n\nprint(\"\\nChart 7c: Cursed Locations by Zoning Status:\")\nz.show(zoning_validation)","user":"anonymous","dateUpdated":"2026-03-25T19:38:20+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"walkability_category","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"business_potential","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}},"5":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"commercial_zoning_status","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"======================================================================\nEXTERNAL DATA CROSS-VALIDATION\n======================================================================\n\nChart 7a: Cursed Locations by Walk Score Category:\n"},{"type":"TABLE","data":"walkability_category\tcursed_count\tavg_failure_rate\nWalker's Paradise\t2644\t78.26\nSomewhat Walkable\t150\t82.03\nVery Walkable\t143\t79.2\nCar Dependent\t116\t81.45\n"},{"type":"TEXT","data":"\n\nChart 7b: Cursed Locations by Business Potential:\n"},{"type":"TABLE","data":"business_potential\tcursed_count\tavg_failure_rate\nMedium Potential\t2870\t78.73\nHigh Potential\t174\t77.53\nLow Potential\t9\t59.28\n"},{"type":"TEXT","data":"\n\nChart 7c: Cursed Locations by Zoning Status:\n"},{"type":"TABLE","data":"commercial_zoning_status\tcursed_count\tavg_failure_rate\nFood & Dining District\t3010\t78.74\nRetail District\t43\t69.3\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=62"},{"jobUrl":"http://node-master:4040/jobs/job?id=63"},{"jobUrl":"http://node-master:4040/jobs/job?id=64"},{"jobUrl":"http://node-master:4040/jobs/job?id=65"},{"jobUrl":"http://node-master:4040/jobs/job?id=66"},{"jobUrl":"http://node-master:4040/jobs/job?id=67"},{"jobUrl":"http://node-master:4040/jobs/job?id=68"},{"jobUrl":"http://node-master:4040/jobs/job?id=69"},{"jobUrl":"http://node-master:4040/jobs/job?id=70"},{"jobUrl":"http://node-master:4040/jobs/job?id=71"},{"jobUrl":"http://node-master:4040/jobs/job?id=72"},{"jobUrl":"http://node-master:4040/jobs/job?id=73"},{"jobUrl":"http://node-master:4040/jobs/job?id=74"},{"jobUrl":"http://node-master:4040/jobs/job?id=75"},{"jobUrl":"http://node-master:4040/jobs/job?id=76"},{"jobUrl":"http://node-master:4040/jobs/job?id=77"},{"jobUrl":"http://node-master:4040/jobs/job?id=78"},{"jobUrl":"http://node-master:4040/jobs/job?id=79"},{"jobUrl":"http://node-master:4040/jobs/job?id=80"},{"jobUrl":"http://node-master:4040/jobs/job?id=81"},{"jobUrl":"http://node-master:4040/jobs/job?id=82"},{"jobUrl":"http://node-master:4040/jobs/job?id=83"},{"jobUrl":"http://node-master:4040/jobs/job?id=84"},{"jobUrl":"http://node-master:4040/jobs/job?id=85"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774428357929_1151035317","id":"paragraph_1774428357929_1151035317","dateCreated":"2026-03-25T16:45:57+0800","dateStarted":"2026-03-25T19:04:25+0800","dateFinished":"2026-03-25T19:05:48+0800","status":"FINISHED"},{"text":"%pyspark\n# Task 8: Multi-Dimensional Attribution\n# Compare cursed vs golden locations using walkability and business potential\n# Charts: Walkability distribution and Business potential for both location types\n\nfrom pyspark.sql import functions as F\n\n# Load tables from Hive\nbusiness_df = spark.table(\"yelp.business\")\nreview_df   = spark.table(\"yelp.review\")\n\n# ── Step 1: Build golden locations ──────────────────────────────────────────\n# Golden locations = addresses with consistently high ratings and many reviews\n\nreview_counts = review_df \\\n    .groupBy(\"rev_business_id\") \\\n    .agg(\n        F.count(\"*\").alias(\"rev_count\"),\n        F.round(F.avg(\"rev_stars\"), 3).alias(\"avg_rating\")\n    )\n\ngolden_locations = business_df \\\n    .drop(\"review_count\") \\\n    .join(\n        review_counts,\n        business_df.business_id == review_counts.rev_business_id,\n        \"inner\"\n    ) \\\n    .drop(\"rev_business_id\") \\\n    .filter(\n        (F.col(\"avg_rating\") >= 4.5) &\n        (F.col(\"rev_count\") >= 100) &\n        (F.col(\"is_open\") == 1)\n    ) \\\n    .groupBy(\"address\", \"city\", \"state\", \"postal_code\") \\\n    .agg(\n        F.round(F.avg(\"avg_rating\"), 3).alias(\"avg_rating\"),\n        F.sum(\"rev_count\").alias(\"total_reviews\")\n    )\n\nprint(\"Golden locations found:\", golden_locations.count())\n\n# ── Step 2: Enrich golden locations with zipcodes_enriched ──────────────────\n# Note: zipcodes_enriched must be built from Task 7 paragraph first\ngolden_validation = golden_locations.alias(\"golden\") \\\n    .join(zipcodes_enriched.alias(\"zip\"),\n          F.col(\"golden.postal_code\") == F.col(\"zip.zip\"), \"left\") \\\n    .select(\n        F.col(\"golden.address\"),\n        F.col(\"golden.city\"),\n        F.col(\"golden.state\"),\n        F.col(\"golden.avg_rating\"),\n        F.col(\"golden.total_reviews\"),\n        F.col(\"zip.walk_score\").alias(\"neighborhood_walk_score\"),\n        F.col(\"zip.walkability_category\"),\n        F.col(\"zip.foot_traffic_potential\"),\n        F.col(\"zip.business_potential\")\n    )\n\nprint(\"=\" * 70)\nprint(\"MULTI-DIMENSIONAL ATTRIBUTION\")\nprint(\"CURSED vs GOLDEN LOCATIONS COMPARISON\")\nprint(\"=\" * 70)\n\n# ── Walk score comparison ────────────────────────────────────────────────────\ncursed_avg_walk = cursed_validation \\\n    .agg(F.avg(\"neighborhood_walk_score\")).collect()[0][0]\ngolden_avg_walk = golden_validation \\\n    .agg(F.avg(\"neighborhood_walk_score\")).collect()[0][0]\n\nprint(\"\\nWALK SCORE COMPARISON:\")\nprint(\"Cursed locations avg walk score: {:.2f}\".format(\n    cursed_avg_walk if cursed_avg_walk else 0))\nprint(\"Golden locations avg walk score: {:.2f}\".format(\n    golden_avg_walk if golden_avg_walk else 0))\n\n# ── Chart A: Walkability distribution comparison ─────────────────────────────\ncursed_walk = cursed_validation \\\n    .groupBy(\"walkability_category\") \\\n    .agg(F.count(\"*\").alias(\"cursed_count\")) \\\n    .filter(F.col(\"walkability_category\").isNotNull()) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\ngolden_walk = golden_validation \\\n    .groupBy(\"walkability_category\") \\\n    .agg(F.count(\"*\").alias(\"golden_count\")) \\\n    .filter(F.col(\"walkability_category\").isNotNull()) \\\n    .orderBy(F.col(\"golden_count\").desc())\n\n# Join both for side by side comparison\nwalk_comparison = cursed_walk \\\n    .join(golden_walk, \"walkability_category\", \"outer\") \\\n    .fillna(0, subset=[\"cursed_count\", \"golden_count\"]) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\nprint(\"\\nChart A: Walkability Category — Cursed vs Golden:\")\nz.show(walk_comparison)\n\n# ── Chart B: Business potential comparison ───────────────────────────────────\ncursed_potential = cursed_validation \\\n    .groupBy(\"business_potential\") \\\n    .agg(F.count(\"*\").alias(\"cursed_count\")) \\\n    .filter(F.col(\"business_potential\").isNotNull()) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\ngolden_potential = golden_validation \\\n    .groupBy(\"business_potential\") \\\n    .agg(F.count(\"*\").alias(\"golden_count\")) \\\n    .filter(F.col(\"business_potential\").isNotNull()) \\\n    .orderBy(F.col(\"golden_count\").desc())\n\n# Join both for side by side comparison\npotential_comparison = cursed_potential \\\n    .join(golden_potential, \"business_potential\", \"outer\") \\\n    .fillna(0, subset=[\"cursed_count\", \"golden_count\"]) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\nprint(\"\\nChart B: Business Potential — Cursed vs Golden:\")\nz.show(potential_comparison)\n\n# ── Chart C: Foot traffic potential comparison ───────────────────────────────\ncursed_traffic = cursed_validation \\\n    .groupBy(\"foot_traffic_potential\") \\\n    .agg(F.count(\"*\").alias(\"cursed_count\")) \\\n    .filter(F.col(\"foot_traffic_potential\").isNotNull())\n\ngolden_traffic = golden_validation \\\n    .groupBy(\"foot_traffic_potential\") \\\n    .agg(F.count(\"*\").alias(\"golden_count\")) \\\n    .filter(F.col(\"foot_traffic_potential\").isNotNull())\n\ntraffic_comparison = cursed_traffic \\\n    .join(golden_traffic, \"foot_traffic_potential\", \"outer\") \\\n    .fillna(0, subset=[\"cursed_count\", \"golden_count\"]) \\\n    .orderBy(F.col(\"cursed_count\").desc())\n\nprint(\"\\nChart C: Foot Traffic Potential — Cursed vs Golden:\")\nz.show(traffic_comparison)","user":"anonymous","dateUpdated":"2026-03-25T21:23:14+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"walkability_category","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"business_potential","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}},"5":{"graph":{"mode":"table","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"foot_traffic_potential","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cursed_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Golden locations found: 1288\n======================================================================\nMULTI-DIMENSIONAL ATTRIBUTION\nCURSED vs GOLDEN LOCATIONS COMPARISON\n======================================================================\n\nWALK SCORE COMPARISON:\nCursed locations avg walk score: 236.55\nGolden locations avg walk score: 249.59\n\nChart A: Walkability Category — Cursed vs Golden:\n"},{"type":"TABLE","data":"walkability_category\tcursed_count\tgolden_count\nWalker's Paradise\t2644\t1132\nSomewhat Walkable\t150\t51\nVery Walkable\t143\t66\nCar Dependent\t116\t39\n"},{"type":"TEXT","data":"\n\nChart B: Business Potential — Cursed vs Golden:\n"},{"type":"TABLE","data":"business_potential\tcursed_count\tgolden_count\nMedium Potential\t2870\t1167\nHigh Potential\t174\t121\nLow Potential\t9\t0\n"},{"type":"TEXT","data":"\n\nChart C: Foot Traffic Potential — Cursed vs Golden:\n"},{"type":"TABLE","data":"foot_traffic_potential\tcursed_count\tgolden_count\nHigh\t2998\t1277\nLow\t30\t8\nMedium\t25\t3\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=86"},{"jobUrl":"http://node-master:4040/jobs/job?id=87"},{"jobUrl":"http://node-master:4040/jobs/job?id=88"},{"jobUrl":"http://node-master:4040/jobs/job?id=89"},{"jobUrl":"http://node-master:4040/jobs/job?id=90"},{"jobUrl":"http://node-master:4040/jobs/job?id=91"},{"jobUrl":"http://node-master:4040/jobs/job?id=92"},{"jobUrl":"http://node-master:4040/jobs/job?id=93"},{"jobUrl":"http://node-master:4040/jobs/job?id=94"},{"jobUrl":"http://node-master:4040/jobs/job?id=95"},{"jobUrl":"http://node-master:4040/jobs/job?id=96"},{"jobUrl":"http://node-master:4040/jobs/job?id=97"},{"jobUrl":"http://node-master:4040/jobs/job?id=98"},{"jobUrl":"http://node-master:4040/jobs/job?id=99"},{"jobUrl":"http://node-master:4040/jobs/job?id=100"},{"jobUrl":"http://node-master:4040/jobs/job?id=101"},{"jobUrl":"http://node-master:4040/jobs/job?id=102"},{"jobUrl":"http://node-master:4040/jobs/job?id=103"},{"jobUrl":"http://node-master:4040/jobs/job?id=104"},{"jobUrl":"http://node-master:4040/jobs/job?id=105"},{"jobUrl":"http://node-master:4040/jobs/job?id=106"},{"jobUrl":"http://node-ma