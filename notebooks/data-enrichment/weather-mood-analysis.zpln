{"paragraphs":[{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Optional: Define a mapping to consolidate duplicate city names (e.g., \"St. Louis\" and \"Saint Louis\")\ncity_alias = {\n    \"Saint Louis\": \"St. Louis\",\n    \"Saint Petersburg\": \"St. Petersburg\"\n}\n# Apply mapping to the 'city' column (you can do this in your DataFrame)\n\n# Filter restaurants (businesses with \"Restaurants\" in categories)\nrestaurants = spark.table(\"business\").filter(F.col(\"categories\").contains(\"Restaurants\"))\n\n# If you want to use a predefined list of cities (e.g., your top 20)\ntop20_cities = [\n    \"Philadelphia\", \"Tampa\", \"Indianapolis\", \"Nashville\", \"Tucson\",\n    \"New Orleans\", \"Edmonton\", \"Saint Louis\", \"Reno\", \"Boise\",\n    \"Santa Barbara\", \"Clearwater\", \"Wilmington\", \"St. Louis\", \"Metairie\",\n    \"Saint Petersburg\", \"Franklin\", \"St. Petersburg\", \"Sparks\", \"Brandon\"\n]\n\n# Alternatively, compute top 20 dynamically (as you did before)\n# top20_cities = restaurants.groupBy(\"city\").count().orderBy(F.desc(\"count\")).limit(20).select(\"city\").collect()\n# top20_cities = [row.city for row in top20_cities]\n\nprint(\"=== State breakdown for each city (restaurant count by state) ===\\n\")\nfor city in top20_cities:\n    state_counts = restaurants.filter(F.col(\"city\") == city) \\\n        .groupBy(\"state\") \\\n        .count() \\\n        .withColumnRenamed(\"count\", \"restaurant_count\") \\\n        .orderBy(F.desc(\"restaurant_count\"))\n    \n    total = state_counts.agg(F.sum(\"restaurant_count\")).collect()[0][0]\n    if total > 0:\n        print(f\"{city}:\")\n        state_counts.show(truncate=False)\n    else:\n        print(f\"{city}: No restaurants found.\")","user":"anonymous","dateUpdated":"2026-03-24T22:07:14+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== State breakdown for each city (restaurant count by state) ===\n\nPhiladelphia:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|PA   |5852            |\n+-----+----------------+\n\nTampa:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|FL   |2960            |\n+-----+----------------+\n\nIndianapolis:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|IN   |2862            |\n+-----+----------------+\n\nNashville:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|TN   |2502            |\n+-----+----------------+\n\nTucson:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|AZ   |2466            |\n+-----+----------------+\n\nNew Orleans:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|LA   |2259            |\n+-----+----------------+\n\nEdmonton:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|AB   |2166            |\n+-----+----------------+\n\nSaint Louis:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|MO   |1790            |\n+-----+----------------+\n\nReno:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|NV   |1286            |\n+-----+----------------+\n\nBoise:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|ID   |847             |\n+-----+----------------+\n\nSanta Barbara:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|CA   |767             |\n+-----+----------------+\n\nClearwater:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|FL   |678             |\n+-----+----------------+\n\nWilmington:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|DE   |619             |\n+-----+----------------+\n\nSt. Louis:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|MO   |542             |\n|IL   |1               |\n+-----+----------------+\n\nMetairie:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|LA   |522             |\n+-----+----------------+\n\nSaint Petersburg:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|FL   |491             |\n+-----+----------------+\n\nFranklin:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|TN   |442             |\n|NJ   |1               |\n|IN   |1               |\n+-----+----------------+\n\nSt. Petersburg:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|FL   |404             |\n+-----+----------------+\n\nSparks:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|NV   |334             |\n+-----+----------------+\n\nBrandon:\n+-----+----------------+\n|state|restaurant_count|\n+-----+----------------+\n|FL   |326             |\n+-----+----------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=816"},{"jobUrl":"http://node-master:4040/jobs/job?id=817"},{"jobUrl":"http://node-master:4040/jobs/job?id=818"},{"jobUrl":"http://node-master:4040/jobs/job?id=819"},{"jobUrl":"http://node-master:4040/jobs/job?id=820"},{"jobUrl":"http://node-master:4040/jobs/job?id=821"},{"jobUrl":"http://node-master:4040/jobs/job?id=822"},{"jobUrl":"http://node-master:4040/jobs/job?id=823"},{"jobUrl":"http://node-master:4040/jobs/job?id=824"},{"jobUrl":"http://node-master:4040/jobs/job?id=825"},{"jobUrl":"http://node-master:4040/jobs/job?id=826"},{"jobUrl":"http://node-master:4040/jobs/job?id=827"},{"jobUrl":"http://node-master:4040/jobs/job?id=828"},{"jobUrl":"http://node-master:4040