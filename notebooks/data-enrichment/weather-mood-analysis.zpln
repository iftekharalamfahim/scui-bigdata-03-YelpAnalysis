rl":"http://node-master:4040/jobs/job?id=905"},{"jobUrl":"http://node-master:4040/jobs/job?id=906"},{"jobUrl":"http://node-master:4040/jobs/job?id=907"},{"jobUrl":"http://node-master:4040/jobs/job?id=908"},{"jobUrl":"http://node-master:4040/jobs/job?id=909"},{"jobUrl":"http://node-master:4040/jobs/job?id=910"},{"jobUrl":"http://node-master:4040/jobs/job?id=911"},{"jobUrl":"http://node-master:4040/jobs/job?id=912"},{"jobUrl":"http://node-master:4040/jobs/job?id=913"},{"jobUrl":"http://node-master:4040/jobs/job?id=914"},{"jobUrl":"http://node-master:4040/jobs/job?id=915"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774337359691_1551500956","id":"paragraph_1774337359691_1551500956","dateCreated":"2026-03-24T15:29:19+0800","dateStarted":"2026-03-24T22:07:14+0800","dateFinished":"2026-03-24T22:07:30+0800","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Load both files\nusa1_df = spark.read.csv(\"hdfs:///user/data/weather/usa_1.csv\", header=True, inferSchema=True)\nusa2_df = spark.read.csv(\"hdfs:///user/data/weather/usa_2.csv\", header=True, inferSchema=True)\n\n# Combine\nall_weather = usa1_df.union(usa2_df)\n\nprint(f\"Total rows: {all_weather.count()}\")\nprint(\"\\nAll stations:\")\nall_weather.select(\"STATION\", \"NAME\").distinct().orderBy(\"NAME\").show(50, truncate=False)\nprint(\"\\nDate range:\")\nall_weather.agg(F.min(\"DATE\"), F.max(\"DATE\")).show()","user":"anonymous","dateUpdated":"2026-03-25T09:31:31+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total rows: 158753\n\nAll stations:\n+-----------+-----------------------------------------------------+\n|STATION    |NAME                                                 |\n+-----------+-----------------------------------------------------+\n|USC00280331|ATSION, NJ US                                        |\n|USW00003761|AVONDALE 2 N, PA US                                  |\n|USS0019K08S|BIG MEADOW, NV US                                    |\n|USS0016F02S|BOGUS BASIN, ID US                                   |\n|USW00024131|BOISE AIR TERMINAL, ID US                            |\n|USR0000TBUR|BURNS TENNESSEE, TN US                               |\n|USW00003960|CAHOKIA ST LOUIS DOWNTOWN AIRPORT, IL US             |\n|USR0000NDSS|DESERT SPRINGS NEVADA, NV US                         |\n|USR0000CDOG|DOG VALLEY CALIFORNIA, CA US                         |\n|USW00054786|DOYLESTOWN AIRPORT, PA US                            |\n|USC00402989|FAIRVIEW BOWIE NATURE CENTER, TN US                  |\n|USC00123093|FRANKLIN 1 W, IN US                                  |\n|USC00403280|FRANKLIN SEWAGE PLANT, TN US                         |\n|USC00123091|FRANKLIN WWTP, IN US                                 |\n|USR0000NGAL|GALENA NEVADA, NV US                                 |\n|USC00403465|GLADEVILLE, TN US                                    |\n|USC00403636|GOODLETTSVILLE 7 WNW, TN US                          |\n|USC00123527|GREENFIELD, IN US                                    |\n|USC00283662|HAMMONTON 1 NE, NJ US                                |\n|USW00054782|HERITAGE FIELD AIRPORT, PA US                        |\n|USC00284229|INDIAN MILLS 2 W, NJ US                              |\n|USC00124249|INDIANAPOLIS EAGLE CREEK 4 NNE, IN US                |\n|USW00053842|INDIANAPOLIS EAGLE CREEK AIRPORT, IN US              |\n|USW00093819|INDIANAPOLIS INTERNATIONAL AIRPORT, IN US            |\n|USC00124260|INDIANAPOLIS WEATHER FORECAST OFFICE, IN US          |\n|USC00124356|JAMESTOWN 2 E, IN US                                 |\n|USC00404876|KINGSTON SPRINGS, TN US                              |\n|USC00405108|LEBANON, TN US                                       |\n|USR0000CLOP|LOS PRIETOS CALIFORNIA, CA US                        |\n|USR0000CMNC|MONTECITO CALIFORNIA, CA US                          |\n|USC00406180|MONTGOMERY BELL STATE PARK, TN US                    |\n|USC00285728|MOORESTOWN 4 E, NJ US                                |\n|USS0019K07S|MOUNT ROSE SKI AREA, NV US                           |\n|USC00285875|MULLICA HILL, NJ US                                  |\n|USC00406371|MURFREESBORO 5 N, TN US                              |\n|USC00406374|MURFREESBORO STONES RIVER N.B., TN US                |\n|USC00406403|NASHVILLE BERRY FIELD, TN US                         |\n|USW00013897|NASHVILLE INTERNATIONAL AIRPORT, TN US               |\n|USC00406435|NEAPOLIS EXPERIMENTAL STATION, TN US                 |\n|USW00012916|NEW ORLEANS AIRPORT, LA US                           |\n|USW00012930|NEW ORLEANS AUDUBON, LA US                           |\n|USW00053917|NEW ORLEANS LAKEFRONT AIRPORT, LA US                 |\n|USW00094732|NORTHEAST PHILADELPHIA AIRPORT, PA US                |\n|USC00406803|OLD HICKORY DAM, TN US                               |\n|USC00406806|OLD HICKORY WEATHER FORECAST OFFICE, TN US           |\n|USC00286864|PENNSAUKEN 1 N, NJ US                                |\n|USW00013739|PHILADELPHIA INTERNATIONAL AIRPORT, PA US            |\n|USC00286964|PHILADELPHIA MT. HOLLY WEATHER FORECAST OFFICE, NJ US|\n|USW00023185|RENO AIRPORT, NV US                                  |\n|USC00266791|RENO WEATHER FORECAST OFFICE, NV US                  |\n+-----------+-----------------------------------------------------+\nonly showing top 50 rows\n\n\nDate range:\n+----------+----------+\n| min(DATE)| max(DATE)|\n+----------+----------+\n|2017-01-01|2022-12-31|\n+----------+----------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=933"},{"jobUrl":"http://node-master:4040/jobs/job?id=934"},{"jobUrl":"http://node-master:4040/jobs/job?id=935"},{"jobUrl":"http://node-master:4040/jobs/job?id=936"},{"jobUrl":"http://node-master:4040/jobs/job?id=937"},{"jobUrl":"http://node-master:4040/jobs/job?id=938"},{"jobUrl":"http://node-master:4040/jobs/job?id=939"},{"jobUrl":"http://node-master:4040/jobs/job?id=940"},{"jobUrl":"http://node-master:4040/jobs/job?id=941"},{"jobUrl":"http://node-master:4040/jobs/job?id=942"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774337500627_1427197243","id":"paragraph_1774337500627_1427197243","dateCreated":"2026-03-24T15:31:40+0800","dateStarted":"2026-03-25T09:31:31+0800","dateFinished":"2026-03-25T09:31:34+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Load all weather files\nusa1_df = spark.read.csv(\"hdfs:///user/data/weather/usa_1.csv\", header=True, inferSchema=True)\nusa2_df = spark.read.csv(\"hdfs:///user/data/weather/usa_2.csv\", header=True, inferSchema=True)\nall_weather = usa1_df.union(usa2_df)\n\n# Best station per city\nbest_stations = [\n    \"USW00013739\",  # Philadelphia\n    \"USW00012842\",  # Tampa\n    \"USW00093819\",  # Indianapolis\n    \"USW00013897\",  # Nashville\n    \"USW00023160\",  # Tucson\n    \"USW00012916\",  # New Orleans\n    \"USW00023185\",  # Reno\n    \"USW00053152\",  # Santa Barbara\n    \"USW00024131\",  # Boise\n    \"USW00003960\",  # St. Louis\n]\n\nweather_df = all_weather \\\n    .filter(F.col(\"STATION\").isin(best_stations)) \\\n    .withColumn(\"city\",\n        F.when(F.col(\"STATION\") == \"USW00013739\", \"Philadelphia\")\n         .when(F.col(\"STATION\") == \"USW00012842\", \"Tampa\")\n         .when(F.col(\"STATION\") == \"USW00093819\", \"Indianapolis\")\n         .when(F.col(\"STATION\") == \"USW00013897\", \"Nashville\")\n         .when(F.col(\"STATION\") == \"USW00023160\", \"Tucson\")\n         .when(F.col(\"STATION\") == \"USW00012916\", \"New Orleans\")\n         .when(F.col(\"STATION\") == \"USW00023185\", \"Reno\")\n         .when(F.col(\"STATION\") == \"USW00053152\", \"Santa Barbara\")\n         .when(F.col(\"STATION\") == \"USW00024131\", \"Boise\")\n         .when(F.col(\"STATION\") == \"USW00003960\", \"St. Louis\")\n    ) \\\n    .select(\n        F.col(\"STATION\").alias(\"station\"),\n        F.col(\"city\"),\n        F.col(\"NAME\").alias(\"station_name\"),\n        F.col(\"LATITUDE\").alias(\"latitude\"),\n        F.col(\"LONGITUDE\").alias(\"longitude\"),\n        F.col(\"DATE\").alias(\"date\"),\n        F.col(\"TMAX\").alias(\"temp_max\"),\n        F.col(\"TMIN\").alias(\"temp_min\"),\n        F.col(\"TAVG\").alias(\"temp_avg\"),\n        F.col(\"PRCP\").alias(\"precipitation\"),\n        F.col(\"SNOW\").alias(\"snowfall\"),\n        F.col(\"SNWD\").alias(\"snow_depth\"),\n        F.col(\"AWND\").alias(\"wind_speed\"),\n        F.col(\"WSF2\").alias(\"wind_gust\")\n    )\n\nprint(f\"Total rows: {weather_df.count()}\")\nprint(\"\\nCities loaded:\")\nweather_df.select(\"city\", \"station_name\").distinct().orderBy(\"city\").show(truncate=False)\n\n# Save as Hive table\nweather_df.write.mode(\"overwrite\").saveAsTable(\"weather\")\nprint(\"\\nWeather table saved!\")\n","user":"anonymous","dateUpdated":"2026-03-25T09:35:55+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total rows: 24096\n\nCities loaded:\n+-------------+-----------------------------------------+\n|city         |station_name                             |\n+-------------+-----------------------------------------+\n|Boise        |BOISE AIR TERMINAL, ID US                |\n|Indianapolis |INDIANAPOLIS INTERNATIONAL AIRPORT, IN US|\n|Nashville    |NASHVILLE INTERNATIONAL AIRPORT, TN US   |\n|New Orleans  |NEW ORLEANS AIRPORT, LA US               |\n|Philadelphia |PHILADELPHIA INTERNATIONAL AIRPORT, PA US|\n|Reno         |RENO AIRPORT, NV US                      |\n|Santa Barbara|SANTA BARBARA 11 W, CA US                |\n|St. Louis    |CAHOKIA ST LOUIS DOWNTOWN AIRPORT, IL US |\n|Tampa        |TAMPA INTERNATIONAL AIRPORT, FL US       |\n|Tucson       |TUCSON INTERNATIONAL AIRPORT, AZ US      |\n+-------------+-----------------------------------------+\n\n\nWeather table saved!\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=943"},{"jobUrl":"http://node-master:4040/jobs/job?id=944"},{"jobUrl":"http://node-master:4040/jobs/job?id=945"},{"jobUrl":"http://node-master:4040/jobs/job?id=946"},{"jobUrl":"http://node-master:4040/jobs/job?id=947"},{"jobUrl":"http://node-master:4040/jobs/job?id=948"},{"jobUrl":"http://node-master:4040/jobs/job?id=949"},{"jobUrl":"http://node-master:4040/jobs/job?id=950"},{"jobUrl":"http://node-master:4040/jobs/job?id=951"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402291607_1599338597","id":"paragraph_1774402291607_1599338597","dateCreated":"2026-03-25T09:31:31+0800","dateStarted":"2026-03-25T09:35:55+0800","dateFinished":"2026-03-25T09:36:02+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Standardize city names in business table for weather join\ncity_standardize = (\n    F.when(F.col(\"city\").isin(\"Saint Louis\"), \"St. Louis\")\n     .when(F.col(\"city\").isin(\"Saint Petersburg\"), \"St. Petersburg\")\n     .when(F.col(\"city\").isin(\"Clearwater\", \"Brandon\", \"Largo\",\n                               \"St. Petersburg\", \"Saint Petersburg\"), \"Tampa\")\n     .when(F.col(\"city\").isin(\"Metairie\"), \"New Orleans\")\n     .when(F.col(\"city\").isin(\"Sparks\"), \"Reno\")\n     .when(F.col(\"city\").isin(\"Franklin\"), \"Nashville\")\n     .when(F.col(\"city\").isin(\"Meridian\"), \"Boise\")\n     .otherwise(F.col(\"city\"))\n)\n\n# Test it\nspark.table(\"business\") \\\n    .withColumn(\"weather_city\", city_standardize) \\\n    .filter(F.col(\"weather_city\").isin(\n        \"Philadelphia\", \"Tampa\", \"Indianapolis\", \"Nashville\",\n        \"Tucson\", \"New Orleans\", \"St. Louis\", \"Reno\",\n        \"Santa Barbara\", \"Boise\"\n    )) \\\n    .groupBy(\"weather_city\") \\\n    .agg(F.count(\"*\").alias(\"business_count\")) \\\n    .orderBy(\"business_count\", ascending=False) \\\n    .show(truncate=False)\n","user":"anonymous","dateUpdated":"2026-03-25T09:36:41+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------------+--------------+\n|weather_city |business_count|\n+-------------+--------------+\n|Philadelphia |14569         |\n|Tampa        |14491         |\n|Tucson       |9250          |\n|Nashville    |8385          |\n|New Orleans  |7852          |\n|Reno         |7559          |\n|Indianapolis |7540          |\n|St. Louis    |6082          |\n|Boise        |3980          |\n|Santa Barbara|3829          |\n+-------------+--------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=952"},{"jobUrl":"http://node-master:4040/jobs/job?id=953"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402555605_252130631","id":"paragraph_1774402555605_252130631","dateCreated":"2026-03-25T09:35:55+0800","dateStarted":"2026-03-25T09:36:41+0800","dateFinished":"2026-03-25T09:36:42+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nweather_clean = spark.table(\"weather\") \\\n    .withColumn(\"temp_avg\",\n        F.when(F.col(\"temp_avg\").isNull(),\n               F.round((F.col(\"temp_max\") + F.col(\"temp_min\")) / 2, 1))\n         .otherwise(F.col(\"temp_avg\"))) \\\n    .withColumn(\"precipitation\",\n        F.when(F.col(\"precipitation\").isNull(), 0.0)\n         .otherwise(F.col(\"precipitation\"))) \\\n    .withColumn(\"snowfall\",\n        F.when(F.col(\"snowfall\").isNull(), 0.0)\n         .otherwise(F.col(\"snowfall\"))) \\\n    .withColumn(\"wind_speed\",\n        F.when(F.col(\"wind_speed\").isNull(), 0.0)\n         .otherwise(F.col(\"wind_speed\"))) \\\n    .withColumn(\"wind_gust\",\n        F.when(F.col(\"wind_gust\").isNull(), 0.0)\n         .otherwise(F.col(\"wind_gust\"))) \\\n    .withColumn(\"weather_condition\",\n        F.when(F.col(\"precipitation\") >= 25.0, \"Heavy Rain\")\n         .when(F.col(\"precipitation\") >= 10.0, \"Rain\")\n         .when(F.col(\"snowfall\") >= 5.0, \"Heavy Snow\")\n         .when(F.col(\"snowfall\") > 0.0, \"Snow\")\n         .when(F.col(\"temp_max\") >= 35.0, \"Extreme Heat\")\n         .when(F.col(\"temp_max\") <= 0.0, \"Extreme Cold\")\n         .when(F.col(\"wind_speed\") >= 10.0, \"Strong Wind\")\n         .otherwise(\"Normal\")\n    )\n\nweather_clean.write \\\n    .mode(\"overwrite\") \\\n    .saveAsTable(\"weather_clean\")\n\nprint(\"Weather clean table created!\")\nprint(\"\\nWeather conditions distribution:\")\nspark.sql(\"\"\"\n    SELECT weather_condition, COUNT(*) as days\n    FROM weather_clean\n    GROUP BY weather_condition\n    ORDER BY days DESC\n\"\"\").show()\n","user":"anonymous","dateUpdated":"2026-03-25T09:37:29+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Weather clean table created!\n\nWeather conditions distribution:\n+-----------------+-----+\n|weather_condition| days|\n+-----------------+-----+\n|           Normal|19701|\n|     Extreme Heat| 1788|\n|             Rain| 1200|\n|       Heavy Rain|  709|\n|     Extreme Cold|  331|\n|       Heavy Snow|  308|\n|             Snow|   45|\n|      Strong Wind|   14|\n+-----------------+-----+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=954"},{"jobUrl":"http://node-master:4040/jobs/job?id=955"},{"jobUrl":"http://node-master:4040/jobs/job?id=956"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402601403_567507324","id":"paragraph_1774402601403_567507324","dateCreated":"2026-03-25T09:36:41+0800","dateStarted":"2026-03-25T09:37:29+0800","dateFinished":"2026-03-25T09:37:30+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\nreview_df = spark.table(\"review\")\ncheckin_df = spark.table(\"checkin\")\nweather_df = spark.table(\"weather_clean\")\n\n# ============================================================\n# City standardization mapping\n# ============================================================\ncity_standardize = (\n    F.when(F.col(\"city\").isin(\"Saint Louis\"), \"St. Louis\")\n     .when(F.col(\"city\").isin(\"Saint Petersburg\", \"St. Petersburg\",\n                               \"Clearwater\", \"Brandon\", \"Largo\"), \"Tampa\")\n     .when(F.col(\"city\").isin(\"Metairie\"), \"New Orleans\")\n     .when(F.col(\"city\").isin(\"Sparks\"), \"Reno\")\n     .when(F.col(\"city\").isin(\"Franklin\"), \"Nashville\")\n     .when(F.col(\"city\").isin(\"Meridian\"), \"Boise\")\n     .otherwise(F.col(\"city\"))\n)\n\ntarget_weather_cities = [\n    \"Philadelphia\", \"Tampa\", \"Indianapolis\", \"Nashville\",\n    \"Tucson\", \"New Orleans\", \"St. Louis\", \"Reno\",\n    \"Santa Barbara\", \"Boise\"\n]\n\n# ============================================================\n# Prepare business table with standardized city\n# ============================================================\nbusiness_std = business_df \\\n    .withColumn(\"weather_city\", city_standardize) \\\n    .filter(F.col(\"weather_city\").isin(target_weather_cities)) \\\n    .filter(F.col(\"categories\").like(\"%Restaurants%\"))\n\n# ============================================================\n# Analysis 1: Average rating by weather condition\n# ============================================================\nprint(\"=== Analysis 1: Average Rating by Weather Condition ===\")\n\nreviews_weather = review_df \\\n    .filter(F.col(\"date\") >= \"2017-01-01\") \\\n    .withColumn(\"date_only\", F.to_date(F.col(\"date\"))) \\\n    .join(business_std.select(\"business_id\", \"weather_city\"), \"business_id\") \\\n    .join(weather_df,\n          (F.col(\"weather_city\") == weather_df.city) &\n          (F.col(\"date_only\") == weather_df.date))\n\nanalysis1 = reviews_weather \\\n    .groupBy(\"weather_condition\") \\\n    .agg(\n        F.count(\"*\").alias(\"total_reviews\"),\n        F.round(F.avg(\"stars\"), 3).alias(\"avg_rating\"),\n        F.sum(F.when(F.col(\"stars\") == 1, 1).otherwise(0))\n         .alias(\"one_star_count\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 1, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"one_star_pct\"),\n        F.sum(F.when(F.col(\"stars\") == 5, 1).otherwise(0))\n         .alias(\"five_star_count\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 5, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"five_star_pct\")\n    ) \\\n    .orderBy(\"avg_rating\")\n\nprint(\"Do bad weather conditions cause lower ratings?\")\nanalysis1.show(truncate=False)\nz.show(analysis1)\n","user":"anonymous","dateUpdated":"2026-03-25T09:40:17+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Analysis 1: Average Rating by Weather Condition ===\nDo bad weather conditions cause lower ratings?\n+-----------------+-------------+----------+--------------+------------+---------------+-------------+\n|weather_condition|total_reviews|avg_rating|one_star_count|one_star_pct|five_star_count|five_star_pct|\n+-----------------+-------------+----------+--------------+------------+---------------+-------------+\n|Strong Wind      |1635         |3.815     |216           |13.21       |772            |47.22        |\n|Extreme Heat     |124229       |3.836     |17428         |14.03       |62955          |50.68        |\n|Snow             |2299         |3.865     |286           |12.44       |1138           |49.5         |\n|Heavy Snow       |18878        |3.872     |2409          |12.76       |9387           |49.72        |\n|Extreme Cold     |19654        |3.891     |2307          |11.74       |9644           |49.07        |\n|Normal           |1675965      |3.897     |209666        |12.51       |860611         |51.35        |\n|Rain             |122885       |3.907     |15027         |12.23       |63170          |51.41        |\n|Heavy Rain       |74675        |3.918     |8954          |11.99       |38624          |51.72        |\n+-----------------+-------------+----------+--------------+------------+---------------+-------------+\n\n"},{"type":"TABLE","data":"weather_condition\ttotal_reviews\tavg_rating\tone_star_count\tone_star_pct\tfive_star_count\tfive_star_pct\nStrong Wind\t1635\t3.815\t216\t13.21\t772\t47.22\nExtreme Heat\t124229\t3.836\t17428\t14.03\t62955\t50.68\nSnow\t2299\t3.865\t286\t12.44\t1138\t49.5\nHeavy Snow\t18878\t3.872\t2409\t12.76\t9387\t49.72\nExtreme Cold\t19654\t3.891\t2307\t11.74\t9644\t49.07\nNormal\t1675965\t3.897\t209666\t12.51\t860611\t51.35\nRain\t122885\t3.907\t15027\t12.23\t63170\t51.41\nHeavy Rain\t74675\t3.918\t8954\t11.99\t38624\t51.72\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=957"},{"jobUrl":"http://node-master:4040/jobs/job?id=958"},{"jobUrl":"http://node-master:4040/jobs/job?id=959"},{"jobUrl":"http://node-master:4040/jobs/job?id=960"},{"jobUrl":"http://node-master:4040/jobs/job?id=961"},{"jobUrl":"http://node-master:4040/jobs/job?id=962"},{"jobUrl":"http://node-master:4040/jobs/job?id=963"},{"jobUrl":"http://node-master:4040/jobs/job?id=964"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402649169_535050343","id":"paragraph_1774402649169_535050343","dateCreated":"2026-03-25T09:37:29+0800","dateStarted":"2026-03-25T09:40:17+0800","dateFinished":"2026-03-25T09:40:28+0800","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# ============================================================\n# Analysis 2: Check-in volume by weather condition\n# ============================================================\nprint(\"=== Analysis 2: Check-in Volume by Weather Condition ===\")\n\ncheckin_exploded = checkin_df \\\n    .select(\n        \"business_id\",\n        F.explode(F.split(F.col(\"date\"), \", \")).alias(\"checkin_datetime\")\n    ) \\\n    .withColumn(\"checkin_date\", F.to_date(F.col(\"checkin_datetime\"))) \\\n    .filter(F.col(\"checkin_date\") >= \"2017-01-01\")\n\ncheckins_weather = checkin_exploded \\\n    .join(business_std.select(\"business_id\", \"weather_city\"), \"business_id\") \\\n    .join(weather_df,\n          (F.col(\"weather_city\") == weather_df.city) &\n          (F.col(\"checkin_date\") == weather_df.date))\n\nanalysis2 = checkins_weather \\\n    .groupBy(\"weather_condition\") \\\n    .agg(\n        F.count(\"*\").alias(\"total_checkins\"),\n        F.countDistinct(\"business_id\").alias(\"unique_restaurants\"),\n        F.round(F.count(\"*\") / F.countDistinct(\"date\"), 1)\n         .alias(\"avg_checkins_per_day\")\n    ) \\\n    .orderBy(\"total_checkins\", ascending=False)\n\nprint(\"Does extreme weather increase or decrease foot traffic?\")\nanalysis2.show(truncate=False)\nz.show(analysis2)\n","user":"anonymous","dateUpdated":"2026-03-25T09:40:53+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Analysis 2: Check-in Volume by Weather Condition ===\nDoes extreme weather increase or decrease foot traffic?\n+-----------------+--------------+------------------+--------------------+\n|weather_condition|total_checkins|unique_restaurants|avg_checkins_per_day|\n+-----------------+--------------+------------------+--------------------+\n|Normal           |2111929       |21913             |1144.7              |\n|Rain             |146875        |14578             |212.2               |\n|Extreme Heat     |139867        |11867             |199.2               |\n|Heavy Rain       |88286         |11780             |212.2               |\n|Extreme Cold     |24545         |5841              |148.8               |\n|Heavy Snow       |21975         |5248              |103.7               |\n|Snow             |2591          |1580              |70.0                |\n|Strong Wind      |1890          |1178              |145.4               |\n+-----------------+--------------+------------------+--------------------+\n\n"},{"type":"TABLE","data":"weather_condition\ttotal_checkins\tunique_restaurants\tavg_checkins_per_day\nNormal\t2111929\t21913\t1144.7\nRain\t146875\t14578\t212.2\nExtreme Heat\t139867\t11867\t199.2\nHeavy Rain\t88286\t11780\t212.2\nExtreme Cold\t24545\t5841\t148.8\nHeavy Snow\t21975\t5248\t103.7\nSnow\t2591\t1580\t70.0\nStrong Wind\t1890\t1178\t145.4\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=965"},{"jobUrl":"http://node-master:4040/jobs/job?id=966"},{"jobUrl":"http://node-master:4040/jobs/job?id=967"},{"jobUrl":"http://node-master:4040/jobs/job?id=968"},{"jobUrl":"http://node-master:4040/jobs/job?id=969"},{"jobUrl":"http://node-master:4040/jobs/job?id=970"},{"jobUrl":"http://node-master:4040/jobs/job?id=971"},{"jobUrl":"http://node-master:4040/jobs/job?id=972"},{"jobUrl":"http://node-master:4040/jobs/job?id=973"},{"jobUrl":"http://node-master:4040/jobs/job?id=974"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402817358_861447614","id":"paragraph_1774402817358_861447614","dateCreated":"2026-03-25T09:40:17+0800","dateStarted":"2026-03-25T09:40:53+0800","dateFinished":"2026-03-25T09:41:06+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\ncheckin_df = spark.table(\"checkin\")\nweather_df = spark.table(\"weather_clean\")\n\n# City standardization\ncity_standardize = (\n    F.when(F.col(\"city\").isin(\"Saint Louis\"), \"St. Louis\")\n     .when(F.col(\"city\").isin(\"Saint Petersburg\", \"St. Petersburg\",\n                               \"Clearwater\", \"Brandon\", \"Largo\"), \"Tampa\")\n     .when(F.col(\"city\").isin(\"Metairie\"), \"New Orleans\")\n     .when(F.col(\"city\").isin(\"Sparks\"), \"Reno\")\n     .when(F.col(\"city\").isin(\"Franklin\"), \"Nashville\")\n     .when(F.col(\"city\").isin(\"Meridian\"), \"Boise\")\n     .otherwise(F.col(\"city\"))\n)\n\ntarget_cities = [\"Philadelphia\", \"Tampa\", \"Indianapolis\", \"Nashville\",\n                 \"Tucson\", \"New Orleans\", \"St. Louis\", \"Reno\",\n                 \"Santa Barbara\", \"Boise\"]\n\n# Explode checkin dates\ncheckin_exploded = checkin_df \\\n    .select(\n        \"business_id\",\n        F.explode(F.split(F.col(\"date\"), \", \")).alias(\"checkin_datetime\")\n    ) \\\n    .withColumn(\"checkin_date\", F.to_date(F.col(\"checkin_datetime\"))) \\\n    .filter(F.col(\"checkin_date\") >= \"2017-01-01\")\n\n# Join with business to get city and categories\ncheckins_with_city = checkin_exploded \\\n    .join(business_df.select(\"business_id\", \"city\", \"categories\"), \"business_id\") \\\n    .withColumn(\"weather_city\", city_standardize) \\\n    .filter(F.col(\"weather_city\").isin(target_cities))\n\n# Analysis 3: Food categories on extreme weather days\nprint(\"=== Analysis 3: Food Category Check-ins on Extreme Weather ===\")\nanalysis3 = checkins_with_city \\\n    .join(weather_df,\n          (checkins_with_city.weather_city == weather_df.city) &\n          (checkins_with_city.checkin_date == weather_df.date)) \\\n    .filter(F.col(\"weather_condition\").isin(\n        \"Heavy Rain\", \"Rain\", \"Extreme Cold\", \"Heavy Snow\", \"Extreme Heat\"\n    )) \\\n    .filter(F.col(\"categories\").isNotNull()) \\\n    .withColumn(\"food_type\",\n        F.when(F.col(\"categories\").contains(\"Soup\"), \"Soup\")\n         .when(F.col(\"categories\").contains(\"Hot Pot\"), \"Hot Pot\")\n         .when(F.col(\"categories\").contains(\"Pizza\"), \"Pizza\")\n         .when(F.col(\"categories\").contains(\"Burgers\"), \"Burgers\")\n         .when(F.col(\"categories\").contains(\"Chinese\"), \"Chinese\")\n         .when(F.col(\"categories\").contains(\"Fast Food\"), \"Fast Food\")\n         .when(F.col(\"categories\").contains(\"Coffee\"), \"Coffee\")\n         .when(F.col(\"categories\").contains(\"Ice Cream\"), \"Ice Cream\")\n         .when(F.col(\"categories\").contains(\"Sandwiches\"), \"Sandwiches\")\n         .otherwise(\"Other\")\n    ) \\\n    .filter(\"food_type != 'Other'\") \\\n    .groupBy(\"food_type\", \"weather_condition\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\")) \\\n    .orderBy(\"weather_condition\", \"checkin_count\", ascending=False)\n\nanalysis3.show(50, truncate=False)\nz.show(analysis3)\n","user":"anonymous","dateUpdated":"2026-03-25T09:52:09+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"food_type","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"weather_condition","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Analysis 3: Food Category Check-ins on Extreme Weather ===\n+----------+-----------------+-------------+\n|food_type |weather_condition|checkin_count|\n+----------+-----------------+-------------+\n|Coffee    |Rain             |20290        |\n|Burgers   |Rain             |12367        |\n|Sandwiches|Rain             |11684        |\n|Pizza     |Rain             |10472        |\n|Chinese   |Rain             |5325         |\n|Fast Food |Rain             |3808         |\n|Soup      |Rain             |3505         |\n|Ice Cream |Rain             |3382         |\n|Hot Pot   |Rain             |768          |\n|Coffee    |Heavy Snow       |3066         |\n|Burgers   |Heavy Snow       |1935         |\n|Pizza     |Heavy Snow       |1868         |\n|Chinese   |Heavy Snow       |1256         |\n|Sandwiches|Heavy Snow       |1249         |\n|Soup      |Heavy Snow       |721          |\n|Fast Food |Heavy Snow       |637          |\n|Ice Cream |Heavy Snow       |267          |\n|Hot Pot   |Heavy Snow       |184          |\n|Coffee    |Heavy Rain       |12135        |\n|Burgers   |Heavy Rain       |7468         |\n|Sandwiches|Heavy Rain       |7152         |\n|Pizza     |Heavy Rain       |5884         |\n|Chinese   |Heavy Rain       |2662         |\n|Fast Food |Heavy Rain       |2158         |\n|Soup      |Heavy Rain       |2127         |\n|Ice Cream |Heavy Rain       |1915         |\n|Hot Pot   |Heavy Rain       |353          |\n|Coffee    |Extreme Heat     |19027        |\n|Burgers   |Extreme Heat     |13300        |\n|Pizza     |Extreme Heat     |11436        |\n|Sandwiches|Extreme Heat     |9835         |\n|Chinese   |Extreme Heat     |4899         |\n|Fast Food |Extreme Heat     |4751         |\n|Soup      |Extreme Heat     |4026         |\n|Ice Cream |Extreme Heat     |3565         |\n|Hot Pot   |Extreme Heat     |184          |\n|Coffee    |Extreme Cold     |3257         |\n|Pizza     |Extreme Cold     |2189         |\n|Burgers   |Extreme Cold     |1998         |\n|Sandwiches|Extreme Cold     |1654         |\n|Chinese   |Extreme Cold     |1225         |\n|Soup      |Extreme Cold     |744          |\n|Fast Food |Extreme Cold     |651          |\n|Ice Cream |Extreme Cold     |430          |\n|Hot Pot   |Extreme Cold     |182          |\n+----------+-----------------+-------------+\n\n"},{"type":"TABLE","data":"food_type\tweather_condition\tcheckin_count\nCoffee\tRain\t20290\nBurgers\tRain\t12367\nSandwiches\tRain\t11684\nPizza\tRain\t10472\nChinese\tRain\t5325\nFast Food\tRain\t3808\nSoup\tRain\t3505\nIce Cream\tRain\t3382\nHot Pot\tRain\t768\nCoffee\tHeavy Snow\t3066\nBurgers\tHeavy Snow\t1935\nPizza\tHeavy Snow\t1868\nChinese\tHeavy Snow\t1256\nSandwiches\tHeavy Snow\t1249\nSoup\tHeavy Snow\t721\nFast Food\tHeavy Snow\t637\nIce Cream\tHeavy Snow\t267\nHot Pot\tHeavy Snow\t184\nCoffee\tHeavy Rain\t12135\nBurgers\tHeavy Rain\t7468\nSandwiches\tHeavy Rain\t7152\nPizza\tHeavy Rain\t5884\nChinese\tHeavy Rain\t2662\nFast Food\tHeavy Rain\t2158\nSoup\tHeavy Rain\t2127\nIce Cream\tHeavy Rain\t1915\nHot Pot\tHeavy Rain\t353\nCoffee\tExtreme Heat\t19027\nBurgers\tExtreme Heat\t13300\nPizza\tExtreme Heat\t11436\nSandwiches\tExtreme Heat\t9835\nChinese\tExtreme Heat\t4899\nFast Food\tExtreme Heat\t4751\nSoup\tExtreme Heat\t4026\nIce Cream\tExtreme Heat\t3565\nHot Pot\tExtreme Heat\t184\nCoffee\tExtreme Cold\t3257\nPizza\tExtreme Cold\t2189\nBurgers\tExtreme Cold\t1998\nSandwiches\tExtreme Cold\t1654\nChinese\tExtreme Cold\t1225\nSoup\tExtreme Cold\t744\nFast Food\tExtreme Cold\t651\nIce Cream\tExtreme Cold\t430\nHot Pot\tExtreme Cold\t182\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=975"},{"jobUrl":"http://node-master:4040/jobs/job?id=976"},{"jobUrl":"http://node-master:4040/jobs/job?id=977"},{"jobUrl":"http://node-master:4040/jobs/job?id=978"},{"jobUrl":"http://node-master:4040/jobs/job?id=979"},{"jobUrl":"http://node-master:4040/jobs/job?id=980"},{"jobUrl":"http://node-master:4040/jobs/job?id=981"},{"jobUrl":"http://node-master:4040/jobs/job?id=982"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774402906939_2033404455","id":"paragraph_1774402906939_2033404455","dateCreated":"2026-03-25T09:41:46+0800","dateStarted":"2026-03-25T09:42:52+0800","dateFinished":"2026-03-25T09:43:00+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\nreview_df = spark.table(\"review\")\ncheckin_df = spark.table(\"checkin\")\nweather_df = spark.table(\"weather_clean\")\n\n# City standardization\ncity_standardize = (\n    F.when(F.col(\"city\").isin(\"Saint Louis\"), \"St. Louis\")\n     .when(F.col(\"city\").isin(\"Saint Petersburg\", \"St. Petersburg\",\n                               \"Clearwater\", \"Brandon\", \"Largo\"), \"Tampa\")\n     .when(F.col(\"city\").isin(\"Metairie\"), \"New Orleans\")\n     .when(F.col(\"city\").isin(\"Sparks\"), \"Reno\")\n     .when(F.col(\"city\").isin(\"Franklin\"), \"Nashville\")\n     .when(F.col(\"city\").isin(\"Meridian\"), \"Boise\")\n     .otherwise(F.col(\"city\"))\n)\n\ntarget_cities = [\"Philadelphia\", \"Tampa\", \"Indianapolis\", \"Nashville\",\n                 \"Tucson\", \"New Orleans\", \"St. Louis\", \"Reno\",\n                 \"Santa Barbara\", \"Boise\"]\n\n# ============================================================\n# Analysis 4: Average Rating by Weather Condition per City\n# ============================================================\nprint(\"=== Analysis 4: Average Rating by Weather Condition per City ===\")\n\nreviews_with_city = review_df \\\n    .filter(F.col(\"date\") >= \"2017-01-01\") \\\n    .withColumn(\"date_only\", F.to_date(F.col(\"date\"))) \\\n    .join(business_df.select(\"business_id\", \"city\"), \"business_id\") \\\n    .withColumn(\"weather_city\", city_standardize) \\\n    .filter(F.col(\"weather_city\").isin(target_cities))\n\nanalysis4 = reviews_with_city \\\n    .join(weather_df,\n          (reviews_with_city.weather_city == weather_df.city) &\n          (reviews_with_city.date_only == weather_df.date)) \\\n    .groupBy(\"weather_city\", \"weather_condition\") \\\n    .agg(\n        F.count(\"*\").alias(\"total_reviews\"),\n        F.round(F.avg(\"stars\"), 3).alias(\"avg_rating\"),\n        F.sum(F.when(F.col(\"stars\") == 1, 1).otherwise(0))\n         .alias(\"one_star_count\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 1, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"one_star_pct\"),\n        F.sum(F.when(F.col(\"stars\") == 5, 1).otherwise(0))\n         .alias(\"five_star_count\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 5, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"five_star_pct\")\n    ) \\\n    .orderBy(\"weather_city\", \"avg_rating\")\n\nprint(\"\\nRating by Weather Condition per City:\")\nanalysis4.show(80, truncate=False)\nz.show(analysis4)\n\n# ============================================================\n# Analysis 4b: Overall Weather Impact Summary\n# ============================================================\nprint(\"\\n=== Analysis 4b: Overall Weather Impact Summary ===\")\n\nanalysis4b = reviews_with_city \\\n    .join(weather_df,\n          (reviews_with_city.weather_city == weather_df.city) &\n          (reviews_with_city.date_only == weather_df.date)) \\\n    .groupBy(\"weather_condition\") \\\n    .agg(\n        F.count(\"*\").alias(\"total_reviews\"),\n        F.round(F.avg(\"stars\"), 3).alias(\"avg_rating\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 1, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"one_star_pct\"),\n        F.round(\n            F.sum(F.when(F.col(\"stars\") == 5, 1).otherwise(0)) /\n            F.count(\"*\") * 100, 2\n        ).alias(\"five_star_pct\")\n    ) \\\n    .orderBy(\"avg_rating\")\n\nanalysis4b.show(truncate=False)\nz.show(analysis4b)\n\n# ============================================================\n# Analysis 4c: Actionable Business Recommendations\n# ============================================================\nprint(\"\\n=== Analysis 4c: Business Recommendations ===\")\n\nrecommendations = spark.createDataFrame([\n    (\"Heavy Rain\",\n     \"Increase delivery staff\",\n     \"Promote soups, hot food, comfort meals\",\n     \"High — bad weather frustrates customers\"),\n    (\"Extreme Heat\",\n     \"Add outdoor cooling, extra AC staff\",\n     \"Promote cold drinks, ice cream, salads\",\n     \"Medium — heat reduces walk-ins\"),\n    (\"Extreme Cold\",\n     \"Reduce outdoor seating staff\",\n     \"Promote hot beverages, soups, stews\",\n     \"High — cold drives indoor dining\"),\n    (\"Heavy Snow\",\n     \"Reduce floor staff, increase delivery\",\n     \"Focus on delivery-friendly menu items\",\n     \"Very High — snow drastically cuts foot traffic\"),\n    (\"Snow\",\n     \"Moderate staffing reduction\",\n     \"Promote warm comfort food\",\n     \"Medium — light snow still affects walk-ins\"),\n    (\"Strong Wind\",\n     \"Close outdoor seating entirely\",\n     \"No special promotions needed\",\n     \"Low — mainly affects outdoor seating\"),\n    (\"Normal\",\n     \"Standard staffing levels\",\n     \"Standard menu\",\n     \"None — baseline conditions\")\n], [\"Weather Condition\", \"Staffing Recommendation\",\n    \"Inventory/Menu Recommendation\", \"Review Risk\"])\n\nrecommendations.show(truncate=False)\nz.show(recommendations)","user":"anonymous","dateUpdated":"2026-03-25T09:45:34+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Analysis 4: Average Rating by Weather Condition per City ===\n\nRating by Weather Condition per City:\n+-------------+-----------------+-------------+----------+--------------+------------+---------------+-------------+\n|weather_city |weather_condition|total_reviews|avg_rating|one_star_count|one_star_pct|five_star_count|five_star_pct|\n+-------------+-----------------+-------------+----------+--------------+------------+---------------+-------------+\n|Boise        |Heavy Rain       |114          |3.649     |22            |19.3        |58             |50.88        |\n|Boise        |Snow             |885          |3.713     |162           |18.31       |449            |50.73        |\n|Boise        |Extreme Heat     |10808        |3.731     |2024          |18.73       |5648           |52.26        |\n|Boise        |Heavy Snow       |4117         |3.756   