r, regexp_replace, explode, split, udf\nfrom pyspark.sql.types import BooleanType\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\"see\",\n    \"look\",\"say\",\"use\",\"much\",\"well\",\"always\",\"every\",\"sure\",\"thing\",\"were\",\n    \"only\",\"other\",\"another\",\"went\",\"come\",\"here\",\"this\",\"that\",\"these\",\n    \"those\",\"with\",\"from\",\"have\",\"been\",\"will\",\"just\",\"they\",\"what\",\"when\",\n    \"could\",\"would\",\"should\",\"really\",\"never\",\"always\",\"every\",\"little\"\n}\nstop_bc = sc.broadcast(stop_words)\n\nis_valid = udf(lambda w: bool(w and len(w) > 3 and w not in stop_bc.value), BooleanType())\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.select(\n    explode(\n        split(regexp_replace(lower(col(\"rev_text\")), \"[^a-z\\\\s]\", \"\"), \"\\\\s+\")\n    ).alias(\"word\")\n).filter(col(\"word\") != \"\") \\\n .filter(is_valid(col(\"word\"))) \\\n .groupBy(\"word\").count() \\\n .withColumnRenamed(\"word\", \"Word\") \\\n .withColumnRenamed(\"count\", \"Frequency\") \\\n .orderBy(col(\"Frequency\").desc()) \\\n .limit(20)\n\nprint(\"=== Top 20 Most Common Words ===\")\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T04:02:07-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Most Common Words ===\n"},{"type":"TABLE","data":"Word\tFrequency\nfood\t3595656\ngood\t3277585\nplace\t3153865\ngreat\t3055940\nservice\t2296961\nnice\t1215974\nbest\t1210991\ndont\t1210343\nordered\t1151679\nstaff\t1129668\norder\t1123286\nlove\t1027506\ndidnt\t1023906\nfriendly\t1018283\ndelicious\t1013027\nfirst\t1002603\nrestaurant\t999428\nchicken\t960585\ndefinitely\t945309\nexperience\t896036\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=16"},{"jobUrl":"http://node-master:4040/jobs/job?id=17"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774278107023_646621730","id":"paragraph_1774278107023_646621730","dateCreated":"2026-03-23T11:01:47-0400","dateStarted":"2026-03-24T04:02:07-0400","dateFinished":"2026-03-24T04:11:43-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, udf, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\"see\",\n    \"look\",\"say\",\"use\",\"much\",\"well\",\"always\",\"every\",\"sure\",\"thing\",\"were\",\n    \"only\",\"other\",\"another\",\"restaurant\",\"menu\",\"meal\",\"dinner\",\"lunch\"\n}\nstop_bc = sc.broadcast(stop_words)\n\n@udf(returnType=ArrayType(StringType()))\ndef extract_positive_bigrams(text):\n    if not text:\n        return []\n    import nltk\n    tokens = [w.strip(\".,!?\\\"'()[]:-\") for w in text.lower().split()]\n    tokens = [w for w in tokens if w.isalpha() and len(w) > 3\n              and w not in stop_bc.value]\n    tagged = nltk.pos_tag(tokens)\n    allowed = {\"JJ\",\"JJR\",\"JJS\",\"NN\",\"NNS\",\"RB\",\"RBR\"}\n    filtered = [w for w, t in tagged if t in allowed]\n    # Sort each bigram to eliminate reversals like \"food good\" vs \"good food\"\n    return [\" \".join(sorted([filtered[i], filtered[i+1]])) \n            for i in range(len(filtered)-1)]\n\ndf = spark.table(\"yelp.review\")\nsampled = df.filter(col(\"rev_stars\") > 3).sample(0.02, seed=42)\n\nresult = sampled.withColumn(\"bigrams\", extract_positive_bigrams(col(\"rev_text\"))) \\\n    .select(explode(col(\"bigrams\")).alias(\"Bigram\")) \\\n    .groupBy(\"Bigram\").count() \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(10)\n\nprint(\"=== Top 10 Bigrams from Positive Reviews (NLTK + POS) ===\")\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-24T02:27:37-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Hive Session ID = d6b0e071-9e00-419a-b0ff-3163207baad0\n=== Top 10 Bigrams from Positive Reviews (NLTK + POS) ===\n"},{"type":"TABLE","data":"Bigram\tFrequency\nfood great\t5760\ngreat service\t5357\nfood good\t4947\nfriendly staff\t4764\ngreat place\t4492\ncustomer service\t2595\ngood service\t2553\nfood service\t2490\ndelicious food\t2429\nhighly recommend\t2023\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=0"},{"jobUrl":"http://node-master:4040/jobs/job?id=1"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774278864343_222196270","id":"paragraph_1774278864343_222196270","dateCreated":"2026-03-23T11:14:24-0400","dateStarted":"2026-03-24T02:27:37-0400","dateFinished":"2026-03-24T02:34:36-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, udf, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\"see\",\n    \"look\",\"say\",\"use\",\"much\",\"well\",\"always\",\"every\",\"sure\",\"thing\",\"were\",\n    \"only\",\"other\",\"another\",\"menu\",\"meal\",\"dinner\",\"lunch\",\n    \"good\",\"great\",\"nice\",\"best\",\"love\",\"pretty\",\"friendly\",\"amazing\"\n}\n\n# Negative seed words — bigram must contain at least one\nnegative_seeds = {\n    \"slow\",\"rude\",\"cold\",\"dirty\",\"awful\",\"terrible\",\"horrible\",\"worst\",\n    \"waste\",\"poor\",\"bad\",\"long\",\"wait\",\"loud\",\"bland\",\"stale\",\"burnt\",\n    \"wrong\",\"late\",\"disgusting\",\"disappointing\",\"overpriced\",\"mediocre\",\n    \"unfriendly\",\"unhelpful\",\"unprofessional\",\"disgusting\",\"tasteless\",\n    \"soggy\",\"greasy\",\"undercooked\",\"overcooked\",\"inedible\",\"salty\",\n    \"expensive\",\"cheap\",\"nasty\",\"gross\",\"shocking\",\"unacceptable\"\n}\n\nstop_bc = sc.broadcast(stop_words)\nseeds_bc = sc.broadcast(negative_seeds)\n\n@udf(returnType=ArrayType(StringType()))\ndef extract_negative_bigrams(text):\n    if not text:\n        return []\n    import nltk\n    tokens = [w.strip(\".,!?\\\"'()[]:-\") for w in text.lower().split()]\n    tokens = [w for w in tokens if w.isalpha() and len(w) > 2\n              and w not in stop_bc.value]\n    tagged = nltk.pos_tag(tokens)\n    allowed = {\"JJ\",\"JJR\",\"JJS\",\"NN\",\"NNS\",\"RB\",\"RBR\"}\n    filtered = [w for w, t in tagged if t in allowed]\n\n    bigrams = []\n    seen = set()\n    for i in range(len(filtered)-1):\n        w1, w2 = filtered[i], filtered[i+1]\n        if w1 == w2:\n            continue\n        # At least one word must be a negative seed word\n        if w1 not in seeds_bc.value and w2 not in seeds_bc.value:\n            continue\n        key = tuple(sorted([w1, w2]))\n        if key not in seen:\n            seen.add(key)\n            bigrams.append(w1 + \" \" + w2)\n    return bigrams\n\ndf = spark.table(\"yelp.review\")\nsampled = df.filter(col(\"rev_stars\") <= 2).sample(0.05, seed=42)\n\nresult = sampled.withColumn(\"bigrams\", extract_negative_bigrams(col(\"rev_text\"))) \\\n    .select(explode(col(\"bigrams\")).alias(\"Bigram\")) \\\n    .groupBy(\"Bigram\").count() \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(10)\n\nprint(\"=== Top 10 Negative Bigrams (Seed Filtered) ===\")\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-24T03:10:17-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 10 Negative Bigrams (Seed Filtered) ===\n"},{"type":"TABLE","data":"Bigram\tFrequency\nwaste money\t1000\nterrible service\t789\npoor service\t764\nworst experience\t751\nhorrible service\t731\nservice terrible\t720\nbad experience\t708\ntoo bad\t694\nwait staff\t658\nbad service\t614\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=10"},{"jobUrl":"http://node-master:4040/jobs/job?id=11"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774279470062_1174373559","id":"paragraph_1774279470062_1174373559","dateCreated":"2026-03-23T11:24:30-0400","dateStarted":"2026-03-24T03:10:17-0400","dateFinished":"2026-03-24T03:12:36-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, udf, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\"see\",\n    \"look\",\"say\",\"use\",\"much\",\"well\",\"always\",\"every\",\"sure\",\"thing\",\"were\",\n    \"only\",\"other\",\"another\",\"good\",\"great\",\"place\",\"food\",\"service\",\"like\",\n    \"back\",\"people\",\"things\",\"stuff\",\"little\",\"never\",\"every\",\"definitely\"\n}\nstop_bc = sc.broadcast(stop_words)\n\n@udf(returnType=ArrayType(StringType()))\ndef extract_nouns_adjectives(text):\n    if not text:\n        return []\n    import nltk\n    tokens = [w.strip(\".,!?\\\"'()[]:-\") for w in text.lower().split()]\n    tokens = [w for w in tokens if w.isalpha() and len(w) > 3\n              and w not in stop_bc.value]\n    tagged = nltk.pos_tag(tokens)\n    allowed = {\"NN\",\"NNS\",\"NNP\",\"NNPS\",\"JJ\",\"JJR\",\"JJS\"}\n    return [w for w, t in tagged if t in allowed]\n\ndf = spark.table(\"yelp.review\")\nsampled = df.sample(0.02, seed=42)\n\nword_df = sampled.withColumn(\"words\", extract_nouns_adjectives(col(\"rev_text\"))) \\\n    .select(explode(col(\"words\")).alias(\"Word\")) \\\n    .groupBy(\"Word\").count() \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(100)\n\nprint(\"=== Word Cloud - Nouns & Adjectives Only (POS Tagged) ===\")\nz.show(word_df)\n\n# Build HTML word cloud\nwords = word_df.collect()\nmax_freq = words[0][\"Frequency\"]\n\nhtml = \"<div style='width:100%;padding:20px;font-family:Arial;line-height:2.5;text-align:center;background:white'>\"\nfor row in words:\n    size = int(12 + (row[\"Frequency\"] / max_freq) * 50)\n    colors = [\"#e74c3c\",\"#3498db\",\"#2ecc71\",\"#f39c12\",\"#9b59b6\",\"#1abc9c\",\"#e67e22\"]\n    color = colors[hash(row[\"Word\"]) % len(colors)]\n    html += \"<span style='font-size:{}px;color:{};margin:8px;display:inline-block'>{}</span>\".format(size, color, row[\"Word\"])\nhtml += \"</div>\"\n\nz.angularBind(\"wordcloud_html\", html)\nprint(z.angular(\"<div ng-bind-html='wordcloud_html'></div>\"))","user":"anonymous","dateUpdated":"2026-03-24T03:33:31-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Word Cloud - Nouns & Adjectives Only (POS Tagged) ===\n"},{"type":"TABLE","data":"Word\tFrequency\nstaff\t22579\nnice\t22530\norder\t22274\ndelicious\t20090\nbest\t19926\nrestaurant\t18559\nexperience\t17104\nchicken\t14610\nmenu\t14207\neverything\t13483\narea\t13009\nnight\t12988\nfresh\t12892\ncheese\t12643\nminutes\t12588\nfriendly\t11957\ntable\t11824\nwait\t11381\npizza\t11340\ntimes\t11267\nmany\t11009\nsmall\t10803\nlocation\t10798\nlunch\t10435\nroom\t10385\nsomething\t10255\nlast\t10157\nprice\t10128\nsalad\t9958\ncustomer\t9838\nwork\t9644\nmeal\t9587\ndrinks\t9561\nexcellent\t9440\ndinner\t9429\nhappy\t9341\nnext\t9327\nhome\t9149\nsauce\t8958\nlove\t8874\nyears\t8690\nbeer\t8653\nfavorite\t8571\nclean\t8567\ndifferent\t8529\nside\t8363\nfirst\t8345\ncoffee\t8323\nsandwich\t8198\nprices\t8165\nfries\t8126\nright\t8025\nsuper\t7960\nhour\t7951\nworth\t7920\nnothing\t7797\nawesome\t7785\nquality\t7718\nsame\t7670\nvisit\t7590\nsweet\t7217\nfamily\t7215\nstars\t7128\nspot\t7106\nstore\t7095\nbreakfast\t7045\nfull\t7014\nspecial\t7008\nplaces\t6943\nbusiness\t6932\neveryone\t6894\nflavor\t6893\nanything\t6845\nburger\t6767\nkind\t6757\nselection\t6709\nlarge\t6698\nmanager\t6694\nperfect\t6688\ntaste\t6673\noverall\t6616\nfree\t6414\nshrimp\t6340\nmeat\t6328\ntasty\t6316\nrecommend\t6211\noptions\t6175\nbread\t6125\nhuge\t6095\nwonderful\t6030\nbusy\t6024\nline\t6013\nfriends\t6004\nhouse\t5937\namazing\t5901\nmoney\t5859\ncare\t5856\nsuch\t5854\nitems\t5742\nopen\t5699\n"},{"type":"TEXT","data":"\nNone\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=12"},{"jobUrl":"http://node-master:4040/jobs/job?id=13"},{"jobUrl":"http://node-master:4040/jobs/job?id=14"},{"jobUrl":"http://node-master:4040/jobs/job?id=15"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315202887_2146047721","id":"paragraph_1774315202887_2146047721","dateCreated":"2026-03-23T21:20:02-0400","dateStarted":"2026-03-24T03:33:31-0400","dateFinished":"2026-03-24T03:38:41-0400","status":"FINISHED"},{"text":"%pyspark\nimport itertools\nfrom pyspark.sql.functions import udf, col, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"were\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\n    \"that\",\"this\",\"with\",\"been\",\"will\",\"just\",\"they\",\"what\",\"when\",\"could\",\n    \"would\",\"should\",\"really\",\"never\",\"always\",\"every\",\"little\",\"dont\",\n    \"food\",\"good\",\"great\",\"nice\",\"best\",\"place\",\"service\",\"also\",\"even\",\n    \"friendly\",\"amazing\",\"delicious\",\"awesome\",\"excellent\",\"wonderful\",\n    \"super\",\"definitely\",\"highly\",\"always\",\"staff\",\"order\",\"ordered\"\n}\n\n# Only cuisine types and specific dishes as targets\ncuisine_words = {\n    \"chinese\",\"italian\",\"mexican\",\"japanese\",\"indian\",\"thai\",\"french\",\n    \"korean\",\"american\",\"mediterranean\"\n}\ndish_words = {\n    \"steak\",\"pizza\",\"sushi\",\"burger\",\"chicken\",\"pasta\",\"tacos\",\"ramen\",\n    \"dumpling\",\"noodles\",\"seafood\",\"salad\",\"sandwich\",\"coffee\",\"dessert\",\n    \"beef\",\"pork\",\"shrimp\",\"lobster\",\"curry\",\"wings\",\"ribs\",\"salmon\"\n}\nattribute_words = {\n    \"expensive\",\"cheap\",\"spicy\",\"crispy\",\"fresh\",\"cold\",\"warm\",\"tender\",\n    \"overpriced\",\"authentic\",\"traditional\",\"homemade\",\"frozen\",\"bland\",\n    \"salty\",\"greasy\",\"juicy\",\"flavorful\",\"tasteless\",\"undercooked\"\n}\n\nall_targets = cuisine_words | dish_words | attribute_words\nstop_bc = sc.broadcast(stop_words)\ntarget_bc = sc.broadcast(all_targets)\n\n@udf(returnType=ArrayType(StringType()))\ndef get_pairs(text):\n    if not text:\n        return []\n    tokens = [w.strip(\".,!?\\\"'()[]:-\") for w in text.lower().split()]\n    tokens = list(set([w for w in tokens if w.isalpha() and len(w) > 3\n                       and w not in stop_bc.value]))[:20]\n    pairs = []\n    for w1, w2 in itertools.combinations(tokens, 2):\n        # Both words must be from our target categories for meaningful association\n        if (w1 in target_bc.value and w2 in target_bc.value):\n            pairs.append(min(w1,w2) + \"||\" + max(w1,w2))\n    return pairs\n\ndf = spark.table(\"yelp.review\")\nsampled = df.sample(0.05, seed=42)\n\npairs_df = sampled.withColumn(\"pairs\", get_pairs(col(\"rev_text\"))) \\\n    .select(explode(col(\"pairs\")).alias(\"pair\")) \\\n    .groupBy(\"pair\").count() \\\n    .orderBy(col(\"count\").desc()) \\\n    .limit(30)\n\nfrom pyspark.sql.functions import split\nresult = pairs_df.withColumn(\"Word1\", split(col(\"pair\"), \"\\\\|\\\\|\")[0]) \\\n    .withColumn(\"Word2\", split(col(\"pair\"), \"\\\\|\\\\|\")[1]) \\\n    .select(\"Word1\", \"Word2\", \"count\") \\\n    .withColumnRenamed(\"count\", \"Association Strength\")\n\nprint(\"=== Word Association Graph ===\")\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-24T04:24:36-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Word Association Graph ===\n"},{"type":"TABLE","data":"Word1\tWord2\tAssociation Strength\nfresh\tsalad\t2058\nfresh\tshrimp\t1146\nchicken\tsalad\t1009\nchicken\tsandwich\t977\nsalad\tshrimp\t923\npizza\tsalad\t848\nfresh\tpizza\t842\nflavorful\tfresh\t833\nchicken\tfresh\t829\nfresh\tsushi\t786\nseafood\tshrimp\t765\nbeef\tfresh\t743\nfresh\tseafood\t725\npasta\tsalad\t707\nauthentic\tmexican\t690\nauthentic\tfresh\t658\ncold\twarm\t644\ncoffee\tfresh\t618\npork\tsandwich\t602\nfresh\twarm\t590\ncrispy\tfresh\t587\nsalad\tsalmon\t577\npizza\twings\t561\nfresh\thomemade\t554\ncold\tfresh\t551\nchicken\twings\t550\nchicken\tpizza\t523\nbeef\tsalad\t505\nfresh\tsalmon\t505\ndessert\tshrimp\t496\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=22"},{"jobUrl":"http://node-master:4040/jobs/job?id=23"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774319751825_1142215395","id":"paragraph_1774319751825_1142215395","dateCreated":"2026-03-23T22:35:51-0400","dateStarted":"2026-03-24T04:24:36-0400","dateFinished":"2026-03-24T04:24:54-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, udf, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\n# Pain point seed words - at least one must appear in bigram\npain_words = {\n    \"never\",\"worst\",\"horrible\",\"terrible\",\"awful\",\"disgusting\",\"rude\",\n    \"slow\",\"cold\",\"dirty\",\"wait\",\"waiting\",\"waited\",\"wrong\",\"bad\",\n    \"poor\",\"waste\",\"overpriced\",\"expensive\",\"bland\",\"stale\",\"burnt\",\n    \"undercooked\",\"soggy\",\"greasy\",\"tasteless\",\"inedible\",\"unprofessional\",\n    \"unfriendly\",\"unhelpful\",\"disappointed\",\"disappointing\",\"unacceptable\",\n    \"mediocre\",\"nasty\",\"gross\",\"loud\",\"dark\",\"filthy\",\"refund\",\"complaint\",\n    \"manager\",\"ignored\",\"forgotten\",\"missing\",\"incorrect\",\"hair\",\"sick\",\n    \"vomit\",\"cockroach\",\"roach\",\"mouse\",\"mold\",\"moldy\",\"raw\",\"frozen\"\n}\n\nstop_words = {\n    \"the\",\"and\",\"was\",\"for\",\"that\",\"this\",\"with\",\"have\",\"they\",\"from\",\n    \"are\",\"but\",\"not\",\"had\",\"his\",\"her\",\"she\",\"him\",\"you\",\"all\",\"been\",\n    \"their\",\"has\",\"its\",\"our\",\"who\",\"did\",\"would\",\"could\",\"should\",\"will\",\n    \"just\",\"get\",\"got\",\"one\",\"like\",\"also\",\"even\",\"back\",\"went\",\"came\",\n    \"come\",\"make\",\"made\",\"said\",\"told\",\"ask\",\"try\",\"know\",\"think\",\"really\",\n    \"very\",\"more\",\"than\",\"then\",\"when\",\"what\",\"which\",\"there\",\"here\",\"how\",\n    \"about\",\"out\",\"can\",\"your\",\"into\",\"over\",\"after\",\"because\",\"some\",\"them\",\n    \"time\",\"over\",\"still\",\"going\",\"want\",\"need\",\"way\",\"give\",\"take\",\"see\",\n    \"look\",\"say\",\"use\",\"much\",\"well\",\"always\",\"every\",\"sure\",\"thing\",\"were\",\n    \"only\",\"other\",\"another\",\"restaurant\",\"menu\",\"meal\",\"dinner\",\"lunch\",\n    \"good\",\"great\",\"nice\",\"best\",\"love\",\"pretty\",\"friendly\",\"amazing\",\n    \"first\",\"last\",\"next\",\"every\",\"each\",\"just\",\"also\",\"even\",\"back\"\n}\n\nstop_bc = sc.broadcast(stop_words)\npain_bc = sc.broadcast(pain_words)\n\n@udf(returnType=ArrayType(StringType()))\ndef extract_pain_bigrams(text):\n    if not text:\n        return []\n    tokens = [w.strip(\".,!?\\\"'()[]:-\") for w in text.lower().split()]\n    tokens = [w for w in tokens if w.isalpha() and len(w) > 2\n              and w not in stop_bc.value]\n    bigrams = []\n    for i in range(len(tokens)-1):\n        w1, w2 = tokens[i], tokens[i+1]\n        # At least one word must be a pain point word\n        if w1 in pain_bc.value or w2 in pain_bc.value:\n            bigrams.append(w1 + \"_\" + w2)\n    return bigrams\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.filter(col(\"rev_stars\") <= 2) \\\n    .withColumn(\"bigrams\", extract_pain_bigrams(col(\"rev_text\"))) \\\n    .select(explode(col(\"bigrams\")).alias(\"Bigram\")) \\\n    .groupBy(\"Bigram\").count() \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(15)\n\nprint(\"=== Top 15 Pain Point Bigrams from 1-2 Star Reviews ===\")\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T04:27:25-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 15 Pain Point Bigrams from 1-2 Star Reviews ===\n"},{"type":"TABLE","data":"Bigram\tFrequency\nnever_again\t40116\nwaited_minutes\t29860\nwaste_money\t23655\nwait_staff\t15977\npoor_service\t15717\nterrible_service\t15683\nwait_minutes\t15475\nworst_experience\t14977\nhorrible_service\t14716\nbad_experience\t14693\nservice_slow\t14507\nnever_return\t14340\ntoo_bad\t14291\nservice_terrible\t13943\nbad_service\t13818\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=24"},{"jobUrl":"http://node-master:4040/jobs/job?id=25"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774320276035_805432660","id":"paragraph_1774320276035_805432660","dateCreated":"2026-03-23T22:44:36-0400","dateStarted":"2026-03-24T04:27:25-0400","dateFinished":"2026-03-24T04:28:45-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, size, split, avg, round\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.withColumn(\"word_count\", size(split(col(\"rev_text\"), \"\\\\s+\"))) \\\n    .groupBy(col(\"rev_stars\").alias(\"Stars\")) \\\n    .agg(round(avg(\"word_count\"), 1).alias(\"Avg Word Count\")) \\\n    .orderBy(\"Stars\")\n\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-23T22:49:56-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Stars\tAvg Word Count\n1.0\t134.0\n2.0\t134.3\n3.0\t124.2\n4.0\t108.0\n5.0\t84.5\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=6"},{"jobUrl":"http://node-master:4040/jobs/job?id=7"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774320396974_2044004061","id":"paragraph_1774320396974_2044004061","dateCreated":"2026-03-23T22:46:36-0400","dateStarted":"2026-03-23T22:49:56-0400","dateFinished":"2026-03-23T22:51:15-0400","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql.functions import col, udf\nfrom pyspark.sql.types import IntegerType\n\npositive_lexicon = {\n    \"amazing\",\"excellent\",\"fantastic\",\"wonderful\",\"outstanding\",\n    \"superb\",\"brilliant\",\"perfect\",\"awesome\",\"great\",\"delicious\",\n    \"loved\",\"incredible\",\"best\",\"beautiful\",\"friendly\",\"happy\",\n    \"recommended\",\"fresh\",\"clean\",\"pleasant\",\"enjoyable\",\"polite\"\n}\nlexicon_bc = sc.broadcast(positive_lexicon)\n\n@udf(returnType=IntegerType())\ndef count_positive(text):\n    if not text:\n        return 0\n    words = set(text.lower().split())\n    return len(words.intersection(lexicon_bc.value))\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.filter(col(\"rev_stars\") <= 2) \\\n    .withColumn(\"positive_count\", count_positive(col(\"rev_text\"))) \\\n    .filter(col(\"positive_count\") >= 3) \\\n    .select(\n        col(\"rev_id\"),\n        col(\"rev_stars\").alias(\"Stars\"),\n        col(\"positive_count\").alias(\"Positive Keywords Found\"),\n        col(\"rev_text\").alias(\"Review Text\")\n    ) \\\n    .orderBy(col(\"positive_count\").desc()) \\\n    .limit(20)\n\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T05:10:03-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"scatterChart":{},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"rev_id","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Stars","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"rev_id\tStars\tPositive Keywords Found\tReview Text\nKIklbj14hNtcLdw_mJYcFQ\t2.0\t10\tTwo stars. I would give one star for this restaurant's current state but I have to add a star for my great experiences at New Harmony in the past.   I've been coming here for about 10 years. It really breaks my heart to see how downhill this place has gone. It's even sadder because it's become increasingly difficult to find all-vegan & all-vegetarian restaurants, esp in Chinatown.  My favorite dish here used to be the (vegan) Beef & Broccoli. The fragrant, moist medallions of beef had a delicate texture which paired beautifully with the fresh broccoli florets. The light, broth-like sauce had incredible flavor. This dish has sadly been reduced to pale pieces of broccoli, greasy rounds of bland beef (sans that delicate texture), and an oily semi-translucent sauce that has none of the fragrant notes of it's predecessor. Heartbreaking.  The (vegan) Roast Pork Buns were my favorite app. The pillowy soft steamed buns had a mild sweetness that contrasted perfectly with the luscious pulled pork filling. These buns now taste like they're frozen and are devoid of their predecessor's homemade flavors. The buns are chewy and flavorless. The pork filling is now paste-like and tastes of cheap seasoning.   I used to be obsessed with their Hot & Sour Soup, House Special Wonton Soup, & Vegetable Bean Curd Soup. All boasted impressive broths, myriads of delicious vegetables, luscious cuts of tofu, amazing homemade wontons, and/or a selection of their impressive vegan meats (the ham being a standout). Sadly these soups no longer exist. I happened to look into the kitchen only to see boxed stock being poured into a pot for the Vegetable Bean Curd Soup I'd just ordered. It definitely tasted like boxed stock. Awful. The bean curd/tofu was flavorless. The vegetables (brocolli, carrots) tasted bland while other vegetables (giant chunks of zucchini) were undercooked and hard. The cabbage in the soup had a strange metallic taste.  I used to loved their Veg Bean Curd Cellophane Noodle Hot Pot. It used to be packed with incredibly fresh vegetables, fragrant glass noodles, gilded tofu with soft pillowy white insides, all glistening in a light sauce which enhanced every component with it's dimensional flavor. This hot pot is no more. It has been replaced with soggy flavorless tofu & soggy flavorless glass noodles. The vegetables are a mix of soggy and undercooked. Giant chunks of onion are now in this hot pot and it's gross. The sauce is thick and greasy and there is too much of it. Sad.  The Sticky Rice in Lotus Leave was once a filling portion of steaming, moist sticky rice encased in a vibrant green leaf bound with twine. The lotus leaf is now browning and pale with contents that literally taste like dirt. The texture of the sticky rice is like a mix of dry dirt and mud. The flavor is funky.   The Veg Spring Rolls used to be filled with piping hot, fresh shredded veggies and have a great vibrant flavor. Now they taste frozen. The pale white contents are ground/processed to the point of being unrecognizable, crumbly, and strange tasting.   The Three Color Dumplings used to be a masterpiece - pairs of perfect dragon (green) dumplings, carrot (orange) dumplings, & vegetable (white) dumplings. They were obviously made in-house. The delicate wrappers would yield to steaming hot, bright fresh flavors. These dumplings no longer exist. The dumplings now have chewy wrappers with bland, ground up contents. In all likelihood, they are frozen.  Even the plain white rice is bad. I taste a metallic flavor throughout it. I was shocked. It's white rice.  They used to carry spectacular vegan cheesecakes - raspberry, chocolate, pumpkin, etc. These cheesecakes were phenomenal. I'd look forward to seasonal varieties. These were made offsite by a brilliant baker. They stopped carrying these cheesecakes a few years ago and it seems like that marked the beginning of the decline of this restaurant.   I hope my feedback reaches someone who might be able to bring back the wonderful restaurant I knew and loved. I would be so happy to become a regular at New Harmony again.\nmkjtrUtV8wgdo2Qe36v-yA\t2.0\t9\t23 DOLLARS FOR A PO BOY???!!!! AND RUDENESS???   Just back from New Orleans during Jazz Fest weekend and I must say that it was divine. Had some amazing food, great fun and had excellent company.   So, after a fun-filled morning shopping for art in the quarter, my friend who lives down the street from Mahony's, our kids and I went to have a good, fresh po-boy at Mahony's. I had NEVER been here before, I just read how wonderful their po-boys are on Yelp and wanted to try it out.   Stood in line for 10 minutes or so, stepped up to the counter and asked to order a to-go. Ordered a 12 inch grilled shrimp and fried green tomato w/ remoulade, onion rings and the arugula salad. The price? $41!!! I had to look twice but then i realized that my po-boy was $23!!! Oh. My. God. A $23 dollar sandwich is expected in Manhattan when served with gold dust baked into the bun. I almost fell over.   So, ok, I ordered it, I stuck to it and prayed that it was going to be the best po-boy I had ever had.   So, twenty five m minutes later, and still no order, my friend and our kids came inside and we decided that we might as well eat here, since the kids were awake from their snooze in the car seat. So, we asked the counter girl if we could just get our food for here, instead of to go. She looked at us like we had just lost our minds. She said, \"We can't do that, you have to wait in line and wait for a table and you can't just walk in and ask to eat to go here.\" I then explained to her that I had waited in line, had been waiting for our food, just like everyone else, pointed out that their were 6 open tables in the restaurant that no one was sitting at (it is seat yourself) and we weren't trying to pull a fast one.   She looked at us and said, \"Hold on,\" and walked into the kitchen. She returned a few minutes later and said, \"You can do it this time, but don't ever do it again,\" and huffed off.   Wow. Alrighty then. This was a young, I assuming Korean-American kid, and since there are pictures of the owner and the elderly mom all over the Internet, I know she isn't an owner and she talked to us like we were the gum she was scraping off of the bottom of her shoe.   So, I spent $23 on one sandwich, the wait ended up being 50 minutes from walking in to getting the food, which was good, fresh shrimp, NOT OVERSTUFFED as they claim and the remoulade had WAAAAY too much horseradish in it, but it was a \"good, just not great\" sandwich. If it had been less expensive, I may have been more impressed, but for what I was charged, that should have been an awesome sandwich experience, which is just was not.   Pluses? Great bartenders, very polite and good service, delicious onion rings (not to be missed) and the arugula salad was good.\nI8AzDdu53ye-3HmubeqmMg\t2.0\t8\tHer experience:  Last night my partner and I went to a long awaited dinner a Vedge. Our experience at Vedge was very mixed. The interior of the restaurant was beautiful but the formality of the atmosphere felt a bit forced and the staff was welcoming but cool.    Our first dish, the chilled cucumber soup, was outstanding. It was extraordinarily well executed. It was a distillation of all the best tandoori flavors with a perfect balance of flavor and a nice texture. Our two main dishes were also very good. The fresh peas and cauliflower crepe was Incredibly rich, buttery and delicious. The flavor of the fresh peas was fantastic. It was a very high quality example of the type of food Vedge is trying to create. The palm leaf heart tangine was also lovely. There was a nice crunch added to the couscous, the palm heart had an almost scallop-like texture and flavor. The sauce was delicious but could have been slightly more abundant. We were less impressed by the zucchini dan dan noodles which were a bit too spicy, to the detriment of the other flavors in the dish.   Unfortunately our dessert, the Yuzu cornbread, was awful, like something the chef did not taste before it left the kitchen. The miso frosting, which sounded intriguing was way too salty and abundant, the cornbread had a terrible dry texture and was sour. We left almost all of the dessert on the plate but were not asked by the waiter if it was ok.      His experience:  This place was really hit or miss. Several of the dishes were great, but I don't think I'll be back again.  The wood paneled room was incredibly beautiful, perhaps the most beautiful interior of a restaurant I've been in recently. No acoustic tiles on the ceiling meant it was quite loud. The music was soft, but added to a loud environment.  Our waitress was... awkward. She was disturbingly smiley, and mumbled at an inaudible level so that we nearly had to ask her to repeat herself every time. Also, she seemed to have no knowledge of the menu other than to tell us to order more stuff. OK. We ordered drinks and 5 dishes. My porter was excellent, my gf's sangria was watery. The chilled cucumber soup and Zucchini Dan Dan noodles came first. I highly recommend the cucumber soup. The distillation of Tandoori flavors was superb and well paired. No complaints about the Dan Dan noodles, they were quite tasty too.   A rather large gnat landed in my beer, and I'd kill two more before leaving. Ok. Next came the fresh peas and cauliflower buckwheat crepe and hearts of palm tagine. I very much recommend these dishes too, the distillation of flavors in both were excellent. The peas were particularly outstanding in very rich, buttery flavored broth. The heart of palm had a taste and texture not unlike scallops. Very good.   At this point we both agreed the chefs at Vedge had a very high ability for distilling down key flavors (the kind that are understated in many other foods). So in spite of the uncertainty we had regarding the pairing of flavors in Yuzu cornbread, we ordered anyway, excited to see how they would translate miso flavor into icing. It was one of the worst items I've ever had at a restaurant. It tasted like someone had emptied a shaker of salt onto pillsbury frosting, mixed in pineapple and placed the concoction on top of very dry cornbread. What a way to end a meal!!  We were anxious to leave, so when the check came I took it up to the front to pay. I find restaurants normally don't want to give the impression of pushing you out the door, so often they're not super fast to pick up my card. When I'm in a hurry and need to be someplace I'll often walk the bill up to pay, I think this is pretty normal. The host at the front informed me my waitress needed to take care of that, and that I needed to sit back down. Wow. I wanted to scream: get me out of here.  So would I recommend Vedge or ever go back? Probably not. Most of the food was quite good, and the things that detracted from our evening were mostly minor. But there were a lot of them. It was also pricey. I expect that in a top restaurant, but this is not one. How do I know? No one ever came to our table to ask how our meal was. There are many great restaurants in Philadelphia, I'm not sure why I would go back here?  Leaving Vedge I felt much the same as I did at the end of the workday, tired, stressed and a bit (V)edgy.\n_cew3OnhKe6DCqij7E6Eng\t2.0\t8\tMy husband read about this place on reddit and so last weekend, I had to check it out as there were some great reviews! I wanted to give their items full evaluation so I ended up with 2 bags full of random things from the store.  I came at around 11:30 and they open at 11 but they were out of siopao which I was really excited to try as it has been over 25 years since I've had a fresh-made one.  I was sadly disappointed.  I am Filipino and I've missed some of the baked goods I used to have when I lived in the Philippines over 25 years ago.  Also, I really want to introduce my husband to some Filipino cooking outside of the homemade lumpia, puto with cheese, chicken adobo, and pancit I am capable of whipping up.    The storefront is quite small but packed with all sorts of goodies and smelled absolutely divine upon entry!  The staff were super friendly and helpful and the place looked clean and well-maintained.  Now, on to the food!  Here's a rundown of what I purchased and my thoughts/opinions:  Pork Empanadas - they were freshly  made, crimping were beautiful and tight and they were filled with some of the most delicious filling!  I had to wait for about 5 minutes while they package them up as they were literally just out of the fryer.  Pianono - I got the 2-pack (ube and coffee).  They were delicious, the cake was soft, moist, rolled tight but the filling held and stayed in place with only the slightest bit of oozing.  If I were to rate the place based on this alone, they would get a 5-star.  But... read on...  Puto with cheese - steamed mini cakes topped with a small slice of cheese.  Do they make these fresh?  I don't think so because like I mentioned earlier, I was there at 11:30 and my pre-packaged puto, opened only an hour or two after I got home, contained 3 moldy puto.  I was sorely disappointed and made me question the freshness of the other food items I bought.  I tried one of the puto without mold and located farthest from the molded ones and it was dry, hard, and not very flavorful.  I don't know what the deal was with the cheese but it tasted very bland as well.  Bad cheese?  Well, I did not get sick so it might have been just awful cheese selection for the bake.  Atsara - this is papaya salad for those who are unfamiliar.  The general taste should be sweet and sour, however, the 1 pound container I took home was mostly sweet and lacking in any other flavor.  I've had some from Guerilla and theirs is better in comparison.  I've had some great homemade ones from family gatherings and unfortunately, STLFB did not take me back to the days of eating them while in the Philippines.  Bibingka - it came in a 2-pack and I could only bring myself to take 1 bite because it was dry, hard, rubbery, and bland.  My husband gave it a try and he said the same thing.  Not a good representation of what Bibingka should taste like.  Nowhere near what my lola (grandma) used to make.  Pancit palabok - noodles in sauce topped with crushed chicharron (fried pork rinds), fried garlic chips, and hard-boiled egg.  The guy at the counter, who was super nice and had excellent customer-service, told me they were made fresh and I took one of the containers that did not make the refrigerator yet.  It was still lukewarm when I got home and I live roughly 10 miles away (about a 20-minute drive).  So the noodles were cooked well, they were swimming in sauce which had some nice flavors but I did not get the appeal of crushed chicharron and fried garlic chips as toppings.  I have never had these as a child so they're most likely not from the region where my family is from.  The hard-boiled egg was overcooked, evidenced by the blue-green ring around the yolk.  Perfectly hard-boiled eggs should have a bright yellow to bright orange yolk, not something that looks like there's mold around it -- sadly it looked quite unappetizing.  Boiling the eggs at no more than 11 minutes at rapid boil should yield perfect hard-boiled eggs.  Would I return?  Yes, probably to try something different, get more pianono, and empanadas, and I really want some fresh siopao.  I also would like to see if I can find some redeeming things about some of their items because I do think it's great to have a place that makes Filipino food and is located at a reasonable distance from my residence.    Why the 2-star?  I really wasn't impressed with most of the items I purchased.  While this place is reasonably-priced, I was hoping their items would have been better-quality, great tasting, and fresher.  Perhaps next visit I will have a better experience but so far, my experience only amounted to that of a 2-star visit.\njxNvoQhC0k77Mi3ZivrwKA\t1.0\t8\t1 star because there isn't a zero star option.  6/8/2016 - Here's an update to the update, almost 1 year later:  I just returned from a trip to Jordan with Gate 1 Travel.  The country is amazing and we had a wonderful tour guide, Hazim.  If all guides were like him, every trip would be fantastic.  I made sure to write to Gate 1 twice about Hazim.  I really think he's an outstanding guide.  I wouldn't say so if I didn't mean it.  He's fabulous!    However, the reason my unhappiness with Gate 1 has been renewed is because of the owner.  My complaints went on for weeks before the owner called me, which I thought was great.  He did offer small discount for my next trip as well as room upgrades.  I didn't ask for it and I thought it was a very nice offer from a business owner who cared about his customers and his business.  I was so, so very wrong.  We stayed in 3 hotels in Jordan.  Marriotts that are very nice.  But, how many room upgrades did the owner arrange for me?  Absolutely none!  Now, I didn't NEED an upgrade, the rooms were fine, but that's not the point.  That's not the point at all.  The owner, Mr. Dani Pipano, who impressed me so much by personally talking with me, didn't honor his word, which is more important than anything.  I didn't ask our guide about the upgrades while we were on the trip as he had nothing to do with it.  I didn't write to Gate 1 about it while I was in Jordan because, honestly, I didn't want to get pissed off while on vacation if they gave me some lame excuse.  And lame excuse I got when I did write to Gate 1 upon returning home.  Here's Gate 1's response:  \"I am so pleased to know that you enjoyed your trip overall and that your guide and driver provided excellent service.    In regards to any upgrades, we do apologize if they were not provided. Unfortunately we are not always able to secure upgrades as we do not own or operate the hotels. That said, we did our best to ensure you had a pleasant experience and were ultimately satisfied with your accommodations.    We do hope that you enjoy your upcoming trip to Cuba as much as you did Jordan.  Kind Regards,   Caitlin Spindler  Customer Service Manager\"  Seriously?!  That's not what Mr. Pipano said to me.  Now I feel like a complete fool for believing the guy.  It feels now that he just promised something, anything so I would post a better review and/or stop complaining about his company on social media.  I believed him so much I foolishly booked a trip to Cuba with Gate 1, BEFORE I went to Jordan.  Stupid mistake.  I can't get a refund so I'll end up giving my money to a company I will never, ever use again.  I suggest you don't use them either.  There are dozens of tour companies.  I'm sure there are plenty of others that actually value their customers.  As I wrote back to Ms. Spindler...good customer service will make or break a company.  For me, Gate 1 is broken.  Please, please spend your money elsewhere.  **********************************************************************************************************  I've been meaning to write an update.  The owner and president of Gate 1 Travel called me personally.  I couldn't believe it and I was so impressed!  He listened intently to everything I had to say about my trip.  We both agreed the hotel employees bore most of the blame for what happened with our passports.  They should never have handed them to us.  The owner explained how Gate 1 provides training to their guides and they also ensure guides understand how to work with American customers.  Not that we Americans are so different than other customers, but there could be some cultural differences and Gate 1 addresses that in their training.  We talked about the issue with tips and discounts.  It so happened the owner was traveling to a guide training session in Asia the week following our telephone discussion.  He assured me attention would be paid to training on the issues we discussed; also he said he would have an opportunity to meet with Mansi, the guide we had for our trip.  I was so impressed by the owner's personal attention.  He asked if I would give Gate 1 another chance and offered me a small discount on a future trip.  I believe the owner is sincere about wanting to be sure customers are happy with their Gate 1 experience and his actions showed me he is serious about good customer service.  I already booked a trip with Gate 1 for next year and I'm looking forward to a great trip and great experience.  Thanks very much Gate 1.\nruWWCJZKTOneyaEqLKhcCA\t2.0\t8\tSo in all my life I've never once been to a red lobster - even though I LOVE seafood. For some reason it just didn't appeal to me and I've never heard amazing things. But on a whim my husband and I decided last week what the hell we'll give it a try. It was around 9 pm and they close at 10 so we asked if it was still ok and they said \"yes\" however they let us know they were out of the full love lobster, salmon and all the fresh fish except tilapia.  We decided that was fine and proceeded to order mussels for an app and then two meals that consisted of breaded shrimp, coconut shrimp, cheesy mash potatoes, asparagus, lobster tail and a fish that was stuffed with rice cheese and broccoli. The mussels were pretty good, I liked the broth and the garlic bread that we dipped in it. There were 5 closed mussels though and I thought it very odd that those made it on the plate. I mean I know you can sometimes eat closed mussels (mixed opinions) if you get them open and discover they are well cooked and smell fine but who wants to risk that? Plus exactly how were we supposed to pry them? When you order mussels you expect the work to already be done. The breaded shrimp reminded me of something you get from your freezer, same with the coconut shrimp. The cheesy mash was actually really good. The fish (I can't remember the type) stuffed with rice, cheese and broccoli was terrible. I tried three bites to see if maybe it would get better and no, it was not good at all whatsoever. My favourite part of the meal was actually the biscuits. Omg if I could've just had a meal of those I would've been pleased as punch! They are super delicious!! Delicious enough to gain weight for!  Now the service. Our waitress was actually fantastic. If you've ever seen the movie Fargo she talked and had an accent EXACTLY like Marge from Fargo and I seriously loved it so much. She was friendly and fast in the exact very straight forward way that Madge it too. It was honestly almost - almost worth the mediocre food to have her as a waitress. Even though the food here is WAY over priced for the quality we still tipped her 25% because she was awesome and should know that. At the end of our meal - around 9:45 one of the employees started cleaning duties. Now I get they close at 10 and want to be out quick but it was so weird because he actually dumped an entire bucket of mop water on the tiled floor next to us. This water proceeded to gush in all directions seeping into the carpet beside us. He the started to mop and squeegee the floor as though his entire life depended on it. It was so odd and kinda gross. Then along comes and girl with her carpet sweeper cleaning next to us. I mean it's great to see they keep a clean space but I feel like if your sign says you're open until 10, be open until 10. Nothing kills dinner like the smell of mop water, old wet carpet and agitated aggressive \"get the eff out\" cleaners.  All in all I can't ever imagine returning, the food was just not at the quality it should be for the prices their charging. It actually feels like robbery. There are quite a few spectacular seafood places in the city that are also not cheap but its completely justifiable because of their amazing flavour, quality and freshness.\n-Z719PUrHg_6zBaDY9UNJw\t2.0\t8\t\"Based on food quality alone this might be two stars\" was opening to my 3-star 2013 review as first timer here when visiting Eagle.  Now as Eagle resident since 2014 and guest at Bella Aquila multiple dozens of times for lunch, happy hour or dinner, I have to stretch on tip-toes to set this at 2-star level even factoring in the lovely setting on the river .  So six years later, this may be more farewell note than review.  Sure, you can do worse in Eagle  but you can do better too.  Advertised as an Italian eatery, this never really has been that.  But it is a lovely setting and on a nice day during happy hour it was a good place to sit outside for a cocktail - one of few hard liquor licensed bars in Eagle - and if choosing carefully from the menu, for nibbles to go with it.  We also appreciated that the restaurant was open straight through from lunch through dinner and during a miserable builder experience building our house during a wicked hot summer in 2015 we could escape at \"linner time\" to a serene setting with pleasant music that fit the space - think Sinatra and friends - set at a level that allowed us to have a conversation.    This is owned by a local couple who are probably about my husband's age and we wanted to support them over the years, hoping for better things over time even though the food was routinely mediocre at best and at the worst dishes were simply inedible.  But in the mode of even a blind squirrel finding the proverbial acorn once in a while, there were things on the menu that could be good if you learned how to 'work around'.  For example, tasty Green Goddess dressing was often served on sadly wilted salad greens so one learned to order it for the wedge salad given that lettuce was more likely to be fresh enough to eat.  And in spite of the same old tired menu ongoing, on occasion there were teeny flashes of reasons to be hopeful that maybe the kitchen was in new hands when a special well prepared turned up.  Like a luscious riff on a Greek classic lamb, green bean and potato soup in 2016 that is memorable even now. But inevitably the food was as if unloaded from a Sysco truck and put on the plate or maybe crafted in a middle school Home Economics cooking class.  Up end pricing but low end kitchen performance.    The most frustrating part may have been hospitality and service.  The young staff seemed in constant turnover with little training.  Still they always seemed to mean well and on occasions when we had the same server more than once they always greeted us warmly.  That we are generous with gratuity likely had something to do with this but also we behaved as gracious guests, in particular for things outside the server's control like kitchen performance leading to excruciatingly long delays to get orders to table or bad food.  Yet, for the dozens of times we were in Bella Aquila it was as if whomever was managing front of house at the time - for a time the owners' son who seemed to have the metaphorical Joe Btfspik black cloud over his head and then the bartender who seems to have been promoted to front of house manager and under her watch hospitality got worse - had never seen us before.    Still that there was table service and table linens and conversation friendly sound levels got thumbs up from us as counterpoint to the over abundance of fast-casual-stand-in-line-to-order-formula food-chain places with ear-splitting music levels that pop up like weeds in this area.  And that the dining room and patio were always spiffy clean was a plus.  (On that I give nod to the owners' son who seemed to focus on clean up to the extent that when I first met him I thought he was the janitor.)  And, of course, the river setting.  But all the negatives of bad food, untrained servers, poor management in the kitchen for coordination with front of house and lukewarm hospitality all at higher end prices have had us cross Bella Aquila off our list.  Even the river setting can't save it.  PARKING:  Private lot.  It it is full in front look for the extra parking around the side of the building. .  ACCESSIBILITY:  Accessible (ADA) parking spaces in lot.  Level in and throughout.  Patio and dining rooms have standard height table seating.  Unfortunately, bar does not.  (Yes.  You're right.  They should per ADA law.)  Loo in lobby is accessible.  NEIGHBORHOOD ALTERNATIVES:  A) For unpretentious fine dining near downtown Eagle with excellent food from a French Chef, charming ambiance including table linens, warm \"Bienvenue\" hospitality, table service from friendly people all as managed by the Chef's wife who is co-owner, patio seating, great wine options, hours that are straight through from lunch through dinner 6 days a week and live music  some nights, try Bacquet's in Eagle.  We love it.  B) For river setting although mediocre food and hit-n-miss service in \"WHAT DID YOU SAY?\" noisy space, distillery-bar-restaurant Bardenay in Eagle is popular with some.\nSjrKvxcw2-GC9qqre02yEA\t2.0\t8\tMy brother had just been to China last September and for some time was raving about the authenticity of Tampa famous Yummy House's stir-fry, noodles and hotpots.  I had also heard great things from many other reputable food lovers who dropped their jaws and judged me when I admitted I hadn't been there yet.  It was finally time to see what this Yummy House place was all about.  Walking in with a cooler containing my favorite bottle of wine, I was already looking forward to the much talked about Yummy House experience.  BYOB restaurants with no guidelines or restrictions are a rarity so they had already scored some serious cool points. When we walked up to a large table fit for 7, my brother's girlfriend, a returning patron, immediately waved over a server before sitting down.  She looked at me and smiled, holding back laughter, knowing full well I would be displeased.  She pointed to the smudgy floor and the man grabbed a napkin, bent over, and picked up a very large roach.  Luckily the rest of our dinner party had not arrived so this \"minor\" gruesome detail would have to be our little secret. Trying desperately to forget about the bug, I gulped down a glass of Pinot Grigio in under a minute.  Our friends soon arrived and were good sports about the stained plastic tablecloth, the smeared glass \"Lazy Susan\" and the blurry lip-stained wine glasses.     We began our Chinese feast with their famous Salt and pepper Calamari, Eggrolls and Potstickers.  The calamari was indeed marvelous.  Battered beautifully, fried to perfect crispiness and topped with cilantro, jalapeno, red pepper flake, garlic, sea salt and pepper, I was taken back by its pleasantly powerful punch.  Salty and spicy played key roles in this texture and flavor dreamland.   The eggrolls were generously stuffed and seasoned with various Chinese spices, giving each bite an enjoyable zing I've never experienced with eggrolls beforeThough not in true steamed potsticker form, these fried pockets were still easy to scarf down with their tasty meaty insides spewing from the crispy shell. All of our starters were demolished in no time and from the wonderful impression of these delicious eats, I was anxious to devour the main courses.       We all ordered different entrees with intent to share.  Yummy House practically insists sharing takes place with the \"Lazy Susans\" found at every table.  The first plate brought out was the Cashew Chicken.  Chicken, zucchini and cashews galore lay heaping and covered in a caramel-colored glaze. The chicken was tender, the zucchini was crisp but the sauce was almost too tangy in taste and terribly thick in texture.  This dish could've easily come from a white and red square-shaped container.  Next please.    Three more stir-fry chicken dishes came out in seconds- two plates of Spicy Yummy Chicken and a Szechwan chicken were now presented before us, looking almost identical in color and with similar vegetables studded throughout.  Again, the Szechwan chicken was nothing to write home about.  The Spicy Yummy Chicken was slightly more impressive with its great resonance of a yummy kick and its perfectly cooked fresh mushrooms creating an awesome variance in texture to the overly sauced chicken.  So far this was the Chinese champion but I was still underwhelmed.   The Spicy seafood clay pot was delivered next and the aroma alone convinced me I'd be disappointed no more.  A deep brown broth with shrimp, scallops, white fish and tofu was steaming hot and begging for consumption.  The depth of flavors in the broth and the fresh seafood were pleasing to my palate but the abundance of tofu was not.     The last two dishes served were the Beef with XO sauce and the Singapore Noodles.  The beef cut with a fork and came with crisp snow peas.  The XO sauce was mild in sauce strength but still full of great flavor, making this beef stir-fry the runner up of the night.  After reading an article in a local magazine where Yummy House's Singapore noodles were praised by a Tampa chef, I knew it was my duty to make sure we ordered them.  I am also a noodle fanatic so I was most excited about my menu choice. The shrimp and pork strewn throughout the curry vermicelli noodles had my taste buds thrilled for the first bite.  Tasty indeed but nothing more, my most valuable sense was let down by the lack of oomph it had been eagerly preparing for.       My hopes and dreams were somewhat destroyed. Yummy House did not overly excite and it certainly did not live up to all the hype.  Mediocre service and drab ambiance were expected but I was only there for the fantastic fare.\n9SBFeTwmFxCwKX0s4SBNKQ\t2.0\t8\tI wanted to take a moment to share my recent experience at Café Madeleine on Mother's Day for anyone thinking about making a reservation for a special occasion.   Back in January when I was looking for ideas on what to do for Mother's Day, I came across their website and loved the idea of dining at the Palm Piper House in Tower Park. I called to inquire and was sold on the experience that myself and my family would receive by booking for the special holiday. At the time the lady who took my reservation, said that I was one of the first callers to make reservations and took all of my information - this was a very easy and pleasant process.   Fast forward a few months to April, and it dawned on me that I had not received a confirmation or phone call reminder for my reservation so I called to double check. I left a voicemail which was promptly returned confirming that they had us on the list. When we arrived it was cold and rainy, nothing I was too concerned about because I was under the impression that we would be inside the historic greenhouse. Much to my surprise, we checked in and were shown to an outside table next to one shared space heater. The atmosphere was dreary, cold and extremely disappointing. Maybe on a nicer day, dining outside would have been fine had we been given the option but not in a forced setting. I politely went back to the check in area and addressed the seating arrangement with the gentleman. I realized at that time, it was a moot point as the seating arrangement was decided in advance; however, I told him of my disappointment and shared my feedback. He mentioned that upon reserving my reservation, I was told that I'd be outside which I explained was not the case. How could I have been told when I originally made the reservation in January? And on top of that, when I called to confirm no one told me about the fact I'd be seated outside - otherwise I would have requested inside seating or possibly even cancelled my reservation. It was not mentioned once, not even as a potential option. When I booked the reservation and when I arrived I was lead to believe that I would be inside.   I went back to my table with my family, in the cold and tried to make the best of our disappointing start. Our server was not friendly, maybe she could sense we were not happy being outside but none the less she was unprofessional. We started by asking for coffee, my husband requested a hot tea for me as I am not a coffee drinker. She proceeded to say that the water was only lukewarm and that she wasn't sure if that would work - we asked for the tea anyway. It never came, so I ordered an iced tea instead. We requested more cream and sugar multiple times, and she seemed irritated even telling us to stop asking because she had it coming, but it look over 15 minutes for it to arrive (not acceptable). I've been to many restaurants and catered events before, this was by far one of the worst servers that I've had. Maybe she was not in a good mood for her own reasons, but she definitely reflected it in her work. To be fair, she left us alone after the initial drink order - we rarely saw her again until the end at which point she was more pleasant than the beginning of the meal. I did encounter other more friendly and professional staff members, so I know that this must have just been bad luck for us. The food selection, quality and taste was on point - because of this our experience wasn't a total bust and the only reason I gave 2 stars. Action stations were great and special shout out to the staff members manning them as they were enjoyable and friendly. Everyone did a good job with making sure there were fresh items replenished when they ran out and overall we were very happy about the food.   That being said though, at the end of the day we paid for the experience of dining at the Palm Piper House and at best we got a small glimpse of what it would have been like walking through on the way to pay the bill.\nVXkBOKnA7_d-fcs49qAbpQ\t2.0\t8\tTimes change, and Raw has lost that fantastic glitz it had when it first opened. Yes, the samurai in the lavatory is still the coolest thing we've seen in a public bathroom, and the flat granite slab that serves as a co-ed sink is someday going to grace our home, but ambience isn't what we come for, we come for food.  The hot kitchen has suffered recently and that's been reflected in a menu that has dropped to a quarter the size it once was. The short lived tempura menu is no longer offered, a shame as the tempura was some of the best we'd tasted.   The Sake menu has also started to suffer due to supplier issues, with some of our favorite sake's no longer available. There are still some great offerings (try the black bottle) but it's always a disappointment when your old 'standards' go by the wayside.  Luckily, there's Chef Sam.  Chef Sam will be the only reason this place pulls through from the gutting of the hot menu. His skill with sushi is amazing and on this visit we tried his interpretation of Beef Negemaki, which was delicious. The bartender that evening, Chris (one of our favorites so tip him well) suggested it be served with a small portion of rice and I agree, it would be perfect with the delicious sauce.  Sam's sushi is always delicious. Check with him to see what he's brought in fresh the day you go. White Tiger is delicious though a tad spicy for me, but Sam is always happy to cut back on the spice when requested to.  If Sam's not there on the night you go, we suggest you come back another day.  We'll be trying this place every so often to see what happens as Sam takes the reigns of the hot kitchen and the place gets it's feet back.  The bell hasn't tolled for Raw yet, but the hunchback and his hammer have started climbing the steps.\nPUSOHlLBFnpHmUeH6pQScg\t2.0\t8\tVisited Urban Chestnut Brewing Company on Thursday night. It was getting late so only got to order one Flight.  Quality Urban Chestnut Brewing Company has an interesting style, but not one that I was a fan of. They basically split their beers into two categories, beers based entirely off of European tradition and beers that look to modernize and grow on those traditions. I tried four of the selections they had on tap Winged Nut, STLIPA, and Prickly Pear Ku'Damm from the new style and Innovator from the old. My highlight was the Prickly Pear Ku'Damm, a sour beer based on a traditional Berliner weisse. It was red in color and had the perfect amount of tartness. Unfortunately that is where the good ends. I did not really enjoy any of the other beers I tried. Innovator, a Belgian dark strong ale, came across as almost syrupy to me, I did not enjoy the grapefruit that overwhelmed STLIPA, and Winged Nut, a chestnut ale was heavy in nuttiness, just not in an enjoyable way.   Quantity While they have Flights, they do not come with any fancy gimmicks like other breweries. It is just four surprisingly large pours of different beers served in a holder.  Value The Flight I ordered was only $8, a great deal considering the extra large pours. Drafts were $6 or $7 depending on the selection.  Ambiance Urban Chestnut Brewing Company has two locations in the St. Louis area. I visited the one in the midtown. Apparently the big different is this location has an outdoor biergarten and the other location has a massive bierhall. I also believe this location has a smaller food menu and less beers on tap. Even though my visit was later in the evening it was still very hot out, so I could not enjoy the outdoor area, but I did take a peek at the beautiful space. It is definitely a place I could imagine hanging out when the weather was nice. And while the indoor area may not have the wow factor of the other location, I found it very comfortable. A small bar on the back wall with a television, some scattered tables, and video games in the corner gave it neighborhood bar vibes. I also loved the brick walls and the all around retro feel. The coolest aspect was that they were playing classic records. It meant more work for the bartenders, but there is just something special about hearing music the way it was meant to be played. I'm not sure if that is an every night affair, but it should be.  Crowd When I arrived there were only two small groups still hanging out. One inside near the video game system and another in the outdoor beer garden. Because of the cool outdoor area, I assume that this location is a hot spot for day drinking when the weather is nice. And when it is less pleasant I feel like folks probably head over to their other location that has the massive bierhall.   Service Two guys were hanging out behind the bar. They were both very friendly, but I could sense they were anxious to go home. Nevertheless they were happy to help me select some beers for a Flight and offered suggestions of other places to check-out in St. Louis during my short visit.  Parking The brewery has a small private parking lot directly in front of the building. For busier times there appeared to be a good deal of metered street parking in the area.  Extra There is no doubt that Urban Chestnut Brewing Company's midtown shop has an awesome space. The outdoor area and the use of vinyl are huge draws in my book. In the end though you come for the beer, and I just was not into what I tried. It may be that their adherence to traditional was out of my wheelhouse so I could not appreciate what it was. But in my book they fell in the lower tier of breweries I visited while in St. Louis.\no4pF1RlqjCgtXpm3rr_baw\t1.0\t8\tI'm not a big fan of reading or posting negative reviews because I feel like reviews should be edifying and to educate other consumers and most reviews are more negative then educating however, I felt the experience I had was worth sharing as to help others struggling with a skin condition and trying to find a dermatologist. Like I said I'm not a huge fan of reviews and to be honest this is the first one I have ever written but I hope it helps even just one person.   I visited Dr Bortons office struggling to find some relief from the Rosacea I had developed postpartum with my second child. It has been an emotional past couple months as it is after having a baby and then top it off with a skin issue and your confidence is blown. I saw the negative reviews online but because I serve Jesus and he gives second chances I thought I could give their office the benefit of the doubt.   The office was incredibly beautiful. I was super impressed by the modern and swanky office. Most derm offices feel like a hospital and this looked like a day spa. However I immediately noticed that what may be beautiful on the outside isn't always on the inside. The two admin employees upfront were nice but not welcoming and the technician that assisted Dr. Borton was very distant. I still however over looked this knowing people have bad days and actually hoping I could bring some life into the office. When Dr. Borton entered the office she was very knowledgeable and straight forward but not compassionate. She gave me great advice on a skin care routine and makeup line Colorscience. I ended up purchasing the products she recommended and left excited especially since she told me she had Rosacea I thought if she could use these products maybe I could too! I had been looking for makeup and skin care for 11weeks and was excited to feel beautiful again.   The next morning I applied the makeup and went out for the day with my kids excited to get dressed up and happy the makeup didn't burn my face. I had no issues all day but when I removed the makeup that evening I was in for a big surprise. That last 11weeks not only had I been having rosacea on the face but also ocular rosacea with swollen eye lids, eye bumps and eye lash loss. It had taken me 11 weeks to get my eyes on track and when I removed the eye makeup I had several hard bumps on the ehe lids. That following morning more bumps and swollen lids again. I was so bummed. I researched the products and found they contain several fragrant oils and ingredients not safe for sensitive skin! This is what was reccommended for my sensitive rosacea skin?   I called the office and told them I had a reaction. The woman's said she had never heard of that and scheduled me to meet with the rep of the line the following week and also said they would honor a refund. She was not rude on the phone but not polite either and seemed confident it was not the makeup. I felt I irritated her. I scheduled the appointment and hung up. I decided after speaking to her why would I keep something I could not wear and decided to return the makeup which I did the next day. The staff wasn't happy about it but they gave me a refund. I let them know I wanted to keep the appointment with the makeup rep and ask some questions.   The following Monday I received a call from the office stating that Dr. Borton wants me to get another opinion and felt she spent a lot of time with me and didn't know where else to go with me since I returned the products and they could no longer sell me anything anymore. They canceled my appointment and dismissed me as a patient. I was shocked but happy because I felt the Lord intervened and this is not the place for me. As I need a derm that is compassionate about helping patients and not just selling products. I feel sorry for this office because they focus too much out the world and outward appearance and miss the joy of helping and serving people.   How sad for them but the Lord lead me to an amazing dermatologist and office. If you're searching for an incredible office with warm and inviting people that truly care about your health and well being go to Keller Skin Care in Meridian. Awesome awesome derms and office staff. They felt like friends when I left and there was a true joy there. If you're looking for a safe makeup line for acne or Rosacea don't by Colorscience, by Jane Iredale. The Studio salon downtown as well as Boise image medi spa sell it. amazing makeup and super gentle.   I pray for Dr. Borton and her team. May they find the true joy in life. Blessings.\nkOyg5c6kFzxmGBCprLG_KQ\t2.0\t7\tInvited for a lunch date to this new place and looked it up online.  Looked amazing, albeit with a pretty limited menu.  They explain their concept of the inhouse greenhouse in which they grow their own greens, so of course I had to try one of their salads.    The renovation really brightens and brings the Arlington Gardens space out of the 80's funk they were in.  The waiting area is very pretty with comfortable leather seating and a beautiful crystal chandelier, what was unexpected was the open kitchen space in the lobby/wait area.  The coffee shop area looks promising, but could use a little flora to maybe soften it up.  The dining room is a very large space with a minimalist design in terms of tables, again could be warmed up a little, maybe some art or some flora.  There are beautiful fresh flowers on each of the tables and set up looks very clean and modern.  All staff were friendly and welcoming.    We were offered a warm bread basket and it was presented with a short explanation of each of the 3 types of bread.  The butter was brought out a little later and the presentation was inconsistently sloppy, about 2 tbsp of softened butter kind of smeared into a little dish (the edge of the dish was used to scrape off the butter), but the butter was delicious and soft.  We never received bread plates so there was that awkward holding of the bread in our hands until our food arrived.    I had the Arlington Garden salad ($11) with added Chicken ($6).  Salad is described as romaine/butter lettuce/swiss/Parmigiano Reggiano/almonds/cherry tomato/bacon/lemon vinaigrette.  The salad was unfortunately watery and bland, as if the lettuces were not properly rinsed and dried before dressing.  There was one cherry tomato sliced in half, and a scant spattering of slivered almonds, and some shredded and shaved cheese.  If there was bacon I did not see or taste it.  I did request additional dressing to add some flavor.    The dressing when tasted by itself was bland, ratio of acid to oil too low perhaps.  Chicken was a large precooked and unseasoned breast served cold and sliced.  Dry and not very well trimmed so there was gristle.  Partner had the chicken sandwich, it looked beautiful with a generous half of an avocado on their house made bread.  He said it was good but not great for a $17 sandwich.   If we return we will likely try the pizzas, they had some intriguing combinations that sounded appealing and their bread was the best part of our meal.\n-o4sbjrUSB1uZVFG7cFfqA\t2.0\t7\tCame with a group of 6 and had a pretty unpleasant experience.  The dishes were mostly strikeouts or singles, but there were a few home runs.  The service, it should be noted up front, was absolutely horrific, but I'll talk about the food first, since that's really all I care about.    Smoked potato gnocchi, lancaster co. lamb shoulder ragu, pecorino-- The gnocchi were heavy, gummy, and so smokey that they basically ruined the dish, overpowering the gamey lamb/tomato sauce, which on its own was pretty delicious.  It was also over salted, which made the pecorino's presence unpleasant.    Porchetta-filled agnolotti, sage, butter, black truffle, crushed amaretti.  The filling was dull and under salted, the agnolotti were clunky and poorly executed (way too thick and under cooked at the pinched edges), the butter sauce was heavy and needed more acid, the truffle was barely noticeable, the amaretti made the dish inappropriately sweet, and the sage didn't help a thing.    House cured goat salame with Caponata-- The highlight of the night.  The essence of goat meat, artfully heightened and distilled.  The flavor was powerfully game-y, but still completely pleasant, and was artfully balanced by a checkering of creamy white fat with a more delicate goat flavor reminiscent of fresh chevre.  The texture was awesomely unctuous.  The caponata was the perfect compliment, and turned this from a great item into a great dish.  The \"grilled rustic bread\" was scorched in places... why is this so often the case at otherwise competent places?  Maybe I'm just not \"rustic\" enough to appreciate the flavor of carbon?   Guitar Pasta with rock shrimp, lemon, mussels, zucchini, zucchini blossoms-- Another highlight.  The rock shrimp were extremely high quality, and perfectly cooked.  The tiny mussels were exceptionally intense, clean and oceanic.  The strips of zucchini in the sauce were fine.  The outstanding olive oil (delicate, floral and green) that anchored the sauce tied everything together with its suavity, and the lemon lent the dish a nice brightness.  The zucchini blossoms advertised on the menu were nowhere to be found-- a definite disappointment, but not a deal breaker considering this pasta's perfection.     N'Duja, spreadable spicy pork salame--Just as addictive as it sounds.  It comes with clove-y pickled carrots that take it to the next level.  The \"grilled rustic bread\" that came with this was even more scorched than the \"g.r.b.\" accompanying the goat salame.  Affettati misti, Salame selection--  Everything was excellent, especially the spreadable pork pate jawn and the various vegetable accouterments.  It's impossible not to respect a kitchen capable of house-curing this many varieties of salame this well.    Tagliatelle Al Sugo Di Coniglio, ribbon shaped pasta, braised Lancaster co. rabbit ragu--The rabbit meat and the tomato in the sauce combined into an amazing compound flavor, delicately sweet.  A completely pleasant dish.  Taccozzelle All'Aquilana- house-made abruzzese-style sausage, porcini, black truffle, navelli saffron--  Very interesting.  I would never have expected the flavor of truffle, porchini, safron and sausage to go together as well as they did in this dish, but in the end the combination was still a little strange, and in the end I think the dish added up to slightly less than the sum of its its parts.    The deserts all sucked, except for the semi-fredo.    As for the service... We got there 2 minutes before our 7:30 reservation time, and were told to wait at the bar until our table opened up.  46 minutes later (we kept count) we were finally able to sit down, and maybe 10 minutes after that a server finally made it over to our table.  By the time the first ap touched down it was almost 9:00.  While we were waiting at the bar the hostess didn't once check in with us .  I had to keep tracking her down to get a report on her non-progress.  Each time I was told \"10 minutes\".  I've worked in restaurants and completely understand how such a situation can come up, but not how it can go on for 46 minutes.      While we were waiting at the bar people were piling up behind us wanting to sit and drink, so we had to look like dicks because we weren't willing to wait outside in the 45 degree weather.  Of course the bartender didn't explain the situation to anyone, so I had to.  At the bar we ordered about $45 worth of drinks we wouldn't have wanted if it wasn't for the wait.  Of course nothing was comped-- in a place this obviously understaffed you can be sure that the priority is milking the customer for every drop.    Seating situation aside, the service was still pretty bad.  It was almost impossible to get a server to answer questions about the menu, and when the plates were brought to the table, she couldn't identify many of the items on the plate.    To add insult to injury they tacked on an automatic 20% tip.    Do yourself a favor and go to Osteria instead.\nYn_RTWi5XGpzDZYtfJW7ew\t1.0\t7\tTasty Tom's 9965 - 82 Ave Edmonton, Alberta.  What do you know, it's GROUPON time again!  My thrifty ass had a Groupon for $20.00 towards a meal at Tasty Tom's on Whyte Avenue in Edmonton.  Now let me tell you what I know about Tasty Tom's. Back in the day (the day being like, late '90′s), I lived just a few blocks from this joint and they had a menu that had a lot of German cuisine on it. Schnitzel, sauerkraut, European wieners, and great beer. When they opened, they gave me my first experience of a Cuban Sandwich. (Yes. Cuban. Who am I to question it?) Anyway, if you don't know what a Cuban sandwich is, it's pretty much a menage a trois of sliced pork, sliced ham and awesome swiss cheese on a ciabatta bed with mustard, pickles and other condiments in the mix. Then the whole sandwich was toasted panini style - waaaay before paninis were the shit.  I LOVED this sandwich. They at one point took it off the menu, which made me cry, but they said would still make it on MY request. (well, and probably others' requests as well, but I like to think I'm special.) That made me happy again.  Anyway, I moved away from the area and stopped going to Tasty Tom's but always had fond memories of the great times I had there with friends, and the fantastic food. So when the deal showed up in my Groupon email, I took it, anticipating another great meal... and at the back of my mind, the most faintest little itty bitty hope that I might again have my beloved Cuban sandwich. HEY! A girl can dream, right?  Even being under new management since the middle of 2013, (so no Cuban sandwich for me), the decor was about the same that I'd remembered. I wasn't really sure if that was good or bad, actually. Simple and unassuming, a mishmash of different tables and chairs, but clean. My friend and I were told we could pick our table, so we did, made ourselves comfortable, and service began.  After checking out both menus (breakfast that goes till 3, and lunch that goes til 5.......... odd, but ok), I decided upon the Schnitzel Burger (Breaded pork cutlet, Swiss, mustard, mayonnaise). My friend chose The Weiner Schnitzel (Breaded pork cutlet with lemon and potato salad). Those descriptions were taken verbatim, so I had to wonder, did they pay the printer by the word or something? Wouldn't one want to snazz up those descriptions just a tad??  Anyway.. here's my Schnitzel Burger: (sorry for the crappy phone pic!!)  (www.forkinfoodie.com)  Sooooo yeah. What can I say about this thing? I had asked her how thick the schnitzel was before ordering and she said it was a thick piece. Well, if by thick she meant really thin, then I believe she was correct. The burger came to the table looking ridiculous. Thin and long, the schnitzel overhung the bun by a few inches on either side - I mean, why not slice that beast (skinny beast) in half, bread both pieces and double-decker it?? Then, just to make it that extra bit worse, they used one slice of barely melted, cheap processed \"swiss\" cheese on top.  Culinary mastery right there, folks.  Taste? Sigh. It was booking first class on the bland wagon even with all its accompaniments in tow. I actually had to ask for extra mustard because the slight little swipe that was put on the bun was simply a tease. The cutlet was dry as a popcorn fart and simply flavorless,.... oh, unless you wanted to call a bit of old oil taste from the deep-fried breading, flavor.  The home fries on the plate were plentiful and super yummy, but the house brand \"ketchup\" was like watered down Heinz 57 mixed with weirdness. I didn't like it.  My friend's plate:  My friends meal was basically the exact same schnitzel that was on my burger, but on a plate.  And sadly, tasted the same way as well. Dry, dry, dry. So terribly overcooked. Even the slice of lemon couldn't save that poor pork cutlet. Now, I understand that schnitzel is not a dish that wins first place at the spice fair, but I've had really good schnitzel in the past. The flavor comes from the combination of a fresh-cut piece of meat, nice breading, and clean oil. Oh, and not frying the living crap out of it helps. This little cutlet was tired. VERY tired. The potato salad on the plate was pretty decent though, but not good enough.  Gone are the days of my beloved Cuban sandwich and excellent German food. The whole meal was a huge disappointment and not even close to being the tasty part of Tasty Tom's.  It seems as though management has given up and don't care about the quality of food they present. Here's a great tip: Just down the road a few blocks is K&K Foodliner. A German owned food import store and deli. They have everything you could want to make wicked schnitzel......  the REAL schmackhaft, or, tasty way.\n1_mmQv4YSwEhMAwlr3B7VQ\t2.0\t7\tI always find out new restaurants from Yelp, and this was on my radar. I had no idea where it was until a friend was raving about how much he likes the food here. I found out it was next to Anna's on McCarran and 4th Street, right down the street from my employer.   I showed up yesterday at 3PM, but they were closed. They do breakfast (until 2pm) and dinner now according to the door.   I got lunch today at 12PM so I knew they would be open and arrived. There was only 1 couple dining when I arrived, so not busy. It's not a very big place and very bare bones looking. The server sat me next to the couple, and I guess they were friendly as she spent much time chatting with them, but I don't understand Spanish.    I asked about best dishes, as usual, per new places, she said breakfast or lunch, I honed in on breakfast, I was hoping a breakfast favorite was also popular here, but none of my favorites were mentioned, so I jumped to lunch. She mentioned more that didn't sound great except the jalapeno burger, but that didn't sound good today, but then she said steak sandwich ($10.99), DING DING we have a WINNER!    I then asked for recommended sides, she mentioned it came with fries, which I wasn't excited about but then found out they were sliced fresh, so I got more excited. While I was waiting another diner arrived. I waited for a reasonable amount of time and my food came out right after the other diner, but she had french toast, eggs, and bacon (one of the favorites here mentioned on the breakfast side).   My food looked great on the plate, she even asked how I wanted my steak cook, it looked a perfect medium rare. Sometimes food looks better than the actual flavor and this was the case. The fries were okay, above average, loved the skins on them, but the seasoning was missing and that satisfaction you get from a well-done fry! The fries are not the kind you crave or think about again.    The steak sandwich was okay, again missing seasoning big time. The first part of the sandwich was better than the second, but it's very messy, lots of juice and oil dripping and they provide cloth napkins. After she checked on me, which was a much longer time than usual, due to the dining and social visit that was happening, I asked for paper napkins, which were provided. I quickly blew through those as they were paper thin, and I needed more. I finally got another visit towards the end and then received more than I needed. I rarely use salt shakers, and I was really dousing my food with salt today, both the sandwich and fries.   The steak made quite a mess too as the first section, I could eat like a few bites like a burger, or a steak sandwich. Shortly after a couple bites it got really tough, and chewy, fatty and tendon parts. I was tearing the sandwich apart trying to eat it, then just had to eat everything separate, and leave the inedible and fatty parts on the plate. Even the cheese and sauteed onions and mushrooms didn't have much flavor, everything was just even okay and slightly better with my salt shaker, but not anything I would order again, and YES I am talking about a steak!   I needed to get a quick exit, as I had an appointment for work, so I had my wallet out, my card ready, but again the waitress was still being friendly with the first couple, so I had to walk up to her to check out. The place is WAY TOO casual for me, and I didn't enjoy the bare-bones surroundings and small place.  If the food is fantastic across the board it can override factors, but the service was not on point either. This place is just not my style. I might go back with my friend who enjoys the food, but I wouldn't go back on my own to dine, as I have much better options, that I get a sense of satisfaction after, and not just feeling awkward about my dining experience.\n7Xgzk0WVgMGAbvnvNn8ijA\t2.0\t7\tThe service department is friendly but not worth the extra cost.  When we purchased my company vehicle here we were sold on the maintenance plan to make everything seamless and easy...um... not so much.  Unlike many other car manufacturers or dealers, there is no competitive edge to paying the higher dealer prices to service your car here.     Allow me to explain why I feel so let down.  I have owned many vehicles, and I have always been a firm believer in following the manufacturers recommended prescribed maintenance plan.  Which allows you to catch things before they become a problem or damage your vehicle.  The manufacturer generally has a specific \"recipe\" of services they recommend at different odometer milestones.  And only at your authorized dealer can you really follow that plan and know you are taking the best possible care of your vehicle.  Prices are a little high sometimes, but you generally get what you pay for!  Technicians that specialize on your brand of vehicle and customer service unmatched anywhere else.  Well, that's not what you get at the Terry Lee Honda Service department.  You may be greeted with a smile, but the customer service ends there.  You will still pay high prices, but you may as well go to jiffy lube and save yourself some time AND money.  If I am going to pay dealer prices for an oil change I expect the experience to have minimal impact on my schedule and be ultra-convenient.  When dropping off my personal vehicle at the Volvo dealership for something simple like an oil change or tire rotation, or something more in depth and costly, I am consistently treated with respect and usually there for less than 5 minutes.  I just pop in, hand them my keys, and they hand me the keys to a loaner car that is comparable to my own, and i'm on my way.  They give me a call to let me know when it's done and at my convenience I go and pick it up.  Not at Terry Lee Honda!  Even though my oil change and tire rotation costs the same as my Volvo's, you have to sit and wait in an overcrowded waiting area and listen to crying children and wait as long as it takes.  They don't take appointments unless you are having something major done so keep your fingers crossed and hope there isn't an excessive wait time.  They offer a shuttle but what good is that going to do unless you live/work down the street?  I already have to drive half an hour minimum just to get to their dealership that by the time I would get anywhere, I'd have to head straight back.    I will say that the sales side of things was pretty great, other than the fact that they led us to believe that the maintenance plan was a lot better than it really is (it only covers oil changes.. and increases your monthly payment by the cost of an oil change each month)  and that it would be a perfect fit for a busy employee on a company vehicle.  But they did get us a great deal and made the purchasing process pretty painless.  I am very happy with the car and feel that it meets the unique needs of our business.  Honda makes a fantastic product.  So to summarize, buy at Terry Lee Honda.. and service your car somewhere else!\nvOcQR5X-o6vsfiezbRS1hw\t1.0\t7\tMaybe because it was NYE?  But Etch was a terrible experience.  Everything from food to service were terrible.  To be fair, if it didn't have such high recognition I probably wouldn't be as harsh, but if you are one of the best of Nashville, then for Nashville's sake, do better!  Hubby and I were in town for NYE, another top notch restaurant was closed for the week so we got a reservation at Etch.  It was a prix fixe four course dinner.  Now, let's break everything down piece by piece.  Decor & Restaurant: 3 stars.  The decor was lovely, high ceilings, open kitchen and nicely lit, this itself would have been 5 stars.  However, the seating was horrid.  Management had placed too many tables for the space for a restaurant of this caliber; you know the tables needed to be spaced out more when every time a server comes through, my chair and the person sitting behind me's chair gets bumped.  Service: 3 stars.  If I ranked niceness alone, the staff would get 5 stars.  But the quality of service/training was not up to par.  Mistake 1, servers bought us our entree before our appetizers came; I told him we haven't even had our appetizers and then they realized that the entrees were meant for another table...  Mistake 2, after our actual entrees were served, our server cleared the plates and dirty utensils and left the clean dessert utensils...then another server comes by, takes those clean dessert utensils away.  My husband and I literally looks at each other in disbelief...as I'm desperately looking around for help, one of the other servers noticed the error and stoped the server that took our utensils and made him put it back.  Food: 1 star.  The only 5 star item on the prix-fixe menu was the lemon mousse my husband got with his dinner...the presentation was STUNNING, the texture and flavor were perfect.  Now, sadly on to the bad...  Appetizers:   Me-Prawns with fried (shitake?) mushrooms.  The mushroom was saturated with batter and over fried...it hid the natural woody-sweetness of the mushroom...it was so coated in batter than I honestly couldn't tell you if it what kind of mushroom it was...  The prawns were sweet and delish, however again, over cooked.  While the flavor and quality of the prawns were amazing, the texture was rubbery. Hubs-Duck & butternut squash in dough wrap.  Again, too much dough...it was so thickly applied that it honestly hid any duck that was present.  The duck itself, however was good...but it was overpowered by the dough and the butternut squash (?) layer.  Salad: Me: Prosciutto with brussel sprouts and greens.  The prosciutto was fine, nothing to write home about.  The salad was fine until I started chewing on salt crystals that were like rock candy.  I enjoy a good rock candy but not hunks of salt in my salad.  I took another bite, thinking maybe the first bite was a fluke and BAM, several other hunks of salt...WTF!?  So I then was like, maybe let my husband try and see if it's the same...he did, and he also got chunks of salt.  It was so bad that I only ate 1/4 of the salad before it was taken away.  Lastly, the brussel sprouts were NOT CUT...yes, you read that correct, they literally served me whole burssel sprouts on a salad. Hubs: Beet salad with blue (?) cheese semifredo.  The semifredo was actually well done...I was very pleasantly surprised.  While in Florence, we dined at their 3-Michelin starred restaurant and they attend a cheese based semifredo and it was HORRID.  But bravo Etch, you guys managed to pull if off decently well...however, the beets on the beet salad were not cut properly.  Each slice was about 1/2 in thick.  But overall, the salad was decent.  Entree: Me: Venison.  The venison was cooked medium rare, as I had requested and they did a great job.  The only unfortunate issue (and I was hoping this would be a flawless dish due to the amazing way they prepared the meat) was that there were A LOT OF GRISSEL on the venison filet!  The entire dish was about 6 pieces of venison and 2 of the 6 had so much grissel that I could not even cut through it. Hubs:  Scallops.  Of the 3 scallops that came, one was NOT FRESH.  I was honestly at this point appalled. So we'll just end there.  Dessert: Me: Chocolate bar.  Honestly, it was literally a chocolate bar...I think it may have come out of a wrapper, who knows. Hubs: Lemon Mouse.  OMG this was STUNNING and DELICIOUS!  WHERE DID THIS COME FROM!?  The presentation was dramatic with a dark red brush stroke against a beautiful dish, with the lemon mouse sitting 3/4 of the way on the dish.  The light airy and stunningly beautiful yellow and cream hue of the lemon mouse stood out BEAUTIFULLY against the berry colored brush stroke.  The texture of the mouse was smooth with structure.  The flavoring was perfect balance of fresh lemon and subtle sweetness.  BRAVO.  Coffee: Me: None. Hubs: Cappuccino.  His cappuccino came out in a COFFEE MUG...like a straight up coffee mug you would find in a hotel's continental breakfast line up.\nAndOleTmOddTfxITcSamZQ\t2.0\t7\tA very mixed review: I used to be a huge fan of Mission. I went back many times for their happy hour specials, however I had one experience with a bad waitress and now I have a bad taste in my mouth about the place. On one occasion, my friends and I asked for another round of drinks (it would be our second round that day) but the waitress stated that she could serve everyone except for me. I wasn't intoxicated at all and I couldn't even feel the first drink in my system. I was conducting myself in a more than appropriate manner, my speech was on point and I was so polite to our waitress. My friends and I were beyond baffled that I was cut off and the waitress refused to give me an explanation as to why I wasn't allowed another drink. She was very rude about it. My very best guess is that occasionally my eyes roll back in my head for a second when I speak with people but that's an unconscious tick that I have no control over.   Aside from that experience, Mission is a great taqueria that offers a great atmosphere, delicious food, and awesome drinks. They are the sister restaurant to the Oyster House which is downstairs. Mission has a light and open airy feel highlighted with fun esthetic elements like neon pink lights and floral tiles. I love that they have regular tables, long tables, lounge-style booths, and a bar. They have foosball tables which makes it fun for a group. During happy hour they offer $3 coronas, $2 tacos, and $6 margaritas. On Tuesday nights from 5:00 - 11:00 they offer 1 free house Margie with any full priced tacos. I recommend the house margie and the sangria (tastes like Christmas). The chips and quac are a must and they have excellent tacos too. The crowd is typically hipster and well-dressed so be prepared for that. A lot of people come here straight from work as well. I also support the co-ed bathroom. It's really unfortunate how much I love this establishment but I now have no respect for their staff due to that one experience that now leaves me reluctant to go back.\nE5aR-Ls-McTNuLhNEuO-Yw\t1.0\t7\tI've dined in my share of upscale restaurants featuring fine dining throughout my years and as far as I am concerned, you can keep Lacroix, which is located in the affluent Rittenhouse Square area and inside the swanky Rittenhouse Hotel.  We were greeted by a very friendly hostess, Allyson, who was just as sweet and friendly as can be. Our wait staff of say five, were on top of our every wish and desire and management made it a point to stop by to welcome us and chat a bit. We had tried our best to get a reservation for their famous Sunday brunch, but to no avail, which is something I may still consider trying sometime.  We were there for lunch, a very few tables were seated during our visit, the dining room is classy, with a beautiful bar and windows with perfect views for people watching. The prices for the portions and quality is what left me baffled, how do they get away with it, I mean are they kept alive by unsuspecting hotel guests or folks that love to blow a huge wad of money and still walk away hungry? If it had not been for the bread, that is exactly what would have happened.  I asked to order a glass of wine and the waiter asked what I would like, instead of offering me a wine list. I said, well I'm not sure what all you have but a nice chardonney would be fine. He then said from California? Lol, I said yes that would be fine, I mean please, present some kind of a list or at least have knowledge of choices readily available. The sommelier presented an almost empty bottle and allowed me to sniff, swirl and taste before pouring my incredibly expensive half glass of wine. Hubs snickered, I was tempted to tip the last swallow that was left in the bottle into my glass, but restrained myself.  Michael had the grilled Caesar salad to start, which were three leaves from the heart of the romaine, whole and topped with grilled red onion and parmesan cheese. The portion was small, but the flavor was good.   Once you have ordered, you are presented with a really great basket of hot bread, the food took awhile to come out, so we pretty well filled up on bread, which was our own fault. Since I had ordered the cheese plate another basket came out, loaded with more bread and crackers and well before the cheese plate, so we dined on more bread.  The cheese plate, I indulged myself with the larger one which came with 6 cheeses and the waiter was kind enough to ask for my likes and dislikes in cheeses, telling him I loved them all but was partial to bleu's, brie, camembert, cheddars and so on.  Twenty-eight dollars gave me and I don't even know how to describe this, one wonderful bleu, and a nice variety of cows milk, sheep milk and goat milk cheeses. What was the problem then? I'm not sure why the huge basket of bread or the large crackers, all of the cheese would not have even covered one cracker! I'm serious! I'm trying to visually picture something to describe the size and thickness and a postage stamp with the thickness of a nickle comes to mind.   So, not too many choices for the main dish, we were both torn between the cheeseburger or the lobster roll and we each decided to splurge on the lobster roll. Now, mind you that I lived in New England for eight years and that I have often visited. I also make them at home when I get hungry for one.  Twenty five dollars each for the skimpiest, funniest, yes I'm laughing, \"lobster roll\" I have ever seen! First of all, they make their own rolls, dry, stale short rolls. Then they barely and I do mean barely make a notch out of the top of the roll, to then top it with lettuce and \"lobster salad\"?   This lobster salad was loaded with sliced grapes, I mean loaded and I would not be opposed to the slight addition of sliced grapes, as it was different, but where's the lobster? They could not have diced it any smaller, it was the size of chopped onions, the grapes were larger and so very, very little meat. I actually was so tired of bread at that point that I dumped the lobster salad onto my plate and if it would have filled a quarter of a cup, I would have been surprised.  The lobster roll comes with a side of homemade tarragon potato chips, which were okay, they need to lay them out a bit more before seasoning, as some were unseasoned and some were way over seasoned.  Hubs then ordered the large tier of six desserts from the pastry cart. This was a good deal at twelve dollars and a nice small sampling of desserts. He still walked out hungry and he ate that small lobster roll. We walked out, with a whole lot less in our pocket, shrugged our shoulders and said okay, we've been to Lacroix.  By the way, the valet has a field day readjusting the drivers seat. I can see moving it back or forth, but pumping it higher, reclining it?\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=8"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774320596807_885041081","id":"paragraph_1774320596807_885041081","dateCreated":"2026-03-23T22:49:56-0400","dateStarted":"2026-03-23T22:53:03-0400","dateFinished":"2026-03-23T22:53:25-0400","status":"FINISHED"},{"text":"%pyspark\nimport pyspark.sql.functions as F\nfrom pyspark.sql.functions import col, udf, explode\nfrom pyspark.sql.types import ArrayType, StringType\n\n# Predefined food dictionary\nfood_dict = [\n    \"noodles\",\"dumpling\",\"dumplings\",\"fried rice\",\"rice\",\"soup\",\n    \"dim sum\",\"wonton\",\"wontons\",\"tofu\",\"beef\",\"chicken\",\"pork\",\n    \"shrimp\",\"lobster\",\"duck\",\"spring roll\",\"egg roll\",\"hot pot\",\n    \"hotpot\",\"noodle\",\"broth\",\"bun\",\"buns\",\"congee\",\"chow mein\",\n    \"lo mein\",\"bok choy\",\"mapo\",\"peking\",\"szechuan\",\"kung pao\"\n]\nfood_bc = sc.broadcast(food_dict)\n\n# Parse business table\nbiz_raw = spark.table(\"yelp.json_business\")\nbiz = biz_raw.withColumn(\"data\", F.from_json(F.col(\"json_body\"),\n    spark.read.json(biz_raw.rdd.map(lambda r: r.json_body)).schema)).select(\"data.*\")\n\n# Get top 5 Chinese restaurants by review count\nchinese_biz = biz.filter(\n    (col(\"categories\").contains(\"Chinese\")) &\n    (col(\"categories\").contains(\"Restaurants\"))\n).orderBy(col(\"review_count\").desc()).limit(5)\n\nprint(\"=== Top 5 Chinese Restaurants ===\")\nchinese_biz.select(\"business_id\",\"name\",\"city\",\"review_count\",\"stars\").show(truncate=False)\n\ntop5_ids = [row.business_id for row in chinese_biz.select(\"business_id\").collect()]\n\n@udf(returnType=ArrayType(StringType()))\ndef find_food_items(text):\n    if not text:\n        return []\n    text_lower = text.lower()\n    return [item for item in food_bc.value if item in text_lower]\n\nreview_df = spark.table(\"yelp.review\")\n\nresult = review_df.filter(col(\"rev_business_id\").isin(top5_ids)) \\\n    .withColumn(\"food_items\", find_food_items(col(\"rev_text\"))) \\\n    .select(explode(col(\"food_items\")).alias(\"Menu Item\")) \\\n    .groupBy(\"Menu Item\").count() \\\n    .withColumnRenamed(\"count\", \"Mentions\") \\\n    .orderBy(col(\"Mentions\").desc())\n\nprint(\"=== Most Mentioned Menu Items in Top 5 Chinese Restaurants ===\")\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-23T22:54:48-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 5 Chinese Restaurants ===\n+----------------------+--------------------------------+------------+------------+-----+\n|business_id           |name                            |city        |review_count|stars|\n+----------------------+--------------------------------+------------+------------+-----+\n|ytynqOUb3hjKeJfRj5Tshw|Reading Terminal Market         |Philadelphia|5721        |4.5  |\n|AGlh4ZDv6jnoiYfz7At9mw|Dim Sum Garden                  |Philadelphia|2672        |4.0  |\n|ntiIq1FNqduOyyowMFGh5A|Nan Zhou Hand Drawn Noodle House|Philadelphia|2188        |4.0  |\n|kZ1q0K13tFYG_ZJrVvsJHA|Sampan                          |Philadelphia|2000        |4.0  |\n|nIAbuktMEzVjT4P9pG89rQ|Buddakan                        |Philadelphia|1561        |4.0  |\n+----------------------+--------------------------------+------------+------------+-----+\n\n=== Most Mentioned Menu Items in Top 5 Chinese Restaurants ===\n"},{"type":"TABLE","data":"Menu Item\tMentions\ndumpling\t3796\ndumplings\t3490\nrice\t3328\nsoup\t3288\nnoodle\t2847\npork\t2588\nnoodles\t2284\nbeef\t1983\nchicken\t1497\ndim sum\t1197\nbun\t1124\nshrimp\t1064\nbroth\t1058\nfried rice\t950\nduck\t725\nbuns\t672\nlobster\t292\nwonton\t287\nspring roll\t245\ntofu\t236\npeking\t170\nlo mein\t133\nwontons\t94\nbok choy\t92\nkung pao\t81\nmapo\t76\nszechuan\t72\negg roll\t65\nhot pot\t14\nchow mein\t9\ncongee\t4\nhotpot\t3\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=9"},{"jobUrl":"http://node-master:4040/jobs/job?id=10"},{"jobUrl":"http://node-master:4040/jobs/job?id=11"},{"jobUrl":"http://node-master:4040/jobs/job?id=12"},{"jobUrl":"http://node-master:4040/jobs/job?id=13"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774320783393_435605840","id":"paragraph_1774320783393_435605840","dateCreated":"2026-03-23T22:53:03-0400","dateStarted":"2026-03-23T22:54:48-0400","dateFinished":"2026-03-23T22:55:15-0400","status":"FINISHED"},{"text":"%pyspark\n","user":"anonymous","dateUpdated":"2026-03-23T23:15:51-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774322151704_757190967","id":"paragraph_1774322151704_757190967","dateCreated":"2026-03-23T23:15:51-0400","status":"READY"}],"name":"review","id":"2MM6VHUCV","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/review"}`