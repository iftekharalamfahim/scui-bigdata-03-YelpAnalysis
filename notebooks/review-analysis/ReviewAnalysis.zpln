ol\n8280748\t2282743\t3485476\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=2"},{"jobUrl":"http://node-master:4040/jobs/job?id=3"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774257173041_2078084850","id":"paragraph_1774257173041_2078084850","dateCreated":"2026-03-23T05:12:53-0400","dateStarted":"2026-03-23T11:00:52-0400","dateFinished":"2026-03-23T11:00:54-0400","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql.functions import year, col, desc, rank\nfrom pyspark.sql.window import Window\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.groupBy(\n    col(\"rev_user_id\").alias(\"User ID\"),\n    year(col(\"rev_date\")).alias(\"Year\")\n).count() \\\n .withColumnRenamed(\"count\", \"Review Count\") \\\n .orderBy(\"Year\", desc(\"Review Count\"))\n\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T05:20:25-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"Year","index":1,"aggr":"sum"}],"groups":[],"values":[{"name":"Review Count","index":2,"aggr":"sum"},{"name":"Year","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"User ID\tYear\tReview Count\nn-lBS02-3yvlY5Q91mmwDA\t2005\t171\n3MYdpmHeNwC6FquRWi3YOg\t2005\t60\niUeZhkI0OK0