g></div>\n"}]}},{"text":"%pyspark\nfrom pyspark.sql.functions import col, lower, regexp_replace, explode, split\nfrom nltk.corpus import stopwords\nfrom pyspark.sql.types import BooleanType\nfrom pyspark.sql.functions import udf\n\nstop_words = set(stopwords.words(\"english\"))\nstop_bc = sc.broadcast(stop_words)\n\nis_valid = udf(lambda w: bool(w and len(w) > 2 and w not in stop_bc.value), BooleanType())\n\ndf = spark.table(\"yelp.review\")\n\nwords_df = df.select(\n    explode(\n        split(regexp_replace(lower(col(\"rev_text\")), \"[^a-z\\\\s]\", \"\"), \"\\\\s+\")\n    ).alias(\"word\")\n).filter(col(\"word\") != \"\")\n\nresult = words_df.filter(is_valid(col(\"word\"))) \\\n    .groupBy(\"word\") \\\n    .count() \\\n    .withColumnRenamed(\"word\", \"Word\") \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(20)\n\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-23T11:02:50-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=8"},{"jobUrl":"http://node-master:4040/jobs/job?id=9"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774278107023_646621730","id":"paragraph_1774278107023_646621730","dateCreated":"2026-03-23T11:01:47-0400","status":"FINISHED","focus":false,"dateFinished":"2026-03-23T11:12:53-0400","dateStarted":"2026-03-23T11:02:50-0400","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Word\tFrequency\nfood\t3595656\ngood\t3277585\nplace\t3153865\ngreat\t3055940\nservice\t2296961\ntime\t2230436\nlike\t2166201\nget\t2117153\none\t2112498\nback\t2024895\nwould\t1973805\nreally\t1600200\nalso\t1505049\ngot\t1349984\neven\t1223679\nnice\t1215974\nbest\t1210991\ndont\t1210343\nwell\t1203387\nordered\t1151679\n"}]}},{"text":"%pyspark\nfrom pyspark.sql.functions import col, lower, regexp_replace, explode, split, udf\nfrom pyspark.sql.types import BooleanType\nfrom nltk.corpus import stopwords\n\nstop_words = set(stopwords.words(\"english\"))\nstop_bc = sc.broadcast(stop_words)\nis_valid = udf(lambda w: bool(w and len(w) > 2 and w not in stop_bc.value), BooleanType())\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.filter(col(\"rev_stars\") > 3) \\\n    .select(explode(split(regexp_replace(lower(col(\"rev_text\")), \"[^a-z\\\\s]\", \"\"), \"\\\\s+\")).alias(\"word\")) \\\n    .filter(col(\"word\") != \"\") \\\n    .filter(is_valid(col(\"word\"))) \\\n    .groupBy(\"word\").count() \\\n    .withColumnRenamed(\"word\", \"Word\") \\\n    .withColumnRenamed(\"count\", \"Frequency\") \\\n    .orderBy(col(\"Frequency\").desc()) \\\n    .limit(10)\n\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-23T11:27:33-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=14"},{"jobUrl":"http://node-master:4040/jobs/job?id=15"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774278864343_222196270","id":"paragraph_1774278864343_222196270","dateCreated":"2026-03-23T11:14:24-0400","status":"FINISHED","focus":false,"dateFinished":"2026-03-23T11:33:35-0400","dateStarted":"2026-03-23T11:27:33-0400","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Word\tFrequency\ngreat\t2579587\nfood\t2204085\ngood\t2181781\nplace\t2109749\nservice\t1354048\ntime\t13