{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql.functions import col, from_json\r\nimport pyspark.sql.functions as F\r\n\r\n# Parse json_review\r\ndf_raw = spark.table(\"yelp.json_review\")\r\ndf = df_raw.withColumn(\"data\", from_json(col(\"json_body\"),\r\n    spark.read.json(df_raw.rdd.map(lambda r: r.json_body)).schema)).select(\"data.*\")\r\n\r\n# Rename columns to match your friend's schema\r\nreview_df = df.select(\r\n    col(\"review_id\").alias(\"rev_id\"),\r\n    col(\"user_id\").alias(\"rev_user_id\"),\r\n    col(\"business_id\").alias(\"rev_business_id\"),\r\n    col(\"stars\").alias(\"rev_stars\"),\r\n    col(\"date\").alias(\"rev_date\"),\r\n    col(\"text\").alias(\"rev_text\"),\r\n    col(\"useful\").alias(\"rev_useful\"),\r\n    col(\"funny\").alias(\"rev_funny\"),\r\n    col(\"cool\").alias(\"rev_cool\")\r\n)\r\n\r\n# Save as Hive table\r\nreview_df.write.mode(\"overwrite\").saveAsTable(\"yelp.review\")\r\nprint(\"Table created successfully!\")\r\nspark.sql(\"SELECT * FROM yelp.review LIMIT 3\").show()","user":"anonymous","dateUpdated":"2026-03-23T04:57:36-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Table created successfully!\n+--------------------+--------------------+--------------------+---------+-------------------+--------------------+----------+---------+--------+\n|              rev_id|         rev_user_id|     rev_business_id|rev_stars|           rev_date|            rev_text|rev_useful|rev_funny|rev_cool|\n+--------------------+--------------------+--------------------+---------+-------------------+--------------------+----------+---------+--------+\n|MmmrqbdupYBJq9jnl...|TjD2S66AWxlKsPSQB...|znK6tMeegKf9YnGut...|      5.0|2021-04-16 22:02:21|Great little spot...|         0|        0|       0|\n|1_uWX0bBJNnZjPEcp...|Vtfxxq3nxdYHRiH6O...|UxwpCVLgPWCeaRyet...|      5.0|2021-01-03 21:54:48|James was super k...|         0|        0|       0|\n|WVAEE47MnM3Sv2cvM...|ZDw_qN5Fy6PE0gdbV...|eVI64EQymywsvMLmD...|      5.0|2020-11-01 19:50:03|By far the best i...|         0|        0|       0|\n+--------------------+--------------------+--------------------+---------+-------------------+--------------------+----------+---------+--------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=7"},{"jobUrl":"http://node-master:4040/jobs/job?id=8"},{"jobUrl":"http://node-master:4040/jobs/job?id=9"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774254805385_1635272813","id":"paragraph_1774254805385_1635272813","dateCreated":"2026-03-23T04:33:25-0400","dateStarted":"2026-03-23T04:57:36-0400","dateFinished":"2026-03-23T04:59:42-0400","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql.functions import date_format, col\n\ndf = spark.table(\"yelp.review\")\n\nresult = df.groupBy(date_format(col(\"rev_date\"), \"yyyy\").alias(\"Year\")) \\\n           .count() \\\n           .withColumnRenamed(\"count\", \"Review Count\") \\\n           .orderBy(\"Year\")\n\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-23T11:33:43-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"Year","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Review Count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT"