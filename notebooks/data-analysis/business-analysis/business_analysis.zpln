/span></button><strong>Output is truncated</strong> to 1000 rows. Learn more about <strong>zeppelin.spark.maxResult</strong></div>\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=295"},{"jobUrl":"http://node-master:4040/jobs/job?id=296"},{"jobUrl":"http://node-master:4040/jobs/job?id=297"},{"jobUrl":"http://node-master:4040/jobs/job?id=298"},{"jobUrl":"http://node-master:4040/jobs/job?id=299"},{"jobUrl":"http://node-master:4040/jobs/job?id=300"},{"jobUrl":"http://node-master:4040/jobs/job?id=301"},{"jobUrl":"http://node-master:4040/jobs/job?id=302"},{"jobUrl":"http://node-master:4040/jobs/job?id=303"},{"jobUrl":"http://node-master:4040/jobs/job?id=304"},{"jobUrl":"http://node-master:4040/jobs/job?id=305"},{"jobUrl":"http://node-master:4040/jobs/job?id=306"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774316481621_1724015442","id":"paragraph_1774316481621_1724015442","dateCreated":"2026-03-24T09:41:21+0800","dateStarted":"2026-03-24T09:43:02+0800","dateFinished":"2026-03-24T09:43:17+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\n\n# Explode categories into individual rows\ncategories_df = business_df \\\n    .filter(F.col(\"categories\").isNotNull()) \\\n    .select(\n        \"business_id\",\n        F.explode(F.split(F.col(\"categories\"), \",\")).alias(\"category\")\n    ) \\\n    .select(\n        \"business_id\",\n        F.trim(F.col(\"category\")).alias(\"category\")\n    )\n\n# Self join to get pairs\npairs_df = categories_df.alias(\"a\") \\\n    .join(categories_df.alias(\"b\"), \"business_id\") \\\n    .filter(F.col(\"a.category\") < F.col(\"b.category\")) \\\n    .select(\n        F.col(\"a.category\").alias(\"Category 1\"),\n        F.col(\"b.category\").alias(\"Category 2\")\n    )\n\nresult = pairs_df \\\n    .groupBy(\"Category 1\", \"Category 2\") \\\n    .count() \\\n    .withColumnRenamed(\"count\", \"Co-occurrence Count\") \\\n    .orderBy(\"Co-occurrence Count\", ascending=False) \\\n    .limit(10)\n\nprint(\"=== Top 10 Co-occurring Category Pairs ===\")\nresult.show(10)\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T09:44:36+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"Category 1","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Category 2","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 10 Co-occurring Category Pairs ===\n+--------------------+-----------+-------------------+\n|          Category 1| Category 2|Co-occurrence Count|\n+--------------------+-----------+-------------------+\n|                Food|Restaurants|              15472|\n|                Bars|  Nightlife|              11065|\n|           Nightlife|Restaurants|               8723|\n|         Restaurants| Sandwiches|               8366|\n|                Bars|Restaurants|               8337|\n|American (Traditi...|Restaurants|               8139|\n|               Pizza|Restaurants|               7093|\n|        Coffee & Tea|       Food|               6703|\n|           Fast Food|Restaurants|               6472|\n|  Breakfast & Brunch|Restaurants|               6239|\n+--------------------+-----------+-------------------+\n\n"},{"type":"TABLE","data":"Category 1\tCategory 2\tCo-occurrence Count\nFood\tRestaurants\t15472\nBars\tNightlife\t11065\nNightlife\tRestaurants\t8723\nRestaurants\tSandwiches\t8366\nBars\tRestaurants\t8337\nAmerican (Traditional)\tRestaurants\t8139\nPizza\tRestaurants\t7093\nCoffee & Tea\tFood\t6703\nFast Food\tRestaurants\t6472\nBreakfast & Brunch\tRestaurants\t6239\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=307"},{"jobUrl":"http://node-master:4040/jobs/job?id=308"},{"jobUrl":"http://node-master:4040/jobs/job?id=309"},{"jobUrl":"http://node-master:4040/jobs/job?id=310"},{"jobUrl":"http://node-master:4040/jobs/job?id=311"},{"jobUrl":"http://node-master:4040/jobs/job?id=312"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774316546415_601004984","id":"paragraph_1774316546415_601004984","dateCreated":"2026-03-24T09:42:26+0800","dateStarted":"2026-03-24T09:44:12+0800","dateFinished":"2026-03-24T09:44:19+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\nreview_df = spark.table(\"review\")\n\nresult = review_df \\\n    .groupBy(\"business_id\") \\\n    .agg(\n        F.count(\"stars\").alias(\"review_count\"),\n        F.stddev(\"stars\").alias(\"std_dev\"),\n        F.avg(\"stars\").alias(\"avg_rating\")\n    ) \\\n    .filter(F.col(\"review_count\") >= 100) \\\n    .join(business_df.select(\"business_id\", \"name\"), \"business_id\") \\\n    .select(\n        F.col(\"name\").alias(\"Business Name\"),\n        F.col(\"review_count\").alias(\"Review Count\"),\n        F.round(\"avg_rating\", 2).alias(\"Average Rating\"),\n        F.round(\"std_dev\", 2).alias(\"Std Deviation\")\n    ) \\\n    .orderBy(\"Std Deviation\", ascending=False) \\\n    .limit(20)\n\nprint(\"=== Polarizing Businesses ===\")\nresult.show(20)\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T09:44:53+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completi