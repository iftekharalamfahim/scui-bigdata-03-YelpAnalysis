{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\n# Table: business\r\ndf = spark.table(\"business\") \\\r\n    .groupBy(\"name\") \\\r\n    .count() \\\r\n    .orderBy(F.desc(\"count\")) \\\r\n    .limit(20)\r\n\r\nprint(\"=== Top 20 Most Common Merchants ===\")\r\ndf.show(20, truncate=False)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: name, values: count)","user":"anonymous","dateUpdated":"2026-03-24T09:21:15+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":309,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"Restaurant Count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Most Common Merchants ===\n+---------------------+-----+\n|name                 |count|\n+---------------------+-----+\n|Starbucks            |724  |\n|McDonald's           |703  |\n|Dunkin'              |510  |\n|Subway               |459  |\n|Taco Bell            |365  |\n|CVS Pharmacy         |345  |\n|Walgreens            |341  |\n|Burger King          |338  |\n|Wendy's              |331  |\n|Wawa                 |307  |\n|Domino's Pizza       |295  |\n|The UPS Store        |281  |\n|Pizza Hut            |272  |\n|Enterprise Rent-A-Car|232  |\n|Papa John's Pizza    |196  |\n|Great Clips          |185  |\n|Jimmy John's         |175  |\n|US Post Office       |174  |\n|KFC                  |171  |\n|Chick-fil-A          |162  |\n+---------------------+-----+\n\n"},{"type":"TABLE","data":"name\tcount\nStarbucks\t724\nMcDonald's\t703\nDunkin'\t510\nSubway\t459\nTaco Bell\t365\nCVS Pharmacy\t345\nWalgreens\t341\nBurger King\t338\nWendy's\t331\nWawa\t307\nDomino's Pizza\t295\nThe UPS Store\t281\nPizza Hut\t272\nEnterprise Rent-A-Car\t232\nPapa John's Pizza\t196\nGreat Clips\t185\nJimmy John's\t175\nUS Post Office\t174\nKFC\t171\nChick-fil-A\t162\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=250"},{"jobUrl":"http://node-master:4040/jobs/job?id=251"},{"jobUrl":"http://node-master:4040/jobs/job?id=252"},{"jobUrl":"http://node-master:4040/jobs/job?id=253"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774232110300_737419269","id":"paragraph_1774232110300_737419269","dateCreated":"2026-03-23T10:15:10+0800","dateStarted":"2026-03-24T09:21:15+0800","dateFinished":"2026-03-24T09:21:25+0800","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n# Table: business\ndf = spark.table(\"business\") \\\n    .groupBy(\"city\") \\\n    .count() \\\n    .orderBy(F.desc(\"count\")) \\\n    .limit(10)\n\nprint(\"=== Top 10 Cities with Most Merchants ===\")\ndf.show(10, truncate=False)\nz.show(df)\n# Chart suggestion: bar chart (keys: city, values: count)\n","user":"anonymous","dateUpdated":"2026-03-24T09:22:50+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 10 Cities with Most Merchants ===\n+-------------+-----+\n|city         |count|\n+-------------+-----+\n|Philadelphia |14569|\n|Tucson       |9250 |\n|Tampa        |9050 |\n|Indianapolis |7540 |\n|Nashville    |6971 |\n|New Orleans  |6209 |\n|Reno         |5935 |\n|Edmonton     |5054 |\n|Saint Louis  |4827 |\n|Santa Barbara|3829 |\n+-------------+-----+\n\n"},{"type":"TABLE","data":"city\tcount\nPhiladelphia\t14569\nTucson\t9250\nTampa\t9050\nIndianapolis\t7540\nNashville\t6971\nNew Orleans\t6209\nReno\t5935\nEdmonton\t5054\nSaint Louis\t4827\nSanta Barbara\t3829\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=254"},{"jobUrl":"http://node-master:4040/jobs/job?id=255"},{"jobUrl":"http://node-master:4040/jobs/job?id=256"},{"jobUrl":"http://node-master:4040/jobs/job?id=257"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774234757768_1731149994","id":"paragraph_1774234757768_1731149994","dateCreated":"2026-03-23T10:59:17+0800","dateStarted":"2026-03-24T09:22:50+0800","dateFinished":"2026-03-24T09:22:52+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n# Table: business\ndf = spark.table(\"business\") \\\n    .groupBy(\"state\") \\\n    .count() \\\n    .orderBy(F.desc(\"count\")) \\\n    .limit(5)\n\nprint(\"=== Top 5 States with Most Merchants ===\")\ndf.show(5)\nz.show(df)\n# Chart suggestion: bar chart (keys: state, values: count)\n","user":"anonymous","dateUpdated":"2026-03-24T09:23:01+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 5 States with Most Merchants ===\n+-----+-----+\n|state|count|\n+-----+-----+\n|   PA|34039|\n|   FL|26330|\n|   TN|12056|\n|   IN|11247|\n|   MO|10913|\n+-----+-----+\n\n"},{"type":"TABLE","data":"state\tcount\nPA\t34039\nFL\t26330\nTN\t12056\nIN\t11247\nMO\t10913\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=258"},{"jobUrl":"http://node-master:4040/jobs/job?id=259"},{"jobUrl":"http://node-master:4040/jobs/job?id=260"},{"jobUrl":"http://node-master:4040/jobs/job?id=261"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315370344_1558053641","id":"paragraph_1774315370344_1558053641","dateCreated":"2026-03-24T09:22:50+0800","dateStarted":"2026-03-24T09:23:01+0800","dateFinished":"2026-03-24T09:23:02+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n# Table: business\ndf = spark.table(\"business\") \\\n    .groupBy(\"name\") \\\n    .agg(\n        F.count(\"*\").alias(\"count\"),\n        F.avg(\"stars\").alias(\"avg_rating\")\n    ) \\\n    .orderBy(F.desc(\"count\")) \\\n    .limit(20)\n\nprint(\"=== Top 20 Merchants with Average Ratings ===\")\ndf.show(20, truncate=False)\nz.show(df)\n# Chart suggestion: bar chart (keys: name, values: count, avg_rating)\n","user":"anonymous","dateUpdated":"2026-03-24T09:23:12+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Merchants with Average Ratings ===\n+---------------------+-----+------------------+\n|name                 |count|avg_rating        |\n+---------------------+-----+------------------+\n|Starbucks            |724  |3.126381215469613 |\n|McDonald's           |703  |1.8634423897581793|\n|Dunkin'              |510  |2.302941176470588 |\n|Subway               |459  |2.5860566448801743|\n|Taco Bell            |365  |2.154794520547945 |\n|CVS Pharmacy         |345  |2.4565217391304346|\n|Walgreens            |341  |2.624633431085044 |\n|Burger King          |338  |2.0281065088757395|\n|Wendy's              |331  |2.015105740181269 |\n|Wawa                 |307  |3.3192182410423454|\n|Domino's Pizza       |295  |2.2813559322033896|\n|The UPS Store        |281  |3.215302491103203 |\n|Pizza Hut            |272  |2.0330882352941178|\n|Enterprise Rent-A-Car|232  |3.2780172413793105|\n|Papa John's Pizza    |196  |2.4081632653061225|\n|Great Clips          |185  |2.9               |\n|Jimmy John's         |175  |2.8685714285714288|\n|US Post Office       |174  |2.4195402298850577|\n|KFC                  |171  |1.8596491228070176|\n|Chick-fil-A          |162  |3.3858024691358026|\n+---------------------+-----+------------------+\n\n"},{"type":"TABLE","data":"name\tcount\tavg_rating\nStarbucks\t724\t3.126381215469613\nMcDonald's\t703\t1.8634423897581793\nDunkin'\t510\t2.302941176470588\nSubway\t459\t2.5860566448801743\nTaco Bell\t365\t2.154794520547945\nCVS Pharmacy\t345\t2.4565217391304346\nWalgreens\t341\t2.624633431085044\nBurger King\t338\t2.0281065088757395\nWendy's\t331\t2.015105740181269\nWawa\t307\t3.3192182410423454\nDomino's Pizza\t295\t2.2813559322033896\nThe UPS Store\t281\t3.215302491103203\nPizza Hut\t272\t2.0330882352941178\nEnterprise Rent-A-Car\t232\t3.2780172413793105\nPapa John's Pizza\t196\t2.4081632653061225\nGreat Clips\t185\t2.9\nJimmy John's\t175\t2.8685714285714288\nUS Post Office\t174\t2.4195402298850577\nKFC\t171\t1.8596491228070176\nChick-fil-A\t162\t3.3858024691358026\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=262"},{"jobUrl":"http://node-master:4040/jobs/job?id=263"},{"jobUrl":"http://node-master:4040/jobs/job?id=264"},{"jobUrl":"http://node-master:4040/jobs/job?id=265"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315381157_1168004950","id":"paragraph_1774315381157_1168004950","dateCreated":"2026-03-24T09:23:01+0800","dateStarted":"2026-03-24T09:23:12+0800","dateFinished":"2026-03-24T09:23:15+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\ncategory_count = (spark.table(\"business\")\n                  .filter(F.col(\"categories\").isNotNull())\n                  .select(F.split(\"categories\", \",\").alias(\"cat_array\"))\n                  .select(F.explode(\"cat_array\").alias(\"category\"))\n                  .select(F.trim(F.col(\"category\")).alias(\"category\"))\n                  .distinct()\n                  .count())\n\nprint(f\"=== Total Distinct Categories ===\\n{category_count}\")\n","user":"anonymous","dateUpdated":"2026-03-24T09:23:27+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Total Distinct Categories ===\n1311\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=266"},{"jobUrl":"http://node-master:4040/jobs/job?id=267"},{"jobUrl":"http://node-master:4040/jobs/job?id=268"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315392857_1386978979","id":"paragraph_1774315392857_1386978979","dateCreated":"2026-03-24T09:23:12+0800","dateStarted":"2026-03-24T09:23:27+0800","dateFinished":"2026-03-24T09:23:29+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\ndf = (spark.table(\"business\")\n      .filter(F.col(\"categories\").isNotNull())\n      .select(F.split(\"categories\", \", \").alias(\"cat_array\"))\n      .select(F.explode(\"cat_array\").alias(\"category\"))\n      .groupBy(\"category\")\n      .count()\n      .orderBy(F.desc(\"count\"))\n      .limit(10))\n\nprint(\"=== Top 10 Most Frequent Categories ===\")\ndf.show(10, truncate=False)\nz.show(df)\n# Chart suggestion: bar chart (keys: category, values: count)\n","user":"anonymous","dateUpdated":"2026-03-24T09:23:40+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 10 Most Frequent Categories ===\n+----------------+-----+\n|category        |count|\n+----------------+-----+\n|Restaurants     |52268|\n|Food            |27781|\n|Shopping        |24395|\n|Home Services   |14356|\n|Beauty & Spas   |14292|\n|Nightlife       |12281|\n|Health & Medical|11890|\n|Local Services  |11198|\n|Bars            |11065|\n|Automotive      |10773|\n+----------------+-----+\n\n"},{"type":"TABLE","data":"category\tcount\nRestaurants\t52268\nFood\t27781\nShopping\t24395\nHome Services\t14356\nBeauty & Spas\t14292\nNightlife\t12281\nHealth & Medical\t11890\nLocal Services\t11198\nBars\t11065\nAutomotive\t10773\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=269"},{"jobUrl":"http://node-master:4040/jobs/job?id=270"},{"jobUrl":"http://node-master:4040/jobs/job?id=271"},{"jobUrl":"http://node-master:4040/jobs/job?id=272"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315407411_526184702","id":"paragraph_1774315407411_526184702","dateCreated":"2026-03-24T09:23:27+0800","dateStarted":"2026-03-24T09:23:40+0800","dateFinished":"2026-03-24T09:23:42+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Count 5‑star reviews per business\nfive_star_counts = (spark.table(\"review\")\n                    .filter(F.col(\"stars\") == 5)\n                    .groupBy(\"business_id\")\n                    .count()\n                    .withColumnRenamed(\"count\", \"five_star_count\"))\n\n# Join with business table to get names and take top 20\ndf = (five_star_counts\n      .join(spark.table(\"business\"), \"business_id\")\n      .select(\"name\", \"five_star_count\")\n      .orderBy(F.desc(\"five_star_count\"))\n      .limit(20))\n\nprint(\"=== Top 20 Merchants with Most 5-Star Reviews ===\")\ndf.show(20, truncate=False)\nz.show(df)\n# Chart suggestion: bar chart (keys: name, values: five_star_count)\n","user":"anonymous","dateUpdated":"2026-03-24T09:23:52+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Merchants with Most 5-Star Reviews ===\n+----------------------------------+---------------+\n|name                              |five_star_count|\n+----------------------------------+---------------+\n|Reading Terminal Market           |4014           |\n|Oceana Grill                      |4012           |\n|Hattie B’s Hot Chicken - Nashville|3838           |\n|Acme Oyster House                 |3645           |\n|Commander's Palace                |3095           |\n|Ruby Slipper - New Orleans        |3075           |\n|Los Agaves                        |2693           |\n|Pappy's Smokehouse                |2675           |\n|Cochon Butcher                    |2537           |\n|Luke                              |2365           |\n|Cochon                            |2340           |\n|Zahav                             |2282           |\n|Biscuit Love: Gulch               |2272           |\n|Willie Mae's Scotch House         |2136           |\n|Royal House                       |2103           |\n|Bern's Steak House                |1959           |\n|GW Fins                           |1853           |\n|Felix's Restaurant & Oyster Bar   |1784           |\n|Ulele                             |1747           |\n|Datz                              |1746           |\n+----------------------------------+---------------+\n\n"},{"type":"TABLE","data":"name\tfive_star_count\nReading Terminal Market\t4014\nOceana Grill\t4012\nHattie B’s Hot Chicken - Nashville\t3838\nAcme Oyster House\t3645\nCommander's Palace\t3095\nRuby Slipper - New Orleans\t3075\nLos Agaves\t2693\nPappy's Smokehouse\t2675\nCochon Butcher\t2537\nLuke\t2365\nCochon\t2340\nZahav\t2282\nBiscuit Love: Gulch\t2272\nWillie Mae's Scotch House\t2136\nRoyal House\t2103\nBern's Steak House\t1959\nGW Fins\t1853\nFelix's Restaurant & Oyster Bar\t1784\nUlele\t1747\nDatz\t1746\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=273"},{"jobUrl":"http://node-master:4040/jobs/job?id=274"},{"jobUrl":"http://node-master:4040/jobs/job?id=275"},{"jobUrl":"http://node-master:4040/jobs/job?id=276"},{"jobUrl":"http://node-master:4040/jobs/job?id=277"},{"jobUrl":"http://node-master:4040/jobs/job?id=278"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315420228_1352873792","id":"paragraph_1774315420228_1352873792","dateCreated":"2026-03-24T09:23:40+0800","dateStarted":"2026-03-24T09:23:52+0800","dateFinished":"2026-03-24T09:24:01+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\n\nresult = business_df \\\n    .filter(business_df.categories.like(\"%Restaurants%\")) \\\n    .selectExpr(\n        \"CASE \" +\n        \"  WHEN categories LIKE '%American%'       THEN 'American'       \" +\n        \"  WHEN categories LIKE '%Mexican%'        THEN 'Mexican'        \" +\n        \"  WHEN categories LIKE '%Italian%'        THEN 'Italian'        \" +\n        \"  WHEN categories LIKE '%Japanese%'       THEN 'Japanese'       \" +\n        \"  WHEN categories LIKE '%Chinese%'        THEN 'Chinese'        \" +\n        \"  WHEN categories LIKE '%Thai%'           THEN 'Thai'           \" +\n        \"  WHEN categories LIKE '%Mediterranean%'  THEN 'Mediterranean'  \" +\n        \"  WHEN categories LIKE '%French%'         THEN 'French'         \" +\n        \"  WHEN categories LIKE '%Vietnamese%'     THEN 'Vietnamese'     \" +\n        \"  WHEN categories LIKE '%Greek%'          THEN 'Greek'          \" +\n        \"  WHEN categories LIKE '%Indian%'         THEN 'Indian'         \" +\n        \"  WHEN categories LIKE '%Korean%'         THEN 'Korean'         \" +\n        \"  WHEN categories LIKE '%Hawaiian%'       THEN 'Hawaiian'       \" +\n        \"  WHEN categories LIKE '%African%'        THEN 'African'        \" +\n        \"  WHEN categories LIKE '%Spanish%'        THEN 'Spanish'        \" +\n        \"  WHEN categories LIKE '%Middle Eastern%' THEN 'Middle Eastern' \" +\n        \"  ELSE 'Other' \" +\n        \"END AS cuisine_type\"\n    ) \\\n    .filter(\"cuisine_type != 'Other'\") \\\n    .groupBy(\"cuisine_type\") \\\n    .count() \\\n    .withColumnRenamed(\"count\", \"Restaurant Count\") \\\n    .withColumnRenamed(\"cuisine_type\", \"Cuisine Type\") \\\n    .orderBy(\"Restaurant Count\", ascending=False)\n\nprint(\"=== Number of Restaurant Types ===\")\nresult.show(16)\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T09:24:09+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Restaurant Types ===\n+--------------+----------------+\n|  Cuisine Type|Restaurant Count|\n+--------------+----------------+\n|      American|           13066|\n|       Mexican|            4049|\n|       Italian|            3997|\n|       Chinese|            2719|\n|      Japanese|            1765|\n| Mediterranean|             920|\n|        Indian|             754|\n|          Thai|             687|\n|    Vietnamese|             592|\n|        Korean|             291|\n|        French|             276|\n|         Greek|             242|\n|Middle Eastern|             188|\n|      Hawaiian|             120|\n|       Spanish|             114|\n|       African|              84|\n+--------------+----------------+\n\n"},{"type":"TABLE","data":"Cuisine Type\tRestaurant Count\nAmerican\t13066\nMexican\t4049\nItalian\t3997\nChinese\t2719\nJapanese\t1765\nMediterranean\t920\nIndian\t754\nThai\t687\nVietnamese\t592\nKorean\t291\nFrench\t276\nGreek\t242\nMiddle Eastern\t188\nHawaiian\t120\nSpanish\t114\nAfrican\t84\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=279"},{"jobUrl":"http://node-master:4040/jobs/job?id=280"},{"jobUrl":"http://node-master:4040/jobs/job?id=281"},{"jobUrl":"http://node-master:4040/jobs/job?id=282"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315432170_470076499","id":"paragraph_1774315432170_470076499","dateCreated":"2026-03-24T09:23:52+0800","dateStarted":"2026-03-24T09:24:09+0800","dateFinished":"2026-03-24T09:24:11+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\nreview_df = spark.table(\"review\")\n\ncuisine_df = business_df \\\n    .filter(business_df.categories.like(\"%Restaurants%\")) \\\n    .selectExpr(\n        \"business_id\",\n        \"CASE \" +\n        \"  WHEN categories LIKE '%American%'       THEN 'American'       \" +\n        \"  WHEN categories LIKE '%Mexican%'        THEN 'Mexican'        \" +\n        \"  WHEN categories LIKE '%Italian%'        THEN 'Italian'        \" +\n        \"  WHEN categories LIKE '%Japanese%'       THEN 'Japanese'       \" +\n        \"  WHEN categories LIKE '%Chinese%'        THEN 'Chinese'        \" +\n        \"  WHEN categories LIKE '%Thai%'           THEN 'Thai'           \" +\n        \"  WHEN categories LIKE '%Mediterranean%'  THEN 'Mediterranean'  \" +\n        \"  WHEN categories LIKE '%French%'         THEN 'French'         \" +\n        \"  WHEN categories LIKE '%Vietnamese%'     THEN 'Vietnamese'     \" +\n        \"  WHEN categories LIKE '%Greek%'          THEN 'Greek'          \" +\n        \"  WHEN categories LIKE '%Indian%'         THEN 'Indian'         \" +\n        \"  WHEN categories LIKE '%Korean%'         THEN 'Korean'         \" +\n        \"  WHEN categories LIKE '%Hawaiian%'       THEN 'Hawaiian'       \" +\n        \"  WHEN categories LIKE '%African%'        THEN 'African'        \" +\n        \"  WHEN categories LIKE '%Spanish%'        THEN 'Spanish'        \" +\n        \"  WHEN categories LIKE '%Middle Eastern%' THEN 'Middle Eastern' \" +\n        \"  ELSE 'Other' \" +\n        \"END AS cuisine_type\"\n    ) \\\n    .filter(\"cuisine_type != 'Other'\")\n\nresult = cuisine_df \\\n    .join(review_df, cuisine_df.business_id == review_df.business_id) \\\n    .groupBy(\"cuisine_type\") \\\n    .count() \\\n    .withColumnRenamed(\"count\", \"Review Count\") \\\n    .withColumnRenamed(\"cuisine_type\", \"Cuisine Type\") \\\n    .orderBy(\"Review Count\", ascending=False)\n\nprint(\"=== Number of Reviews per Restaurant Type ===\")\nresult.show(16)\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T09:24:23+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Reviews per Restaurant Type ===\n+--------------+------------+\n|  Cuisine Type|Review Count|\n+--------------+------------+\n|      American|     1730875|\n|       Italian|      355606|\n|       Mexican|      349269|\n|      Japanese|      203535|\n|       Chinese|      180324|\n| Mediterranean|       85214|\n|          Thai|       82042|\n|        Indian|       70876|\n|    Vietnamese|       58903|\n|        French|       39742|\n|        Korean|       26984|\n|         Greek|       16807|\n|Middle Eastern|       15364|\n|       Spanish|       15283|\n|      Hawaiian|       11284|\n|       African|        3872|\n+--------------+------------+\n\n"},{"type":"TABLE","data":"Cuisine Type\tReview Count\nAmerican\t1730875\nItalian\t355606\nMexican\t349269\nJapanese\t203535\nChinese\t180324\nMediterranean\t85214\nThai\t82042\nIndian\t70876\nVietnamese\t58903\nFrench\t39742\nKorean\t26984\nGreek\t16807\nMiddle Eastern\t15364\nSpanish\t15283\nHawaiian\t11284\nAfrican\t3872\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=283"},{"jobUrl":"http://node-master:4040/jobs/job?id=284"},{"jobUrl":"http://node-master:4040/jobs/job?id=285"},{"jobUrl":"http://node-master:4040/jobs/job?id=286"},{"jobUrl":"http://node-master:4040/jobs/job?id=287"},{"jobUrl":"http://node-master:4040/jobs/job?id=288"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774315449332_153210839","id":"paragraph_1774315449332_153210839","dateCreated":"2026-03-24T09:24:09+0800","dateStarted":"2026-03-24T09:24:23+0800","dateFinished":"2026-03-24T09:24:32+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nbusiness_df = spark.table(\"business\")\nreview_df = spark.table(\"review\")\n\ncuisine_df = business_df \\\n    .filter(business_df.categories.like(\"%Restaurants%\")) \\\n    .selectExpr(\n        \"business_id\",\n        \"CASE \" +\n        \"  WHEN categories LIKE '%American%'       THEN 'American'       \" +\n        \"  WHEN categories LIKE '%Mexican%'        THEN 'Mexican'        \" +\n        \"  WHEN categories LIKE '%Italian%'        THEN 'Italian'        \" +\n        \"  WHEN categories LIKE '%Japanese%'       THEN 'Japanese'       \" +\n        \"  WHEN categories LIKE '%Chinese%'        THEN 'Chinese'        \" +\n        \"  WHEN categories LIKE '%Thai%'           THEN 'Thai'           \" +\n        \"  WHEN categories LIKE '%Mediterranean%'  THEN 'Mediterranean'  \" +\n        \"  WHEN categories LIKE '%French%'         THEN 'French'         \" +\n        \"  WHEN categories LIKE '%Vietnamese%'     THEN 'Vietnamese'     \" +\n        \"  WHEN categories LIKE '%Greek%'          THEN 'Greek'          \" +\n        \"  WHEN categories LIKE '%Indian%'         THEN 'Indian'         \" +\n        \"  WHEN categories LIKE '%Korean%'         THEN 'Korean'         \" +\n        \"  WHEN categories LIKE '%Hawaiian%'       THEN 'Hawaiian'       \" +\n        \"  WHEN categories LIKE '%African%'        THEN 'African'        \" +\n        \"  WHEN categories LIKE '%Spanish%'        THEN 'Spanish'        \" +\n        \"  WHEN categories LIKE '%Middle Eastern%' THEN 'Middle Eastern' \" +\n        \"  ELSE 'Other' \" +\n        \"END AS cuisine_type\"\n    ) \\\n    .filter(\"cuisine_type != 'Other'\")\n\nresult = cuisine_df \\\n    .join(review_df, cuisine_df.business_id == review_df.business_id) \\\n    .groupBy(\"cuisine_type\", \"stars\") \\\n    .count() \\\n    .withColumnRenamed(\"count\", \"Review Count\") \\\n    .withColumnRenamed(\"cuisine_type\", \"Cuisine Type\") \\\n    .withColumnRenamed(\"stars\", \"Stars\") \\\n    .orderBy(\"Cuisine Type\", \"Stars\")\n\nprint(\"=== Rating Distribution per Restaurant Type ===\")\nresult.show(80)\nz.show(result)\n","user":"anonymous","dateUpdated":"2026-03-24T09:46:10+0800","progress":0,"config":{"colWidth":12