ccn0deyPakQd2ftfzFO_kw\tJulianna\nbHGQol9v3mWTAugxNWrIAw\t5.0\t1.0\t-4.0\tbHGQol9v3mWTAugxNWrIAw\tDulce\nIdCTNEEcoea5DJAZ_aoR6w\t5.0\t1.0\t-4.0\tIdCTNEEcoea5DJAZ_aoR6w\tAngela\nIe_4ru2mCaiw-uyzcodCoQ\t5.0\t1.0\t-4.0\tIe_4ru2mCaiw-uyzcodCoQ\tOctavio\n"},{"type":"HTML","data":"<div class=\"result-alert alert-warning\" role=\"alert\"><button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button><strong>Output is truncated</strong> to 1000 rows. Learn more about <strong>zeppelin.spark.maxResult</strong></div>\n"}]},"focus":false},{"text":"%pyspark\n\n#  9. Dining Diversity — Top 50 Most Adventurous Eaters (Fixed)\n\n# Step 1: Join reviews with business categories\ndf_diversity = review_df \\\n    .join(business_df.select(\"business_id\", \"categories\"), \n          review_df.rev_business_id == business_df.business_id) \\\n    .filter(col(\"categories\").isNotNull()) \\\n    .withColumn(\"category\", explode(split(\"categories\", \", \")))\n\n# Step 2: Count distinct categories per user (min 20 reviews)\ndf_adventurous = df_diversity \\\n    .groupBy(\"rev_user_id\") \\\n    .agg(\n        countDistinct(\"category\").alias(\"distinct_cuisines\"),\n        count(\"review_id\").alias(\"total_reviews\")\n    ) \\\n    .filter(col(\"total_reviews\") >= 20) \\\n    .join(user_df.select(\"user_id\", \"user_name\"), col(\"rev_user_id\") == col(\"user_id\")) \\\n    .orderBy(desc(\"distinct_cuisines\")) \\\n    .limit(50)\n\ndf_adventurous.show()\nz.show(df_adventurous)","user":"anonymous","dateUpdated":"2026-03-23T13:22:49+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"lineChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"ro