 3: Aggregate avg word count and avg useful votes\ndf_elite_impact = df_reviews_elite \\\n    .groupBy(\"status\") \\\n    .agg(\n        round(avg(\"word_count\"), 2).alias(\"avg_word_count\"),\n        round(avg(\"rev_useful\"), 2).alias(\"avg_useful_votes\"),\n        count(\"review_id\").alias(\"total_reviews\")\n    )\n\ndf_elite_impact.show()\nz.show(df_elite_impact)","user":"anonymous","dateUpdated":"2026-03-23T13:22:38+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"status","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"avg_word_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=101"},{"jobUrl":"http://node-master:4040/jobs/job?id=102"},{"jobUrl":"http://node-master:4040/jobs/job?id=103"},{"jobUrl":"http://node-master:4040/jobs/job?id=104"},{"jobUrl":"http://node-master:4040/jobs/job?id=105"},{"jobUrl":"http://node-master:4040/jobs/job?id=106"},{"jobUrl":"http://node-master:4040/jobs/job?id=107"},{"jobUrl":"http://node-master:4040/jobs/job?id=108"},{"jobUrl":"http://node-master:4040/jobs/job?id=109"},{"jobUrl":"http://node-master:4040/jobs/job?id=110"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774242236474_370961741","id":"paragraph_1774242236474_370961741","dateCreated":"2026-03-23T13:03:56+0800","status":"FINISHED","focus":false,"dateFinished":"2026-