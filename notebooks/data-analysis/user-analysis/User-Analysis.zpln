{"paragraphs":[{"text":"%pyspark\r\n\r\nfrom pyspark.sql.functions import *\r\nfrom pyspark.sql.window import Window\r\n\r\nuser_df = spark.table(\"yelp_db.users\")\r\nreview_df = spark.table(\"yelp_db.review\")\r\nbusiness_df = spark.table(\"yelp_db.business\")\r\ntip_df = spark.table(\"yelp_db.tip\")\r\ncheckin_df = spark.table(\"yelp_db.checkin\")","user":"anonymous","dateUpdated":"2026-03-23T11:25:04+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774235815899_986871751","id":"paragraph_1774235815899_986871751","dateCreated":"2026-03-23T11:16:55+0800","dateStarted":"2026-03-23T11:25:04+0800","dateFinished":"2026-03-23T11:25:05+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n\n# 1. Number of Users Joining Each Year\n\ndf_users = spark.table(\"users\")\n\ndf_users_per_year = df_users \\\n    .withColumn(\"year\", F.year(F.to_date(\"user_yelping_since\"))) \\\n    .groupBy(\"year\") \\\n    .agg(F.count(\"user_id\").alias(\"total_users\")) \\\n    .orderBy(\"year\")\n\ndf_users_per_year.show()\nz.show(df_users_per_year)","user":"anonymous","dateUpdated":"2026-03-23T13:20:41+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"scatterChart":{},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"year","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_users","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----+-----------+\n|year|total_users|\n+----+-----------+\n|2004|         90|\n|2005|        937|\n|2006|       5423|\n|2007|      15340|\n|2008|      31097|\n|2009|      64911|\n|2010|     109054|\n|2011|     176435|\n|2012|     195955|\n|2013|     209762|\n|2014|     233465|\n|2015|     247850|\n|2016|     217620|\n|2017|     151024|\n|2018|     133568|\n|2019|     104655|\n|2020|      47444|\n|2021|      40485|\n|2022|       2782|\n+----+-----------+\n\n"},{"type":"TABLE","data":"year\ttotal_users\n2004\t90\n2005\t937\n2006\t5423\n2007\t15340\n2008\t31097\n2009\t64911\n2010\t109054\n2011\t176435\n2012\t195955\n2013\t209762\n2014\t233465\n2015\t247850\n2016\t217620\n2017\t151024\n2018\t133568\n2019\t104655\n2020\t47444\n2021\t40485\n2022\t2782\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=20"},{"jobUrl":"http://node-master:4040/jobs/job?id=21"},{"jobUrl":"http://node-master:4040/jobs/job?id=22"},{"jobUrl":"http://node-master:4040/jobs/job?id=23"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774235950210_1386084217","id":"paragraph_1774235950210_1386084217","dateCreated":"2026-03-23T11:19:10+0800","dateStarted":"2026-03-23T11:34:55+0800","dateFinished":"2026-03-23T11:35:43+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n# 2. Top Reviewers Based on Review Count\n\ndf_users = spark.table(\"users\")\n\ndf_top_reviewers = df_users \\\n    .select(\"user_id\", \"user_name\", \"user_review_count\") \\\n    .orderBy(F.desc(\"user_review_count\")) \\\n    .limit(10)\n\ndf_top_reviewers.show()\nz.show(df_top_reviewers)","user":"anonymous","dateUpdated":"2026-03-23T13:21:27+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"user_id","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"user_name","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+---------+-----------------+\n|             user_id|user_name|user_review_count|\n+--------------------+---------+-----------------+\n|Hi10sGSZNxQH3NLyW...|      Fox|            17473|\n|8k3aO-mPeyhbR5HUu...|   Victor|            16978|\n|hWDybu_KvYLSdEFzG...|    Bruce|            16567|\n|RtGqdDBvvBCjcu5dU...|    Shila|            12868|\n|P5bUL3Engv-2z6kKo...|      Kim|             9941|\n|nmdkHL2JKFx55T3nq...|   Nijole|             8363|\n|bQCHF5rn5lMI9c5kE...|  Vincent|             8354|\n|8RcEwGrFIgkt9WQ35...|   George|             7738|\n|Xwnf20FKuikiHcSpc...|  Kenneth|             6766|\n|CxDOIDnH8gp9KXzpB...| Jennifer|             6679|\n+--------------------+---------+-----------------+\n\n"},{"type":"TABLE","data":"user_id\tuser_name\tuser_review_count\nHi10sGSZNxQH3NLyWSZ1oA\tFox\t17473\n8k3aO-mPeyhbR5HUucA5aA\tVictor\t16978\nhWDybu_KvYLSdEFzGrniTw\tBruce\t16567\nRtGqdDBvvBCjcu5dUqwfzA\tShila\t12868\nP5bUL3Engv-2z6kKohB6qQ\tKim\t9941\nnmdkHL2JKFx55T3nq5VziA\tNijole\t8363\nbQCHF5rn5lMI9c5kEwCaNA\tVincent\t8354\n8RcEwGrFIgkt9WQ35E6SnQ\tGeorge\t7738\nXwnf20FKuikiHcSpcEbpKQ\tKenneth\t6766\nCxDOIDnH8gp9KXzpBHJYXw\tJennifer\t6679\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=24"},{"jobUrl":"http://node-master:4040/jobs/job?id=25"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774236204183_341876600","id":"paragraph_1774236204183_341876600","dateCreated":"2026-03-23T11:23:24+0800","dateStarted":"2026-03-23T11:37:17+0800","dateFinished":"2026-03-23T11:38:06+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n# 3. Most Popular Users Based on Fans\n\ndf_users = spark.table(\"users\")\n\ndf_top_fans = df_users \\\n    .select(\"user_id\", \"user_name\", \"user_fans\") \\\n    .orderBy(F.desc(\"user_fans\")) \\\n    .limit(10)\n\ndf_top_fans.show()\nz.show(df_top_fans)","user":"anonymous","dateUpdated":"2026-03-23T13:21:54+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"lineChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"user_id","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"user_name","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+---------+---------+\n|             user_id|user_name|user_fans|\n+--------------------+---------+---------+\n|37cpUoM8hlkSQfReI...|     Mike|    12497|\n|hizGc5W1tBHPghM5Y...|    Katie|     3642|\n|Hi10sGSZNxQH3NLyW...|      Fox|     3493|\n|JjXuiru1_ONzDkYVr...|  Richard|     3243|\n|j14WgRoU_-2ZE1aw1...|   Daniel|     3138|\n|VHdY6oG2JPVNjihWh...|  Jessica|     2627|\n|iLjMdZi0Tm7DQxX1C...|    Ruggy|     2547|\n|lt7bNHl-TXziny4FE...|    Megan|     2451|\n|fgwI3rYHOv1ipfVfC...|      Emi|     2424|\n|ITa3vh5ERI90G_WP4...|    Peter|     2388|\n+--------------------+---------+---------+\n\n"},{"type":"TABLE","data":"user_id\tuser_name\tuser_fans\n37cpUoM8hlkSQfReIEBd-Q\tMike\t12497\nhizGc5W1tBHPghM5YKCAtg\tKatie\t3642\nHi10sGSZNxQH3NLyWSZ1oA\tFox\t3493\nJjXuiru1_ONzDkYVrHN0aw\tRichard\t3243\nj14WgRoU_-2ZE1aw1dXrJg\tDaniel\t3138\nVHdY6oG2JPVNjihWhOooAQ\tJessica\t2627\niLjMdZi0Tm7DQxX1C1_2dg\tRuggy\t2547\nlt7bNHl-TXziny4FETu8nA\tMegan\t2451\nfgwI3rYHOv1ipfVfCSx7pg\tEmi\t2424\nITa3vh5ERI90G_WP4SmGUQ\tPeter\t2388\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=26"},{"jobUrl":"http://node-master:4040/jobs/job?id=27"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774237037388_398659415","id":"paragraph_1774237037388_398659415","dateCreated":"2026-03-23T11:37:17+0800","dateStarted":"2026-03-23T11:39:42+0800","dateFinished":"2026-03-23T11:40:29+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n# 4. Ratio of Elite Users to Regular Users Each Year\n\ndf_users = spark.table(\"users\")\n\ndf_elite_ratio = df_users \\\n    .withColumn(\"year\", F.year(F.to_date(\"user_yelping_since\"))) \\\n    .withColumn(\"is_elite\", F.when(\n        (F.col(\"user_elite\").isNotNull()) & (F.col(\"user_elite\") != \"\"), 1\n    ).otherwise(0)) \\\n    .groupBy(\"year\") \\\n    .agg(\n        F.count(\"user_id\").alias(\"total_users\"),\n        F.sum(\"is_elite\").alias(\"elite_users\")\n    ) \\\n    .withColumn(\"regular_users\", F.col(\"total_users\") - F.col(\"elite_users\")) \\\n    .withColumn(\"elite_ratio\", F.round(F.col(\"elite_users\") / F.col(\"total_users\") * 100, 2)) \\\n    .orderBy(\"year\")\n\ndf_elite_ratio.show()\nz.show(df_elite_ratio)","user":"anonymous","dateUpdated":"2026-03-23T11:41:10+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----+-----------+-----------+-------------+-----------+\n|year|total_users|elite_users|regular_users|elite_ratio|\n+----+-----------+-----------+-------------+-----------+\n|2004|         90|         27|           63|       30.0|\n|2005|        937|        401|          536|       42.8|\n|2006|       5423|       1743|         3680|      32.14|\n|2007|      15340|       3788|        11552|      24.69|\n|2008|      31097|       5679|        25418|      18.26|\n|2009|      64911|       7691|        57220|      11.85|\n|2010|     109054|       9928|        99126|        9.1|\n|2011|     176435|      11504|       164931|       6.52|\n|2012|     195955|      10168|       185787|       5.19|\n|2013|     209762|       9588|       200174|       4.57|\n|2014|     233465|       9202|       224263|       3.94|\n|2015|     247850|       8036|       239814|       3.24|\n|2016|     217620|       5708|       211912|       2.62|\n|2017|     151024|       3622|       147402|        2.4|\n|2018|     133568|       2251|       131317|       1.69|\n|2019|     104655|       1341|       103314|       1.28|\n|2020|      47444|        339|        47105|       0.71|\n|2021|      40485|        182|        40303|       0.45|\n|2022|       2782|          0|         2782|        0.0|\n+----+-----------+-----------+-------------+-----------+\n\n"},{"type":"TABLE","data":"year\ttotal_users\telite_users\tregular_users\telite_ratio\n2004\t90\t27\t63\t30.0\n2005\t937\t401\t536\t42.8\n2006\t5423\t1743\t3680\t32.14\n2007\t15340\t3788\t11552\t24.69\n2008\t31097\t5679\t25418\t18.26\n2009\t64911\t7691\t57220\t11.85\n2010\t109054\t9928\t99126\t9.1\n2011\t176435\t11504\t164931\t6.52\n2012\t195955\t10168\t185787\t5.19\n2013\t209762\t9588\t200174\t4.57\n2014\t233465\t9202\t224263\t3.94\n2015\t247850\t8036\t239814\t3.24\n2016\t217620\t5708\t211912\t2.62\n2017\t151024\t3622\t147402\t2.4\n2018\t133568\t2251\t131317\t1.69\n2019\t104655\t1341\t103314\t1.28\n2020\t47444\t339\t47105\t0.71\n2021\t40485\t182\t40303\t0.45\n2022\t2782\t0\t2782\t0.0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=28"},{"jobUrl":"http://node-master:4040/jobs/job?id=29"},{"jobUrl":"http://node-master:4040/jobs/job?id=30"},{"jobUrl":"http://node-master:4040/jobs/job?id=31"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774237182503_1689430344","id":"paragraph_1774237182503_1689430344","dateCreated":"2026-03-23T11:39:42+0800","dateStarted":"2026-03-23T11:41:10+0800","dateFinished":"2026-03-23T11:42:02+0800","status":"FINISHED"},{"text":"%pyspark\n\n# 5. Proportion of Total Users and Silent Users Each Year\n\ndf_users = spark.table(\"users\")\n\ndf_silent_users = df_users \\\n    .withColumn(\"year\", F.year(F.to_date(\"user_yelping_since\"))) \\\n    .withColumn(\"is_silent\", F.when(F.col(\"user_review_count\") == 0, 1).otherwise(0)) \\\n    .groupBy(\"year\") \\\n    .agg(\n        F.count(\"user_id\").alias(\"total_users\"),\n        F.sum(\"is_silent\").alias(\"silent_users\")\n    ) \\\n    .withColumn(\"active_users\", F.col(\"total_users\") - F.col(\"silent_users\")) \\\n    .withColumn(\"silent_ratio\", F.round(F.col(\"silent_users\") / F.col(\"total_users\") * 100, 2)) \\\n    .withColumn(\"active_ratio\", F.round(F.col(\"active_users\") / F.col(\"total_users\") * 100, 2)) \\\n    .orderBy(\"year\")\n\ndf_silent_users.show()\nz.show(df_silent_users)","user":"anonymous","dateUpdate