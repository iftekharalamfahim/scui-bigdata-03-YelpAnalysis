\\\n    .orderBy(desc(\"early_review_count\")) \\\n    .limit(20)\n\ndf_tastemakers.show()\nz.show(df_tastemakers)","user":"anonymous","dateUpdated":"2026-03-23T11:59:38+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"rev_user_id","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"early_review_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+------------------+--------------------+----------+\n|         rev_user_id|early_review_count|             user_id| user_name|\n+--------------------+------------------+--------------------+----------+\n|iPkdNziqnhNukjnms...|                24|iPkdNziqnhNukjnms...|     Kelly|\n|zAMpV0uFt9XpqRDFN...|                23|zAMpV0uFt9XpqRDFN...|     TOMMY|\n|wBKALvzEZM1ZxpkWe...|                19|wBKALvzEZM1ZxpkWe...|      Tart|\n|0Igx-a1wAstiBDerG...|                18|0Igx-a1wAstiBDerG...|       Jen|\n|0yYCMhDWCEIVUyZLz...|                17|0yYCMhDWCEIVUyZLz...|   Caitlin|\n|gfQqQYI5_hCAGEHlH...|                17|gfQqQYI5_hCAGEHlH...|    Cherie|\n|n-lBS02-3yvlY5Q91...|                16|n-lBS02-3yvlY5Q91...|   Zachary|\n|bnVzSHI48lEHPaEzZ...|                16|bnVzSHI48lEHPaEzZ...|    Amanda|\n|VL12EhEdT4OWqGq0n...|                16|VL12EhEdT4OWqGq0n...|      Mark|\n|bJ5FtCtZX3ZZacz2_...|                15|bJ5FtCtZX3ZZacz2_...|      Bill|\n|TnxZgS3lrNYsPohd_...|                15|TnxZgS3lrNYsPohd_...|      Mark|\n|HQG3no8C5U31z-k1M...|                14|HQG3no8C5U31z-k1M...|     Allan|\n|bYENop4BuQepBjM1-...|                14|bYENop4BuQepBjM1-...|    Steven|\n|qunxFdBDVl0ordRJE...|                14|qunx