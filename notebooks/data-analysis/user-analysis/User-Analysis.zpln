 47437|        0.01|       99.99|\n|2021|      40485|          13|       40472|        0.03|       99.97|\n|2022|       2782|           7|        2775|        0.25|       99.75|\n+----+-----------+------------+------------+------------+------------+\n\n"},{"type":"TABLE","data":"year\ttotal_users\tsilent_users\tactive_users\tsilent_ratio\tactive_ratio\n2004\t90\t0\t90\t0.0\t100.0\n2005\t937\t0\t937\t0.0\t100.0\n2006\t5423\t0\t5423\t0.0\t100.0\n2007\t15340\t0\t15340\t0.0\t100.0\n2008\t31097\t0\t31097\t0.0\t100.0\n2009\t64911\t0\t64911\t0.0\t100.0\n2010\t109054\t1\t109053\t0.0\t100.0\n2011\t176435\t1\t176434\t0.0\t100.0\n2012\t195955\t3\t195952\t0.0\t100.0\n2013\t209762\t1\t209761\t0.0\t100.0\n2014\t233465\t1\t233464\t0.0\t100.0\n2015\t247850\t2\t247848\t0.0\t100.0\n2016\t217620\t3\t217617\t0.0\t100.0\n2017\t151024\t5\t151019\t0.0\t100.0\n2018\t133568\t4\t133564\t0.0\t100.0\n2019\t104655\t6\t104649\t0.01\t99.99\n2020\t47444\t7\t47437\t0.01\t99.99\n2021\t40485\t13\t40472\t0.03\t99.97\n2022\t2782\t7\t2775\t0.25\t99.75\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=32"},{"jobUrl":"http://node-master:4040/jobs/job?id=33"},{"jobUrl":"http://node-master:4040/jobs/job?id=34"},{"jobUrl":"http://node-master:4040/jobs/job?id=35"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774237270876_1446320486","id":"paragraph_1774237270876_1446320486","dateCreated":"2026-03-23T11:41:10+0800","dateStarted":"2026-03-23T11:42:57+0800","dateFinished":"2026-03-23T11:43:38+0800","status":"FINISHED"},{"text":"%pyspark\\\n# 6. Yearly Statistics of New Users, Reviews, Elite Users\n\ndf_users = spark.table(\"users\")\n\ndf_yearly_stats = df_users \\\n    .withColumn(\"year\", F.year(F.to_date(\"user_yelping_since\"))) \\\n    .withColumn(\"is_elite\", F.when(\n        (F.col(\"user_elite\").isNotNull()) & (F.col(\"user_elite\") != \"\"), 1\n    ).otherwise(0)) \\\n    .groupBy(\"year\") \\\n    .agg(\n        F.count(\"user_id\").alias(\"new_users\"),\n        F.sum(\"user_review_count\").alias(\"total_reviews\"),\n        F.sum(\"is_elite\").alias(\"elite_users\"),\n        F.avg(\"user_review_count\").alias(\"avg_reviews_per_user\"),\n        F.avg(\"user_average_stars\").alias(\"avg_stars\")\n    ) \\\n    .orderBy(\"year\")\n\ndf_yearly_stats.show()\nz.show(df_yearly_stats)\n","user":"anonymous","dateUpdated":"2026-03-23T11:45:51+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"year","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"new_users","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----+---------+-------------+-----------+--------------------+------------------+\n|year|new_users|total_reviews|elite_users|avg_reviews_per_user|         avg_stars|\n+----+---------+-------------+-----------+--------------------+------------------+\n|2004|       90|        14577|         27|  161.96666666666667| 3.643777770466275|\n|2005|      937|       226005|        401|  241.20064034151548| 3.816979729124169|\n|2006|     5423|       920176|       1743|  169.68025078369905|3.7748921326599105|\n|2007|    15340|      2011487|       3788|  131.12692307692308| 3.772237944618509|\n|2008|    31097|      3162898|       5679|  101.71071164421005|3.7616551490820123|\n|2009|    64911|      4401364|       7691|   67.80613455346551| 3.760200894728687|\n|2010|   109054|      5444361|       9928|   49.92353329543162|3.7695074955010934|\n|2011|   176435|      6344607|      11504|   35.96002493836257