r:4040/jobs/job?id=42"},{"jobUrl":"http://node-master:4040/jobs/job?id=43"},{"jobUrl":"http://node-master:4040/jobs/job?id=44"},{"jobUrl":"http://node-master:4040/jobs/job?id=45"},{"jobUrl":"http://node-master:4040/jobs/job?id=46"},{"jobUrl":"http://node-master:4040/jobs/job?id=47"},{"jobUrl":"http://node-master:4040/jobs/job?id=48"},{"jobUrl":"http://node-master:4040/jobs/job?id=49"},{"jobUrl":"http://node-master:4040/jobs/job?id=50"},{"jobUrl":"http://node-master:4040/jobs/job?id=51"},{"jobUrl":"http://node-master:4040/jobs/job?id=52"},{"jobUrl":"http://node-master:4040/jobs/job?id=53"},{"jobUrl":"http://node-master:4040/jobs/job?id=54"},{"jobUrl":"http://node-master:4040/jobs/job?id=55"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774237492009_871852041","id":"paragraph_1774237492009_871852041","dateCreated":"2026-03-23T11:44:52+0800","dateStarted":"2026-03-23T11:56:04+0800","dateFinished":"2026-03-23T11:59:31+0800","status":"FINISHED"},{"text":"%pyspark\n# 8. User Rating Evolution: First Year vs Third Year (Fixed)\n\n# Step 1: Get user join year\ndf_user_year = user_df \\\n    .withColumn(\"join_year\", year(to_date(\"user_yelping_since\"))) \\\n    .select(\"user_id\", \"join_year\")\n\n# Step 2: Join reviews with user join year\ndf_reviews_year = review_df \\\n    .withColumn(\"review_year\", year(col(\"rev_date\"))) \\\n    .join(df_user_year, review_df.rev_user_id == df_user_year.user_id)\n\n# Step 3: First year vs third year avg stars\ndf_first_year = df_reviews_year \\\n    .filter(col(\"review_year\") == col(\"join_year\")) \\\n    .groupBy(\"rev_user_id\") \\\n    .agg(avg(\"rev_stars\").alias(\"avg_stars_year_1\"))\n\ndf_third_year = df_reviews_year \\\n    .filter(col(\"review_year\") == col(\"join_year\") + 2) \\\n    .groupBy(\"rev_user_id\") \\\n    .agg(avg(\"rev_stars\").alias(\"avg_stars_year_3\"))\n\n# Step 4: Compare\ndf_evolution = df_first_year \\\n    .join(df_third_year, \"rev_user_id\") \\\n    .w