{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\ncuisines = [\r\n    \"American\", \"Mexican\", \"Italian\", \"Japanese\", \"Chinese\", \"Thai\",\r\n    \"Mediterranean\", \"French\", \"Vietnamese\", \"Greek\", \"Indian\", \"Korean\",\r\n    \"Hawaiian\", \"African\", \"Spanish\", \"Middle Eastern\"\r\n]\r\n\r\ndata = []\r\nfor cuisine in cuisines:\r\n    # Get business IDs belonging to this cuisine\r\n    biz_ids = [row.business_id for row in spark.table(\"business\")\r\n               .filter(F.col(\"categories\").contains(cuisine))\r\n               .select(\"business_id\").collect()]\r\n\r\n    if biz_ids:\r\n        rev_cnt = (spark.table(\"review\")\r\n                   .filter(F.col(\"business_id\").isin(biz_ids))\r\n                   .count())\r\n    else:\r\n        rev_cnt = 0\r\n    data.append((cuisine, rev_cnt))\r\n\r\ndf = spark.createDataFrame(data, [\"cuisine\", \"review_count\"])\r\nprint(\"=== Number of Reviews per Restaurant Type ===\")\r\ndf.show()\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: cuisine, values: review_count)","user":"anonymous","dateUpdated":"2026-03-23T14:36:23+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":309,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"cuisine","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Reviews 