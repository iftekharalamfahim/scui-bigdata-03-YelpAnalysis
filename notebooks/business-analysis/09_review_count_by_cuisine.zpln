{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\nbusiness_df = spark.table(\"business\")\r\nreview_df = spark.table(\"review\")\r\n\r\ncuisine_df = business_df \\\r\n    .filter(business_df.categories.like(\"%Restaurants%\")) \\\r\n    .selectExpr(\r\n        \"business_id\",\r\n        \"CASE \" +\r\n        \"  WHEN categories LIKE '%American%'       THEN 'American'       \" +\r\n        \"  WHEN categories LIKE '%Mexican%'        THEN 'Mexican'        \" +\r\n        \"  WHEN categories LIKE '%Italian%'        THEN 'Italian'        \" +\r\n        \"  WHEN categories LIKE '%Japanese%'       THEN 'Japanese'       \" +\r\n        \"  WHEN categories LIKE '%Chinese%'        THEN 'Chinese'        \" +\r\n        \"  WHEN categories LIKE '%Thai%'           THEN 'Thai'           \" +\r\n        \"  WHEN categories LIKE '%Mediterranean%'  THEN 'Mediterranean'  \" +\r\n        \"  WHEN categories LIKE '%French%'         THEN 'French'         \" +\r\n        \"  WHEN categories LIKE '%Vietnamese%'     THEN 'Vietnamese'     \" +\r\n        \"  WHEN categories LIKE '%Greek%'          THEN 'Greek'          \" +\r\n        \"  WHEN categories LIKE '%Indian%'         THEN 'Indian'         \" +\r\n        \"  WHEN categories LIKE '%Korean%'         THEN 'Korean'         \" +\r\n        \"  WHEN categories LIKE '%Hawaiian%'       THEN 'Hawaiian'       \" +\r\n        \"  WHEN categories LIKE '%African%'        THEN 'African'        \" +\r\n        \"  WHEN categories LIKE '%Spanish%'        THEN 'Spanish'        \" +\r\n        \"  WHEN categories LIKE '%Middle Eastern%' THEN 'Middle Eastern' \" +\r\n        \"  ELSE 'Other' \" +\r\n        \"END AS cuisine_type\"\r\n    ) \\\r\n    .filter(\"cuisine_type != 'Other'\")\r\n\r\nresult = cuisine_df \\\r\n    .join(review_df, cuisine_df.business_id == review_df.business_id) \\\r\n    .groupBy(\"cuisine_type\") \\\r\n    .count() \\\r\n    .withColumnRenamed(\"count\", \"Review Count\") \\\r\n    .withColumnRenamed(\"cuisine_type\", \"Cuisine Type\") \\\r\n    .orderBy(\"Review Count\", ascending=False)\r\n\r\nprint(\"=== Number of Reviews per Restaurant Type ===\")\r\nresult.show(16)\r\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-23T16:02:03+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":309,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"Restaurant Count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Reviews per Restaurant Type ===\n+--------------+------------+\n|  Cuisine Type|Review Count|\n+--------------+------------+\n|      American|     1730875|\n|       Italian|      355606|\n|       Mexican|      349269|\n|      Japanese|      203535|\n|       Chinese|      180324|\n| Mediterranean|       85214|\n|          Thai|       82042|\n|        Indian|       70876|\n|    Vietnamese|       58903|\n|        French|       39742|\n|        Korean|       26984|\n|         Greek|       16807|\n|Middle Eastern|       15364|\n|       Spanish|       15283|\n|      Hawaiian|       11284|\n|       African|        3872|\n+--------------+------------+\n\n"},{"type":"TABLE","data":"Cuisine Type\tReview Count\nAmerican\t1730875\nItalian\t355606\nMexican\t349269\nJapanese\t203535\nChinese\t180324\nMediterranean\t85214\nThai\t82042\nIndian\t70876\nVietnamese\t58903\nFrench\t39742\nKorean\t26984\nGreek\t16807\nMiddle Eastern\t15364\nSpanish\t15283\nHawaiian\t11284\nAfrican\t3872\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=225"},{"jobUrl":"http://node-master:4040/jobs/job?id=226"},{"jobUrl":"http://node-master:4040/jobs/job?id=227"},{"jobUrl":"http://node-master:4040/jobs/job?id=228"},{"jobUrl":"http://node-master:4040/jobs/job?id=229"},{"jobUrl":"http://node-master:4040/jobs/job?id=230"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774232110300_737419269","id":"paragraph_1774232110300_737419269","dateCreated":"2026-03-23T10:15:10+0800","dateStarted":"2026-03-23T16:02:03+0800","dateFinished":"2026-03-23T16:02:11+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n","user":"anonymous","dateUpdated":"2026-03-23T10:59:17+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774234757768_1731149994","id":"paragraph_1774234757768_1731149994","dateCreated":"2026-03-23T10:59:17+0800","status":"READY"}],"name":"business-analysis","id":"2MMMZUCG2","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/business-analysis"}