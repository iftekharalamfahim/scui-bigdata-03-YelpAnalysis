{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\n# Count 5‑star reviews per business\r\nfive_star_counts = (spark.table(\"review\")\r\n                    .filter(F.col(\"stars\") == 5)\r\n                    .groupBy(\"business_id\")\r\n                    .count()\r\n                    .withColumnRenamed(\"count\", \"five_star_count\"))\r\n\r\n# Join with business table to get names and take top 20\r\ndf = (five_star_counts\r\n      .join(spark.table(\"business\"), \"business_id\")\r\n      .select(\"name\", \"five_star_count\")\r\n      .orderBy(F.desc(\"five_star_count\"))\r\n      .limit(20))\r\n\r\nprint(\"=== Top 20 Merchants with Most 5-Star Reviews ===\")\r\ndf.show(20, truncate=False)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: name, values: five_star_count)","user":"anonymous","dateUpdated":"2026-03-23T14:06:36+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Merchants with Most 5-Star Reviews ===\n+----------------------------------+---------------+\n|name                              |five_star_count|\n+----------------------------------+---------------+\n|Reading Terminal Market           |4014           |\n|Oceana Grill                      |4012           |\n|Hattie B’s Hot Chicken - Nashville|3