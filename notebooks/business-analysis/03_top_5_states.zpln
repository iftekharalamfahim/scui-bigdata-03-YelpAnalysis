{"paragraphs":[{"text":"%pyspark\r\n# Table: business\r\ndf = spark.table(\"business\") \\\r\n    .groupBy(\"state\") \\\r\n    .count() \\\r\n    .orderBy(F.desc(\"count\")) \\\r\n    .limit(5)\r\n\r\nprint(\"=== Top 5 States with Most Merchants ===\")\r\ndf.show(5)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: state, values: count)","user":"anonymous","dateUpdated":"2026-03-23T11:48:44+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 5 States with Most Merchants ===\n+-----+-----+\n|state|count|\n+-----+-----+\n|   PA|34039|\n|   FL|26330|\n|   TN|12056|\n|   IN|11247|\n|   MO|10913|\n+-----+-----+\n\n"},{"type":"TABLE","data":"state\tcount\nPA\t34039\nFL\t26330\nTN\t12056\nIN\t11247\nMO\t10913\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=70"},{"jobUrl":"http://node-master:4040/jobs/job?id=71"},{"jobUrl":"http://node-master:4040/jobs/job?id=72"},{"jobUrl":"http://node-master:4040/jobs/job?id=73"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774232110300_737419269","id":"paragraph_1774232110300_737419269","dateCreated":"2026-03-23T10:15:10+0800","dateStarted":"20