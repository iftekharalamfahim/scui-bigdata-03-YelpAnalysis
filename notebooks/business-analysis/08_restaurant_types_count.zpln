{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\nbusiness_df = spark.table(\"business\")\r\n\r\nresult = business_df \\\r\n    .filter(business_df.categories.like(\"%Restaurants%\")) \\\r\n    .selectExpr(\r\n        \"CASE \" +\r\n        \"  WHEN categories LIKE '%American%'       THEN 'American'       \" +\r\n        \"  WHEN categories LIKE '%Mexican%'        THEN 'Mexican'        \" +\r\n        \"  WHEN categories LIKE '%Italian%'        THEN 'Italian'        \" +\r\n        \"  WHEN categories LIKE '%Japanese%'       THEN 'Japanese'       \" +\r\n        \"  WHEN categories LIKE '%Chinese%'        THEN 'Chinese'        \" +\r\n        \"  WHEN categories LIKE '%Thai%'           THEN 'Thai'           \" +\r\n        \"  WHEN categories LIKE '%Mediterranean%'  THEN 'Mediterranean'  \" +\r\n        \"  WHEN categories LIKE '%French%'         THEN 'French'         \" +\r\n        \"  WHEN categories LIKE '%Vietnamese%'     THEN 'Vietnamese'     \" +\r\n        \"  WHEN categories LIKE '%Greek%'          THEN 'Greek'          \" +\r\n        \"  WHEN categories LIKE '%Indian%'         THEN 'Indian'         \" +\r\n        \"  WHEN categories LIKE '%Korean%'         THEN 'Korean'         \" +\r\n        \"  WHEN categories LIKE '%Hawaiian%'       THEN 'Hawaiian'       \" +\r\n        \"  WHEN categories LIKE '%African%'        THEN 'African'        \" +\r\n        \"  WHEN categories LIKE '%Spanish%'        THEN 'Spanish'        \" +\r\n        \"  WHEN categories LIKE '%Middle Eastern%' THEN 'Middle Eastern' \" +\r\n        \"  ELSE 'Other' \" +\r\n        \"END AS cuisine_type\"\r\n    ) \\\r\n    .filter(\"cuisine_type != 'Other'\") \\\r\n    .groupBy(\"cuisine_type\") \\\r\n    .count() \\\r\n    .withColumnRenamed(\"count\", \"Restaurant Count\") \\\r\n    .withColumnRenamed(\"cuisine_type\", \"Cuisine Type\") \\\r\n    .orderBy(\"Restaurant Count\", ascending=False)\r\n\r\nprint(\"=== Number of Restaurant Types ===\")\r\nresult.show(16)\r\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-23T16:01:08+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":309,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"Restaurant Count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Restaurant Types ===\n+--------------+----------------+\n|  Cuisine Type|Restaurant Count|\n+--------------+----------------+\n|      American|           13066|\n|       Mexican|            4049|\n|       Italian|            3997|\n|       Chinese|            2719|\n|      Japanese|            1765|\n| Mediterranean|             920|\n|        Indian|             754|\n|          Thai|             687|\n|    Vietnamese|             592|\n|        Korean|             291|\n|        French|             276|\n|         Greek|             242|\n|Middle Eastern|             188|\n|      Hawaiian|             120|\n|       Spanish|             114|\n|       African|              84|\n+--------------+----------------+\n\n"},{"type":"TABLE","data":"Cuisine Type\tRestaurant Count\nAmerican\t13066\nMexican\t4049\nItalian\t3997\nChinese\t2719\nJapanese\t1765\nMediterranean\t920\nIndian\t754\nThai\t687\nVietnamese\t592\nKorean\t291\nFrench\t276\nGreek\t242\nMiddle Eastern\t188\nHawaiian\t120\nSpanish\t114\nAfrican\t84\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in 