{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\n# List of cuisine categories as given\r\ncuisines = [\r\n    \"American\", \"Mexican\", \"Italian\", \"Japanese\", \"Chinese\", \"Thai\",\r\n    \"Mediterranean\", \"French\", \"Vietnamese\", \"Greek\", \"Indian\", \"Korean\",\r\n    \"Hawaiian\", \"African\", \"Spanish\", \"Middle Eastern\"\r\n]\r\n\r\ndata = []\r\nfor cuisine in cuisines:\r\n    cnt = (spark.table(\"business\")\r\n           .filter(F.col(\"categories\").contains(cuisine))\r\n           .count())\r\n    data.append((cuisine, cnt))\r\n\r\ndf = spark.createDataFrame(data, [\"cuisine\", \"count\"])\r\nprint(\"=== Number of Restaurant Types ===\")\r\ndf.show()\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: cuisine, values: count)","user":"anonymous","dateUpdated":"2026-03-23T14:30:03+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Number of Restaurant Types ===\n+--------------+-----+\n|       cuisine|count|\n+--------------+-----+\n|      American|13066|\n|       Mexican| 4614|\n|       Italian| 4573|\n|      Japanese| 1830|\n|       Chinese| 3343|\n|          Thai|  991|\n| Mediterranean| 1263|\n|        French|  503|\n|    Vietnamese|  852|\n|         Greek|  779|\n|        Indian|  838|\n|        Korean|  497|\n|      Hawaiian|  185|\n|       African|  115|\n|       Spanish|  286|\n|Middle Eastern|  588|\n+--------------+-----+\n\n"},{"type":"TABLE","data":"cuisine\tcount\nAmerican\t13066\nMexican\t4614\nItalian\t4573\nJapanese\t1830\nChinese\t3343\nThai\t991\nMediterranean\t1263\nFrench\t503\nVietnamese\t852\nGreek\t779\nIndian\t838\nKorean\t497\nHawaiian\t185\nAfrican\t115\nSpanish\t286\nMiddle Eastern\t588\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=120"},{"jobUrl":"http://node-master:4040/jobs/job?id=121"},{"jobUrl":"http://node-master:4040/jobs/job?id=122"},{"jobUrl":"http://node-master:4040/jobs/job?id=123"},{"jobUrl":"http://node-master:4040/jobs/job?id=124"},{"jobUrl":"http://node-master:4040/jobs/job?id=125"},{"jobUrl":"http://node-master:4040/jobs/job?id=126"},{"jobUrl":"http://node-master:4040/jobs/job?id=127"},{"jobUrl":"http://node-master:4040/jobs/job?id=128"},{"jobUrl":"http://node-master:4040/jobs/job?id=129"},{"jobUrl":"http://node-master:4040/jobs/job?id=130"},{"jobUrl":"http://node-master:4040/jobs/job?id=131"},{"jobUrl":"http://node-master:4040/jobs/job?id=132"},{"jobUrl":"http://node-master:4040/jobs/job?id=133"},{"jobUrl":"http://node-master:4040/jobs/job?id=134"},{"jobUrl":"http://node-master:4040/jobs/job?id=135"},{"jobUrl":"http://node-master:4040/jobs/job?id=136"},{"jobUrl":"http://node-master:4040/jobs/job?id=137"},{"jobUrl":"http://node-master:4040/jobs/job?id=138"},{"jobUrl":"http://node-master:4040/jobs/job?id=139"},{"jobUrl":"http://node-master:4040/jobs/job?id=140"},{"jobUrl":"http://node-master:4040/jobs/job?id=141"},{"jobUrl":"http://node-master:4040/jobs/job?id=142"},{"jobUrl":"http://node-master:4040/jobs/job?id=143"},{"jobUrl":"http://node-master:4040/jobs/job?id=144"},{"jobUrl":"http://node-master:4040/jobs/job?id=145"},{"jobUrl":"http://node-master:4040/jobs/job?id=146"},{"jobUrl":