{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\ndf = (spark.table(\"business\")\r\n      .filter(F.col(\"categories\").isNotNull())\r\n      .select(F.split(\"categories\", \", \").alias(\"cat_array\"))\r\n      .select(F.explode(\"cat_array\").alias(\"category\"))\r\n      .groupBy(\"category\")\r\n      .count()\r\n      .orderBy(F.desc(\"count\"))\r\n      .limit(10))\r\n\r\nprint(\"=== Top 10 Most Frequent Categories ===\")\r\ndf.show(10, truncate=False)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: category, values: count)","user":"anonymous","dateUpdated":"2026-03-23T14:00:47+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 10 Most Frequent Categories ===\n+----------------+-----+\n|category        |count|\n+----------------+-----+\n|Restaurants     |52268|\n|Food            |27781|\n|Shopping        |24395|\n|Home Services   |14356|\n|Beauty & Spas   |14292|\n|Nightlife       |12281|\n|Health & Medical|11890|\n|Local Services  |11198|\n|Bars            |11065|\n|Automotive      |10773|\n+----------------+-----+\n\n"},{"type":"TABLE","data":"category\tcount\nRestaurants\t52268\nFood\t27781\nShopping\t24395\nHome Services\t14356\nBeauty & Spas\t14292\nNightlife\t12281\nHealth & Medical\t11890\nLocal Services\t1