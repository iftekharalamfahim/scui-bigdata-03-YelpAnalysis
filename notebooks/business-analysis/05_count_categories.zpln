{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\ncategory_count = (spark.table(\"business\")\r\n                  .filter(F.col(\"categories\").isNotNull())\r\n                  .select(F.split(\"categories\", \", \").alias(\"cat_array\"))\r\n                  .select(F.explode(\"cat_array\").alias(\"category\"))\r\n                  .distinct()\r\n                  .count())\r\n\r\nprint(f\"=== Total Distinct Categories ===\\n{category_count}\")","user":"anonymous","dateUpdated":"2026-03-23T13:51:28+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Total Distinct Categories ===\n1311\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=97"},{"jobUrl":"http://node-master:4040/jobs/job?id=98"},{"jobUrl":"http://node-master:4040/jobs/job?id=99"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774232110300_737419269","id":"paragraph_1774232110300_737419269","dateCreated":"2026-03-23T10:15:10+0800","dateStarted":"2026-03-23T13:51:28+0800","dateFinished":"2026-03-23T13:51:29+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n","user":"anonymous","dateUpdated":"2026-03-23T10:59:17+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774234757768_1731149994","id":"paragraph_1774234757768_1731149994","dateCreated":"2026-03-23T10:59:17+0800","status":"READY"}],"name":"business-analysis","id":"2MMMZUCG2","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/business-analysis"}