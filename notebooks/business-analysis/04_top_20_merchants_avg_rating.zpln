{"paragraphs":[{"text":"%pyspark\r\n# Table: business\r\ndf = spark.table(\"business\") \\\r\n    .groupBy(\"name\") \\\r\n    .agg(\r\n        F.count(\"*\").alias(\"count\"),\r\n        F.avg(\"stars\").alias(\"avg_rating\")\r\n    ) \\\r\n    .orderBy(F.desc(\"count\")) \\\r\n    .limit(20)\r\n\r\nprint(\"=== Top 20 Merchants with Average Ratings ===\")\r\ndf.show(20, truncate=False)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: name, values: count, avg_rating)","user":"anonymous","dateUpdated":"2026-03-23T13:11:39+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"table","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Merchants with Average Ratings ===\n+---------------------+-----+------------------+\n|name                 |count|avg_rating        |\n+---------------------+-----+------------------+\n|Starbucks            |724  |3.126381215469613 |\n|McDonald's           |703  |1.8634423897581793|\n|Dunkin'              |510  |2.302941176470588 |\n|Subway               |459  |2.5860566448801743|\n|Taco Bell            |365  |2.154794520547945 |\n|CVS Pharmacy         |345  |2.4565217391304346|\n|Walgreens            |341  |2.624633431085044 |\n|Burger King          |338  |2.0281065088757395|\n|Wendy's              |331  |2.015105740181269 |\n|Wawa                 |307  |3.3192182410423454|\n|Domino