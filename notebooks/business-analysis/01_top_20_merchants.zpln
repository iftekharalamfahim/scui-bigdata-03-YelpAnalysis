{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\n# Table: business\r\ndf = spark.table(\"business\") \\\r\n    .groupBy(\"name\") \\\r\n    .count() \\\r\n    .orderBy(F.desc(\"count\")) \\\r\n    .limit(20)\r\n\r\nprint(\"=== Top 20 Most Common Merchants ===\")\r\ndf.show(20, truncate=False)\r\nz.show(df)\r\n# Chart suggestion: bar chart (keys: name, values: count)","user":"anonymous","dateUpdated":"2026-03-23T11:13:23+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":307,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"name","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 20 Most Common Merchants ===\n+---------------------+-----+\n|name                 |count|\n+---------------------+-----+\n|Starbucks            |724  |\n|McDonald's           |703  |\n|Dunkin'              |510  |\n|Subway               |459  |\n|Taco Bell            |365  |\n|CVS Pharmacy         |345  |\n|Walgreens            |341  |\n|Burger King          |338  |\n|Wendy's              |331  |\n|Wawa                 |307  |\n|Domino's Pizza       |295  |\n|The UPS Store        |281  |\n|Pizza Hut            |272  |\n|Enterprise Rent-A-Car|232  |\n|Papa John's Pizza    |196  |\n|Great Clips          |185  |\n|Jimmy John's         |175  |\n|US Post Office       |174  |\n|KFC                  |171  |\n|Chick-fil-A 