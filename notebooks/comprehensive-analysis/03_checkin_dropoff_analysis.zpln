tp://node-master:4040/jobs/job?id=419"},{"jobUrl":"http://node-master:4040/jobs/job?id=420"},{"jobUrl":"http://node-master:4040/jobs/job?id=421"},{"jobUrl":"http://node-master:4040/jobs/job?id=422"},{"jobUrl":"http://node-master:4040/jobs/job?id=423"},{"jobUrl":"http://node-master:4040/jobs/job?id=424"},{"jobUrl":"http://node-master:4040/jobs/job?id=425"},{"jobUrl":"http://node-master:4040/jobs/job?id=426"},{"jobUrl":"http://node-master:4040/jobs/job?id=427"},{"jobUrl":"http://node-master:4040/jobs/job?id=428"},{"jobUrl":"http://node-master:4040/jobs/job?id=429"},{"jobUrl":"http://node-master:4040/jobs/job?id=430"},{"jobUrl":"http://node-master:4040/jobs/job?id=431"},{"jobUrl":"http://node-master:4040/jobs/job?id=432"},{"jobUrl":"http://node-master:4040/jobs/job?id=433"},{"jobUrl":"http://node-master:4040/jobs/job?id=434"},{"jobUrl":"http://node-master:4040/jobs/job?id=435"},{"jobUrl":"http://node-master:4040/jobs/job?id=436"},{"jobUrl":"http://node-master:4040/jobs/job?id=437"},{"jobUrl":"http://node-master:4040/jobs/job?id=438"},{"jobUrl":"http://node-master:4040/jobs/job?id=439"},{"jobUrl":"http://node-master:4040/jobs/job?id=440"},{"jobUrl":"http://node-master:4040/jobs/job?id=441"},{"jobUrl":"http://node-master:4040/jobs/job?id=442"},{"jobUrl":"http://node-master:4040/jobs/job?id=443"},{"jobUrl":"http://node-master:4040/jobs/job?id=444"},{"jobUrl":"http://node-master:4040/jobs/job?id=445"},{"jobUrl":"http://node-master:4040/jobs/job?id=446"},{"jobUrl":"http://node-master:4040/jobs/job?id=447"},{"jobUrl":"http://node-master:4040/jobs/job?id=448"},{"jobUrl":"http://node-master:4040/jobs/job?id=449"},{"jobUrl":"http://node-master:4040/jobs/job?id=450"},{"jobUrl":"http://node-master:4040/jobs/job?id=451"},{"jobUrl":"http://node-master:4040/jobs/job?id=452"},{"jobUrl":"http://node-master:4040/jobs/job?id=453"},{"jobUrl":"http://node-master:4040/jobs/job?id=454"},{"jobUrl":"http://node-master:4040/jobs/job?id=455"},{"jobUrl":"http://node-master:4040/jobs/job?id=456"},{"jobUrl":"http://node-master:4040/jobs/job?id=457"},{"jobUrl":"http://node-master:4040/jobs/job?id=458"},{"jobUrl":"http://node-master:4040/jobs/job?id=459"},{"jobUrl":"http://node-master:4040/jobs/job?id=460"},{"jobUrl":"http://node-master:4040/jobs/job?id=461"},{"jobUrl":"http://node-master:4040/jobs/job?id=462"},{"jobUrl":"http://node-master:4040/jobs/job?id=463"},{"jobUrl":"http://node-master:4040/jobs/job?id=464"},{"jobUrl":"http://node-master:4040/jobs/job?id=465"},{"jobUrl":"http://node-master:4040/jobs/job?id=466"},{"jobUrl":"http://node-master:4040/jobs/job?id=467"},{"jobUrl":"http://node-master:4040/jobs/job?id=468"},{"jobUrl":"http://node-master:4040/jobs/job?id=469"},{"jobUrl":"http://node-master:4040/jobs/job?id=470"},{"jobUrl":"http://node-master:4040/jobs/job?id=471"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774328995069_1311973203","id":"paragraph_1774328995069_1311973203","dateCreated":"2026-03-24T13:09:55+0800","status":"FINISHED","focus":false,"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\nfrom pyspark.sql.window import Window\r\n\r\nbusiness_df = spark.table(\"business\")\r\nreview_df = spark.table(\"review\")\r\ncheckin_df = spark.table(\"checkin\")\r\n\r\n# ============================================================\r\n# Task VI-3: Post 1-Star Spike Check-in Drop-off Analysis\r\n# For businesses that received a sudden spike in 1-star reviews\r\n# within a single week, calculate the percentage drop in their\r\n# check-in volume in the following month.\r\n# ============================================================\r\n\r\n# Step 1: Count 1-star reviews per business per week\r\nprint(\"Step 1: Counting 1-star reviews per business per week...\")\r\nweekly_1star = review_df \\\r\n    .filter(F.col(\"stars\") == 1) \\\r\n    .withColumn(\"week\", F.date_trunc(\"week\", F.col(\"date\"))) \\\r\n    .groupBy(\"business_id\", \"week\") \\\r\n    .agg(F.count(\"*\").alias(\"weekly_1star_count\"))\r\n\r\n# Step 2: Find average weekly 1-star reviews per business\r\nprint(\"Step 2: Calculating average weekly 1-star reviews per business...\")\r\navg_weekly_1star = weekly_1star \\\r\n    .groupBy(\"business_id\") \\\r\n    .agg(F.avg(\"weekly_1star_count\").alias(\"avg_weekly_1star\"))\r\n\r\n# Step 3: Identify spike weeks (3x above average = spike)\r\nprint(\"Step 3: Identifying spike weeks (3x above average)...\")\r\nspike_weeks = weekly_1star \\\r\n    .join(avg_weekly_1star, \"business_id\") \\\r\n    .filter(F.col(\"weekly_1star_count\") >= F.col(\"avg_weekly_1star\") * 3) \\\r\n    .filter(F.col(\"avg_weekly_1star\") >= 1) \\\r\n    .groupBy(\"business_id\") \\\r\n    .agg(F.min(\"week\").alias(\"spike_week\"))\r\n\r\nspike_count = spike_weeks.count()\r\nprint(f\"Total businesses with 1-star spikes: {spike_count}\")\r\n\r\n# Step 4: Explode checkin dates\r\nprint(\"Step 4: Exploding checkin dates...\")\r\ncheckin_exploded = checkin_df \\\r\n    .select(\r\n        \"business_id\",\r\n        F.explode(F.split(F.col(\"date\"), \", \")).alias(\"checkin_date\")\r\n    ) \\\r\n    .withColumn(\"checkin_date\", F.to_timestamp(\"checkin_date\"))\r\n\r\n# Step 5: Count checkins BEFORE spike week (30 days before)\r\nprint(\"Step 5: Counting checkins 30 days before spike...\")\r\ncheckins_before = checkin_exploded \\\r\n    .join(spike_weeks, \"business_id\") \\\r\n    .filter(\r\n        (F.col(\"checkin_date\") >= F.date_sub(F.col(\"spike_week\"), 30)) &\r\n        (F.col(\"checkin_date\") < F.col(\"spike_week\"))\r\n    ) \\\r\n    .groupBy(\"business_id\") \\\r\n    .agg(F.count(\"*\").alias(\"checkins_before\"))\r\n\r\n# Step 6: Count checkins AFTER spike week (30 days after)\r\nprint(\"Step 6: Counting checkins 30 days after spike...\")\r\ncheckins_after = checkin_exploded \\\r\n    .join(spike_weeks, \"business_id\") \\\r\n    .filter(\r\n        (F.col(\"checkin_date\") >= F.col(\"spike_week\")) &\r\n        (F.col(\"checkin_date\") < F.date_add(F.col(\"spike_week\"), 30))\r\n    ) \\\r\n    .groupBy(\"business_id\") \\\r\n    .agg(F.count(\"*\").alias(\"checkins_after\"))\r\n\r\n# Step 7: Calculate percentage change with minimum 10 checkins filter\r\nprint(\"Step 7: Calculating percentage change...\")\r\nresult = checkins_before \\\r\n    .join(checkins_after, \"business_id\", \"left\") \\\r\n    .fillna(0, subset=[\"checkins_after\"]) \\\r\n    .withColumn(\r\n        \"pct_drop\",\r\n        F.round(\r\n            (F.col(\"checkins_before\") - F.col(\"checkins_after\")) /\r\n            F.col(\"checkins_before\") * 100,\r\n            2\r\n        )\r\n    ) \\\r\n    .filter(F.col(\"checkins_before\") >= 10) \\\r\n    .join(business_df.select(\"business_id\", \"name\", \"city\", \"state\"), \"business_id\") \\\r\n    .withColumn(\r\n        \"Impact Category\",\r\n        F.when(F.col(\"pct_drop\") > 0, \"Drop in Checkins\")\r\n         .when(F.col(\"pct_drop\") == 0, \"No Change\")\r\n         .otherwise(\"Increase in Checkins\")\r\n    ) \\\r\n    .select(\r\n        F.col(\"name\").alias(\"Business Name\"),\r\n        F.col(\"city\").alias(\"City\"),\r\n        F.col(\"state\").alias(\"State\"),\r\n        F.col(\"checkins_before\").alias(\"Checkins Before Spike\"),\r\n        F.col(\"checkins_after\").alias(\"Checkins After Spike\"),\r\n        F.col(\"pct_drop\").alias(\"% Change in Checkins\"),\r\n        F.col(\"Impact Category\")\r\n    ) \\\r\n    .orderBy(\"% Change in Checkins\", ascending=False)\r\n\r\n# ============================================================\r\n# Output 1: Full results\r\n# ============================================================\r\nprint(\"\\n=== Post 1-Star Spike Check-in Drop-off Analysis ===\")\r\nresult.show(20)\r\nz.show(result)\r\n\r\n# ============================================================\r\n# Output 2: Summary by impact category\r\n# ============================================================\r\nprint(\"\\n=== Summary by Impact Category ===\")\r\ncategory_summary = result \\\r\n    .groupBy(\"Impact Category\") \\\r\n    .agg(\r\n        F.count(\"*\").alias(\"Business Count\"),\r\n        F.round(F.avg(\"% Change in Checkins\"), 2).alias(\"Avg % Change\"),\r\n        F.round(F.max(\"% Change in Checkins\"), 2).alias(\"Max % Change\"),\r\n        F.round(F.min(\"% Change in Checkins\"), 2).alias(\"Min % Change\")\r\n    ) \\\r\n    .orderBy(\"Business Count\", ascending=False)\r\n\r\ncategory_summary.show()\r\nz.show(category_summary)\r\n\r\n# ============================================================\r\n# Output 3: Businesses that DROPPED\r\n# ============================================================\r\nprint(\"\\n=== Businesses With Drop in Checkins ===\")\r\ndropped = result \\\r\n    .filter(F.col(\"Impact Category\") == \"Drop in Checkins\") \\\r\n    .agg(\r\n        F.count(\"*\").alias(\"Total Businesses\"),\r\n        F.round(F.avg(\"% Change in Checkins\"), 2).alias(\"Avg % Drop\"),\r\n        F.round(F.max(\"% Change in Checkins\"), 2).alias(\"Max % Drop\"),\r\n        F.round(F.min(\"% Change in Checkins\"), 2).alias(\"Min % Drop\")\r\n    )\r\ndropped.show()\r\nz.show(dropped)\r\n\r\n# ============================================================\r\n# Output 4: Businesses that INCREASED (curiosity effect)\r\n# ============================================================\r\nprint(\"\\n=== Businesses With Increase in Checkins (Curiosity Effect) ===\")\r\nincreased = result \\\r\n    .filter(F.col(\"Impact Category\") == \"Increase in Checkins\") \\\r\n    .select(\r\n        \"Business Name\",\r\n        \"City\",\r\n        \"State\",\r\n        \"Checkins Before Spike\",\r\n        \"Checkins After Spike\",\r\n        \"% Change in Checkins\"\r\n    ) \\\r\n    .orderBy(\"% Change in Checkins\", ascending=True) \\\r\n    .limit(20)\r\nincreased.show()\r\nz.show(increased)\r\n\r\n# ============================================================\r\n# Output 5: Overall summary statistics\r\n# ============================================================\r\nprint(\"\\n=== Overall Summary Statistics ===\")\r\noverall_summary = result \\\r\n    .agg(\r\n        F.count(\"*\").alias(\"Total Businesses Analyzed\"),\r\n        F.sum(F.when(F.col(\"Impact Category\") == \"Drop in Checkins\", 1).otherwise(0))\r\n         .alias(\"Businesses With Drop\"),\r\n        F.sum(F.when(F.col(\"Impact Category\") == \"Increase in Checkins\", 1).otherwise(0))\r\n         .alias(\"Businesses With Increase\"),\r\n        F.sum(F.when(F.col(\"Impact Category\") == \"No Change\", 1).otherwise(0))\r\n         .alias(\"Businesses With No Change\"),\r\n        F.round(F.avg(\r\n            F.when(F.col(\"Impact Category\") == \"Drop in Checkins\",\r\n                   F.col(\"% Change in Checkins\"))\r\n        ), 2).alias(\"Avg Drop %\"),\r\n        F.round(F.avg(\r\n            F.when(F.col(\"Impact Category\") == \"Increase in Checkins\",\r\n                   F.col(\"% Change in Checkins\"))\r\n        ), 2).alias(\"Avg Increase %\")\r\n    )\r\noverall_summary.show()\r\nz.show(overall_summary)","dateUpdated":"2026-03-24T13:23:38+0800","dateFinished":"2026-03-24T13:25:57+0800","dateStarted":"2026-03-24T13:23:38+0800","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Step 1: Counting 1-star reviews per business per week...\nStep 2: Calculating average weekly 1-star reviews per business...\nStep 3: Identifying spike weeks (3x above average)...\nTotal businesses with 1-star spikes: 936\nStep 4: Exploding checkin dates...\nStep 5: Counting checkins 30 days before spike...\nStep 6: Counting checkins 30 days after spike...\nStep 7: Calculating percentage change...\n\n=== Post 1-Star Spike Check-in Drop-off Analysis ===\n+--------------------+-------------+-----+---------------------+--------------------+--------------------+----------------+\n|       Business Name|         City|State|Checkins Before Spike|Checkins After Spike|% Change in Checkins| Impact Category|\n+--------------------+-------------+-----+---------------------+--------------------+--------------------+----------------+\n|Kid Rock's Big Ho...|    Nashville|   TN|                   19|                   0|               100.0|Drop in Checkins|\n|         Smashburger|   Clearwater|   FL|                   12|                   2|               83.33|Drop in Checkins|\n|  Grille One Sixteen|        Tampa|   FL|                   17|                   3|               82.35|Drop in Checkins|\n|    Chima Steakhouse| Philadelphia|   PA|                   27|                   5|               81.48|Drop in Checkins|\n|                 Opa| Philadelphia|   PA|                   10|                   2|                80.0|Drop in Checkins|\n|     Darling's Diner| Philadelphia|   PA|                   19|                   4|               78.95|Drop in Checkins|\n|        Krispy Kreme|       Tucson|   AZ|                   18|                   4|               77.78|Drop in Checkins|\n|       Keg & Kitchen|     Westmont|   NJ|                   17|                   4|               76.47|Drop in Checkins|\n| Bearss Tavern + Tap|        Tampa|   FL|                   25|                   6|                76.0|Drop in Checkins|\n|         Tradesman's| Philadelphia|   PA|                   15|                   4|               73.33|Drop in Checkins|\n|      Lucky Pierre's|  New Orleans|   LA|                   11|                   3|               72.73|Drop in Checkins|\n|   Caesars Superdome|  New Orleans|   LA|                   30|                   9|                70.0|Drop in Checkins|\n|       Café Adelaide|  New Orleans|   LA|                   19|                   6|               68.42|Drop in Checkins|\n|       Round1 Tucson|       Tucson|   AZ|                   12|                   4|               66.67|Drop in Checkins|\n|Joellas's Hot Chi...|        Largo|   FL|                   21|                   7|               66.67|Drop in Checkins|\n|Sheraton Suites P...| Philadelphia|   PA|                   12|                   4|               66.67|Drop in Checkins|\n| Viva Modern Mexican|Santa Barbara|   CA|                   12|                   4|               66.67|Drop in Checkins|\n|        Porano Pasta|  Saint Louis|   MO|                   12|                   4|               66.67|Drop in Checkins|\n|             Melba's|  New Orleans|   LA|                   18|                   6|               66.67|Drop in Checkins|\n|     Mortar & Pestle|        Tampa|   FL|                   12|                   4|               66.67|Drop in Checkins|\n+--------------------+-------------+-----+---------------------+--------------------+--------------------+----------------+\nonly showing top 20 rows\n\n"},{"type":"TABLE","data":"Business Name\tCity\tState\tCheckins Before Spike\tCheckins After Spike\t% Change in Checkins\tImpact Category\nKid Rock's Big Honky Tonk and Rock n' Roll Steakhouse\tNashville\tTN\t19\t0\t100.0\tDrop in Checkins\nSmashburger\tClearwater\tFL\t12\t2\t83.33\tDrop in Checkins\nGrille One Sixteen\tTampa\tFL\t17\t3\t82.35\tDrop in Checkins\nChima Steakhouse\tPhiladelphia\tPA\t27\t5\t81.48\tDrop in Checkins\nOpa\tPhiladelphia\tPA\t10\t2\t80.0\tDrop in Checkins\nDarling's Diner\tPhiladelphia\tPA\t19\t4\t78.95\tDrop in Checkins\nKrispy Kreme\tTucson\tAZ\t18\t4\t77.78\tDrop in Checkins\nKeg & Kitchen\tWestmont\tNJ\t17\t4\t76.47\tDrop in Checkins\nBearss Tavern + Tap\tTampa\tFL\t25\t6\t76.0\tDrop in Checkins\nTradesman's\tPhiladelphia\tPA\t15\t4\t73.33\tDrop in Checkins\nLucky Pierre's\tNew Orleans\tLA\t11\t3\t72.73\tDrop in Checkins\nCaesars Superdome\tNew Orleans\tLA\t30\t9\t70.0\tDrop in Checkins\nCafé Adelaide\tNew Orleans\tLA\t19\t6\t68.42\tDrop in Checkins\nRound1 Tucson\tTucson\tAZ\t12\t4\t66.67\tDrop in Checkins\nViva Modern Mexican\tSanta Barbara\tCA\t12\t4\t66.67\tDrop in Checkins\nSheraton Suites Philadelphia Airport\tPhiladelphia\tPA\t12\t4\t66.67\tDrop in Checkins\nJoellas's Hot Chicken - 