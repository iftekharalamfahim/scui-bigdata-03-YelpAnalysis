7413745124\nGarden City\t1\tDent Artist Paintless Dent Removal\t5.0\t105\t9\t0.4042140418434688\nGarden City\t2\tGarage Door Store Boise\t5.0\t34\t1\t0.40135353342540775\nGarden City\t3\tCarl's Auto Repair\t5.0\t29\t5\t0.40117834365980826\nGarden City\t4\tCounty Line Brewing\t5.0\t18\t32\t0.40089763620924207\nGarden City\t5\tCoiled Wines\t5.0\t14\t35\t0.40075633373705083\nGardenville\t1\tGardenville Hotel\t4.0\t44\t65\t0.32211815045277126\nGarnet Valley\t1\tBooths Corner Farmers Market\t4.5\t74\t429\t0.3654015688868102\nGarnet Valley\t2\tKapow Kitchen\t4.5\t32\t47\t0.36153890397513605\nGarnet Valley\t3\tBethel Cleaning Services\t4.5\t19\t3\t0.36077043114303087\nGarnet Valley\t4\tGia's Steaks and Hoagies\t4.5\t15\t13\t0.3606694017607445\nGarnet Valley\t5\tFarm To You Kitchen\t4.0\t60\t73\t0.3227984263126928\nGentilly\t1\tThe Original Italian Pie\t3.0\t27\t32\t0.24125440153693756\nGibbsboro\t1\tBlueberry Hill Trail\t4.5\t26\t32\t0.36121476094497146\nGibbsboro\t2\tThe ChopHouse\t4.0\t256\t309\t0.33192576079771297\nGibbsboro\t3\tMasso's Deli & Pizzeria\t3.5\t53\t63\t0.28246340918335106\n"},{"type":"HTML","data":"<div class=\"result-alert alert-warning\" role=\"alert\"><button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button><strong>Output is truncated</strong> to 1000 rows. Learn more about <strong>zeppelin.spark.maxResult</strong></div>\n"}]}},{"text":"%pyspark\nimport pyspark.sql.functions as F\n\n# Step 1: Count total check-ins per business\ncheckin_counts = spark.table(\"checkin\") \\\n    .withColumn(\"checkin_date\", F.explode(F.split(F.col(\"date\"), \",\"))) \\\n    .groupBy(\"business_id\") \\\n    .agg(F.count(\"*\").alias(\"total_checkins\")) \\\n    .orderBy(F.col(\"total_checkins\").desc()) \\\n    .limit(100)\n\n# Step 2: Count total reviews per business\nreview_counts = spark.table(\"yelp.review\") \\\n    .groupBy(\"rev_business_id\") \\\n    .agg(F.count(\"*\").alias(\"total_reviews\"))\n\n# Step 3: Join checkins + reviews + business name\nbiz = spark.table(\"business\").select(\n    \"business_id\",\n    F.substring(\"name\", 1, 25).alias(\"business_name\"),\n    \"city\",\n    \"state\",\n    \"stars\"\n)\n\nresult = checkin_counts \\\n    .join(review_counts,\n          checkin_counts.business_id == review_counts.rev_business_id,\n          \"left\") \\\n    .join(biz, \"business_id\", \"left\") \\\n    .filter(F.col(\"business_name\").isNotNull()) \\\n    .filter(F.col(\"total_reviews\") > 0) \\\n    .withColumn(\n        \"conversion_rate\",\n        F.round(F.col(\"total_checkins\") / F.col(\"total_reviews\"), 3)\n    ) \\\n    .select(\n        \"business_name\",\n        \"city\",\n        \"state\",\n        \"stars\",\n        \"total_checkins\",\n        \"total_reviews\",\n        \"conversion_rate\"\n    ) \\\n    .orderBy(F.col(\"conversion_rate\").desc())\n\nprint(\"=== VI-2: Review Conversion Rate (Top 100 Most Checked-in Businesses) ===\")\nprint(\"Higher rate = more physical visits | Lower rate = more online feedback\")\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-24T23:40:51-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"city","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=70"},{"