{"paragraphs":[{"text":"%pyspark\n# Recreate temporary views from HDFS\nspark.read.json(\"/user/faraz/yelp/business\").createOrReplaceTempView(\"business\")\nspark.read.json(\"/user/faraz/yelp/checkin\").createOrReplaceTempView(\"checkin\")\nspark.read.json(\"/user/faraz/yelp/user\").createOrReplaceTempView(\"user\")\nspark.read.json(\"/user/faraz/yelp/tip\").createOrReplaceTempView(\"tip\")\n\nprint(\"All views recreated!\")\nspark.sql(\"SHOW TABLES\").show()","user":"anonymous","dateUpdated":"2026-03-24T22:52:58-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"city","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"combined_score","index":6,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=54"},{"jobUrl":"http://node-master:4040/jobs/job?id=55"},{"jobUrl":"http://node-master:4040/jobs/job?id=56"},{"jobUrl":"http://node-master:4040/jobs/job?id=57"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774401666684_1437344430","id":"paragraph_1774401666684_1437344430","dateCreated":"2026-03-24T21:21:06-0400","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T22:53:39-0400","dateStarted":"2026-03-24T22:52:58-0400","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"All views recreated!\n+---------+---------+-----------+\n|namespace|tableName|isTemporary|\n+---------+---------+-----------+\n|  default|  student|      false|\n|         | business|       true|\n|         |  checkin|       true|\n|         |      tip|       true|\n|         |     user|       true|\n+---------+---------+-----------+\n\n"}]}},{"text":"%pyspark\nfrom pyspark.sql.functions import col, size, split, count, avg, dense_rank\nfrom pyspark.sql.window import Window\n\n# Correctly count checkins by splitting comma-separated dates\ncheckin_df = spark.table(\"checkin\")\ncheckin_counts = checkin_df.withColumn(\n    \"checkin_count\", \n    size(split(col(\"date\"), \",\"))\n).groupBy(\"business_id\") \\\n .agg({\"checkin_count\": \"sum\"}) \\\n .withColumnRenamed(\"sum(checkin_count)\", \"checkin_count\")\n\n# Get business data\nbiz = spark.table(\"business\")\n\n# Join\ncombined = biz.join(checkin_counts, \"business_id\", \"left\") \\\n    .fillna(0, subset=[\"checkin_count\"]) \\\n    .filter(col(\"city\").isNotNull()) \\\n    .filter(col(\"review_count\") > 10)\n\n# Normalize and combine metrics\nmax_reviews = combined.agg({\"review_count\": \"max\"}).collect()[0][0]\nmax_checkins = combined.agg({\"checkin_count\": \"max\"}).collect()[0][0]\n\nscored = combined.withColumn(\n    \"combined_score\",\n    (col(\"stars\") / 5.0) * 0.4 +\n    (col(\"review_count\") / max_reviews) * 0.3 +\n    (col(\"checkin_count\") / max_checkins) * 0.3\n)\n\n# Rank within each city\nwindow = Window.partitionBy(\"city\").orderBy(col(\"combined_score\").desc())\n\nresult = scored.withColumn(\"rank\", dense_rank().over(window)) \\\n    .filter(col(\"rank\") <= 5) \\\n    .select(\n        col(\"city\"),\n        col(\"rank\"),\n        col(\"name\"),\n        col(\"stars\"),\n        col(\"review_count\"),\n        col(\"checkin_count\"),\n        col(\"combined_score\")\n    ) \\\n    .orderBy(\"city\", \"rank\")\n\nprint(\"=== Top 5 Merchants Per City (Combined Score) ===\")\nz.show(result)","user":"anonymous","dateUpdated":"2026-03-24T22:54:27-0400","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=58"},{"jobUrl":"http://node-master:4040/jobs/job?id=59"},{"jobUrl":"http://node-master:4040/jobs/job?id=60"},{"jobUrl":"http://node-master:4040/jobs/job?id=61"},{"jobUrl":"http://node-master:4040/jobs/job?id=62"},{"jobUrl":"http://node-master:4040/jobs/job?id=63"},{"jobUrl":"http://node-master:4040/jobs/job?id=64"},{"jobUrl":"http://node-master:4040/jobs/job?id=65"},{"jobUrl":"http://node-master:4040/jobs/job?id=66"},{"jobUrl":"http://node-master:4040/jobs/job?id=67"},{"jobUrl":"http://node-master:4040/jobs/job?id=68"},{"jobUrl":"http://node-master:4040/jobs/job?id=69"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774401938788_1455053969","id":"paragraph_1774401938788_1455053969","dateCreated":"2026-03-24T21:25:38-0400","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T22:54:50-0400","dateStarted":"2026-03-24T22:54:27-0400","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Top 5 Merchants Per City (Combined Score) ===\n"},{"type":"TABLE","data":"city\trank\tname\tstars\treview_count\tcheckin_count\tcombined_score\nAVON\t1\tJack's Donuts - Avon\t3.5\t24\t37\t0.2811642462538282\nAbington\t1\t2 Fat Dogs\t5.0\t85\t26\t0.4035190360796286\nAbington\t2\tArte Salon\t5.0\t52\t20\t0.40217637675339785\nAbington\t3\tTom & Sons Auto Repair\t5.0\t49\t4\t0.40196540220057386\nAbington\t4\tThe Junkluggers of Philadelphia & Montgomery County\t5.0\t40\t0\t0.401585623678647\nAbington\t5\tEmoji Sushi & Teriyaki\t5.0\t13\t3\t0.4005325875912338\nAbingto