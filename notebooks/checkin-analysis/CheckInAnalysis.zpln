{"paragraphs":[{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=0"},{"jobUrl":"http://node-master:4040/jobs/job?id=1"},{"jobUrl":"http://node-master:4040/jobs/job?id=2"},{"jobUrl":"http://node-master:4040/jobs/job?id=3"},{"jobUrl":"http://node-master:4040/jobs/job?id=4"},{"jobUrl":"http://node-master:4040/jobs/job?id=5"},{"jobUrl":"http://node-master:4040/jobs/job?id=6"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774333369412_1264204179","id":"paragraph_1774333369412_1264204179","dateCreated":"2026-03-24T14:22:49+0800","status":"FINISHED","focus":false,"text":"%pyspark\r\n\r\nfrom pyspark.sql import functions as F\r\nfrom pyspark.sql.window import Window\r\n\r\n# Load all tables from Hive using spark.table\r\nbusiness = spark.table(\"yelp.business\")\r\nreview   = spark.table(\"yelp.review\")\r\ncheckin  = spark.table(\"yelp.checkin\")\r\n\r\n# Register as temp views\r\nbusiness.createOrReplaceTempView(\"business\")\r\nreview.createOrReplaceTempView(\"review\")\r\ncheckin.createOrReplaceTempView(\"checkin\")\r\n\r\nprint(\"=== Row Counts ===\")\r\nprint(\"business :\", business.count())\r\nprint(\"review   :\", review.count())\r\nprint(\"checkin  :\", checkin.count())\r\n\r\nprint(\"\\n=== Checkin Sample ===\")\r\ncheckin.show(3, truncate=False)","dateUpdated":"2026-03-24T14:30:38+0800","dateFinished":"2026-03-24T14:31:20+0800","dateStarted":"2026-03-24T14:30:38+0800","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Hive Session ID = 8d64d979-5f0c-4362-8a0c-b2ac793616be\n=== Row Counts ===\nbusiness : 150346\nreview   : 6990280\ncheckin  : 131930\n\n=== Checkin Sample ===\n+----------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\n|business_id           |checkin_dates                                                                                                                                                                                                                        |\n+----------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\n|---kPU91CF4Lq2-WlRu9Lw|2020-03-13 21:10:56, 2020-06-02 22:18:06, 2020-07-24 22:42:27, 2020-10-24 21:36:13, 2020-12-09 21:23:33, 2021-01-20 17:34:57, 2021-04-30 21:02:03, 2021-05-25 21:16:54, 2021-08-06 21:08:08, 2021-10-02 15:15:42, 2021-11-11 16:23:50|\n|--0iUa4sNDFiZFrAdIWhZQ|2010-09-13 21:43:09, 2011-05-04 23:08:15, 2011-07-18 22:30:31, 2012-09-07 20:28:50, 2013-03-27 15:57:36, 2013-08-13 00:31:34, 2013-08-13 00:31:48, 2013-09-23 17:39:38, 2013-11-18 06:34:08, 2014-04-12 23:04:47                     |\n|--30_8IhuyMHbSOcNWd6DQ|2013-06-14 23:29:17, 2014-08-13 23:20:22                                                                                                                                                                                             |\n+----------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\nonly showing top 3 rows\n\n"}]}},{"text":"%pyspark\n# Task 1: Count the number of check-ins per year\n\ncheckin_per_year = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .withColumn(\"checkin_year\", F.year(F.to_timestamp(F.trim(F.col(\"date\"))))) \\\n    .filter(F.col(\"checkin_year\").isNotNull()) \\\n    .groupBy(\"checkin_year\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\")) \\\n    .orderBy(\"checkin_year\")\n\nz.show(checkin_per_year)","user":"anonymous","dateUpdated":"2026-03-24T15:33:30+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"checkin_year","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"checkin_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=81"},{"jobUrl":"http://node-master:4040/jobs/job?id=82"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774333377368_1139252173","id":"paragraph_1774333377368_1139252173","dateCreated":"2026-03-24T14:22:57+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T15:08:02+0800","dateStarted":"2026-03-24T15:07:57+0800","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"checkin_year\tcheckin_count\n2009\t2\n2010\t209153\n2011\t901457\n2012\t1289492\n2013\t1552799\n2014\t1625884\n2015\t1709857\n2016\t1554774\n2017\t1348466\n2018\t1157252\n2019\t1035160\n2020\t474172\n2021\t477467\n2022\t20940\n"}]}},{"text":"%pyspark\n# Task 2: Count the number of check-ins per hour within a 24-hour period\n# Shows peak hours of business activity throughout the day\n\ncheckin_per_hour = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .withColumn(\"checkin_hour\", F.hour(F.to_timestamp(F.trim(F.col(\"date\"))))) \\\n    .filter(F.col(\"checkin_hour\").isNotNull()) \\\n    .groupBy(\"checkin_hour\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\")) \\\n    .orderBy(\"checkin_hour\")\n\nz.show(checkin_per_hour)","user":"anonymous","dateUpdated":"2026-03-24T15:33:08+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"lineChart","height":300,"optionOpen":false,"setting":{"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"checkin_hour","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"checkin_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=16"},{"jobUrl":"http://node-master:4040/jobs/job?id=17"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774333939690_1807624378","id":"paragraph_1774333939690_1807624378","dateCreated":"2026-03-24T14:32:19+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T14:35:41+0800","dateStarted":"2026-03-24T14:35:36+0800","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"checkin_hour\tcheckin_count\n0\t1155092\n1\t935985\n2\t669574\n3\t437035\n4\t264905\n5\t152476\n6\t85066\n7\t52295\n8\t35589\n9\t37079\n10\t63824\n11\t115876\n12\t201427\n13\t296364\n14\t407969\n15\t587904\n16\t873108\n17\t1018438\n18\t995358\n19\t922177\n20\t858803\n21\t910653\n22\t1073857\n23\t1206021\n"}]}},{"text":"%pyspark\n# Task 3: Identify the most popular city for check-ins\n\ncheckin_per_city = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .groupBy(\"business_id\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\")) \\\n    .join(business.select(\"business_id\", \"city\", \"state\"),\n          \"business_id\", \"left\") \\\n    .filter(F.col(\"city\").isNotNull()) \\\n    .groupBy(\"city\", \"state\") \\\n    .agg(F.sum(\"checkin_count\").alias(\"total_checkins\")) \\\n    .orderBy(F.col(\"total_checkins\").desc()) \\\n    .limit(20)\n\nz.show(checkin_per_city)","user":"anonymous","dateUpdated":"2026-03-24T15:32:56+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"city","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_checkins","index":2,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=58"},{"jobUrl":"http://node-master:4040/jobs/job?id=59"},{"jobUrl":"http://node-master:4040/jobs/job?id=60"},{"jobUrl":"http://node-master:4040/jobs/job?id=61"},{"jobUrl":"http://node-master:4040/jobs/job?id=62"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774334136222_304746864","id":"paragraph_1774334136222_304746864","dateCreated":"2026-03-24T14:35:36+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T14:53:20+0800","dateStarted":"2026-03-24T14:53:17+0800","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"city\tstate\ttotal_checkins\nPhiladelphia\tPA\t1836160\nNew Orleans\tLA\t1486452\nTampa\tFL\t918172\nIndianapolis\tIN\t886001\nNashville\tTN\t817258\nTucson\tAZ\t772140\nReno\tNV\t712285\nSaint Louis\tMO\t638978\nSanta Barbara\tCA\t507626\nEdmonton\tAB\t193675\nMetairie\tLA\t162429\nBoise\tID\t154077\nClearwater\tFL\t148659\nSaint Petersburg\tFL\t142044\nSparks\tNV\t141142\nSt. Louis\tMO\t120821\nSt. Petersburg\tFL\t105836\nGoleta\tCA\t98544\nFranklin\tTN\t91686\nCherry Hill\tNJ\t82707\n"}]}},{"text":"%pyspark\n# Task 4: Rank all businesses based on check-in counts\n# Algorithm: Window Function (RANK OVER ORDER BY checkin_count DESC)\n\n# Step 1: Explode checkin_dates and count check-ins per business\ncheckin_counts = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .groupBy(\"business_id\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\"))\n\n# Step 2: Join with business table to get business name\ncheckin_with_info = checkin_counts \\\n    .join(\n        business.select(\n            \"business_id\",\n            F.substring(\"name\", 1, 20).alias(\"business_name\")\n        ),\n        \"business_id\", \"left\"\n    ) \\\n    .filter(F.col(\"business_name\").isNotNull())\n\n# Step 3: Apply window rank function ordered by checkin_count descending\nwindow = Window.orderBy(F.col(\"checkin_count\").desc())\n\nbusiness_ranked = checkin_with_info \\\n    .withColumn(\"rank\", F.rank().over(window)) \\\n    .select(\"rank\", \"business_name\", \"checkin_count\") \\\n    .orderBy(\"rank\") \\\n    .limit(30)\n\nz.show(business_ranked)","user":"anonymous","dateUpdated":"2026-03-24T15:32:38+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"scatterChart":{},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"business_name","index":1,"aggr":"sum"}],"groups":[],"values":[{"name":"checkin_count","index":4,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=38"},{"jobUrl":"http://node-master:4040/jobs/job?id=39"},{"jobUrl":"http://node-master:4040/jobs/job?id=40"},{"jobUrl":"http://node-master:4040/jobs/job?id=41"},{"jobUrl":"http://node-master:4040/jobs/job?id=42"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774334165173_1490658396","id":"paragraph_1774334165173_1490658396","dateCreated":"2026-03-24T14:36:05+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T14:46:15+0800","dateStarted":"2026-03-24T14:46:12+0800","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"rank\tbusiness_name\tcheckin_count\n1\tPhiladelphia Interna\t52144\n2\tCafé Du Monde\t40109\n3\tLouis Armstrong New \t37562\n4\tTampa International \t37518\n5\tNashville Internatio\t31168\n6\tSt. Louis Lambert In\t29606\n7\tRoyal House\t28927\n8\tOceana Grill\t21542\n9\tIndianapolis Interna\t21487\n10\tReading Terminal Mar\t18615\n11\tAcme Oyster House\t15205\n12\tReno-Tahoe Internati\t13420\n13\tThe Jug Handle Inn\t13244\n14\tGrand Sierra Resort \t10478\n15\tRuby Slipper - New O\t10209\n16\tPat O'Brien’s\t10135\n17\tTucson International\t10089\n18\t30th Street Station\t10063\n19\tGumbo Shop\t9574\n20\tThe Original Pierre \t9464\n21\tLuke\t9390\n22\tMother's Restaurant\t9034\n23\tCochon Butcher\t8855\n24\tCochon\t8503\n25\tLafitte's Blacksmith\t8092\n26\tPeppermill Reno\t7887\n27\tHattie B’s Hot Chick\t7848\n28\t101 Taiwanese Cuisin\t7739\n29\tBoise Airport\t7639\n30\tSilver Legacy Resort\t7515\n"}]}},{"text":"%pyspark\n# Task 5: Calculate month-over-month (MoM) check-in growth rate\n# for the top 50 restaurants in a specific city to identify trending locations\n# Algorithm: Window Function (LAG OVER PARTITION BY business_id ORDER BY year, month)\n# MoM Growth = (current_month - previous_month) / previous_month * 100\n\nTARGET_CITY = \"Philadelphia\"\n\n# Step 1: Get top 50 restaurants in target city by total check-ins\ntop50 = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .groupBy(\"business_id\") \\\n    .agg(F.count(\"*\").alias(\"total_checkins\")) \\\n    .join(\n        business.filter(\n            (F.col(\"city\") == TARGET_CITY) &\n            (F.col(\"categories\").like(\"%Restaurants%\"))\n        ).select(\"business_id\",\n                 F.substring(\"name\", 1, 20).alias(\"business_name\")),\n        \"business_id\", \"inner\"\n    ) \\\n    .orderBy(F.col(\"total_checkins\").desc()) \\\n    .limit(50)\n\ntop50_ids = [row[\"business_id\"] for row in top50.collect()]\n\n# Step 2: Get monthly check-in counts for these top 50\nmonthly = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .withColumn(\"ts\", F.to_timestamp(F.trim(F.col(\"date\")))) \\\n    .withColumn(\"year\",  F.year(\"ts\")) \\\n    .withColumn(\"month\", F.month(\"ts\")) \\\n    .filter(F.col(\"business_id\").isin(top50_ids)) \\\n    .groupBy(\"business_id\", \"year\", \"month\") \\\n    .agg(F.count(\"*\").alias(\"monthly_checkins\"))\n\n# Step 3: Apply LAG window function to get previous month checkins\nwindow = Window.partitionBy(\"business_id\").orderBy(\"year\", \"month\")\n\nmom_growth = monthly \\\n    .withColumn(\"prev_checkins\", F.lag(\"monthly_checkins\").over(window)) \\\n    .withColumn(\"mom_growth_pct\",\n        F.round(\n            (F.col(\"monthly_checkins\") - F.col(\"prev_checkins\")) /\n            F.col(\"prev_checkins\") * 100, 2)\n    ) \\\n    .join(top50.select(\"business_id\", \"business_name\"), \"business_id\") \\\n    .filter(F.col(\"prev_checkins\").isNotNull()) \\\n    .select(\"business_name\", \"year\", \"month\",\n            \"monthly_checkins\", \"prev_checkins\", \"mom_growth_pct\") \\\n    .orderBy(F.col(\"mom_growth_pct\").desc()) \\\n    .limit(30)\n\nprint(f\"--- MoM Check-in Growth Rate: Top 50 Restaurants in {TARGET_CITY} ---\")\nz.show(mom_growth)","user":"anonymous","dateUpdated":"2026-03-24T14:55:57+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"year","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=63"},{"jobUrl":"http://node-master:4040/jobs/job?id=64"},{"jobUrl":"http://node-master:4040/jobs/job?id=65"},{"jobUrl":"http://node-master:4040/jobs/job?id=66"},{"jobUrl":"http://node-master:4040/jobs/job?id=67"},{"jobUrl":"http://node-master:4040/jobs/job?id=68"},{"jobUrl":"http://node-master:4040/jobs/job?id=69"},{"jobUrl":"http://node-master:4040/jobs/job?id=70"},{"jobUrl":"http://node-master:4040/jobs/job?id=71"},{"jobUrl":"http://node-master:4040/jobs/job?id=72"},{"jobUrl":"http://node-master:4040/jobs/job?id=73"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774334240867_1912742057","id":"paragraph_1774334240867_1912742057","dateCreated":"2026-03-24T14:37:20+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T14:54:29+0800","dateStarted":"2026-03-24T14:54:20+0800","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"--- MoM Check-in Growth Rate: Top 50 Restaurants in Philadelphia ---\n"},{"type":"TABLE","data":"business_name\tyear\tmonth\tmonthly_checkins\tprev_checkins\tmom_growth_pct\nShake Shack\t2012\t6\t157\t1\t15600.0\nTalula's Daily\t2013\t8\t33\t2\t1550.0\nE Mei Restaurant\t2019\t9\t15\t1\t1400.0\nSpice 28\t2012\t8\t77\t7\t1000.0\nSabrina's Café\t2020\t8\t11\t1\t1000.0\nSampan\t2010\t7\t32\t3\t966.67\nNan Zhou Hand Drawn \t2021\t1\t10\t1\t900.0\nSampan\t2020\t7\t9\t1\t800.0\nHan Dynasty\t2010\t7\t9\t1\t800.0\nFrankford Hall\t2019\t2\t17\t2\t750.0\nThe Dandelion\t2020\t8\t8\t1\t700.0\nThe Dandelion\t2020\t12\t7\t1\t600.0\nNan Zhou Hand Drawn \t2010\t7\t7\t1\t600.0\nValanni\t2019\t1\t7\t1\t600.0\nKhyber Pass Pub\t2010\t12\t32\t5\t540.0\nDalessandro’s Steaks\t2010\t7\t6\t1\t500.0\nDi Bruno Bros.\t2021\t12\t6\t1\t500.0\nMixto\t2021\t6\t6\t1\t500.0\nGood Dog Bar\t2017\t10\t12\t2\t500.0\nHan Dynasty\t2021\t9\t6\t1\t500.0\nE Mei Restaurant\t2017\t10\t18\t3\t500.0\nDim Sum Garden\t2010\t8\t11\t2\t450.0\nE Mei Restaurant\t2012\t5\t16\t3\t433.33\nGeno's Steaks\t2017\t2\t21\t4\t425.0\nElixr Coffee Roaster\t2011\t2\t50\t10\t400.0\nGood Dog Bar\t2020\t7\t5\t1\t400.0\nElixr Coffee Roaster\t2020\t7\t5\t1\t400.0\nValanni\t2010\t11\t5\t1\t400.0\nOyster House\t2021\t2\t5\t1\t400.0\nJim's South St\t2010\t4\t5\t1\t400.0\n"}]}},{"text":"%pyspark\n# Task 6: Analyze review seasonality by cuisine\n# Identify which month has the highest volume of reviews/check-ins\n# for specific seasonal categories (e.g. Ice Cream vs Soup)\n# Algorithm: Group by month and cuisine category to find seasonal peaks\n\nSEASONAL_CATEGORIES = [\"Ice Cream\", \"Soup\"]\n\n# Step 1: Explode checkin dates and get month\ncheckin_seasonal = checkin \\\n    .withColumn(\"date\", F.explode(F.split(\"checkin_dates\", \",\"))) \\\n    .withColumn(\"month\", F.month(F.to_timestamp(F.trim(F.col(\"date\"))))) \\\n    .filter(F.col(\"month\").isNotNull()) \\\n    .groupBy(\"business_id\", \"month\") \\\n    .agg(F.count(\"*\").alias(\"checkin_count\"))\n\n# Step 2: Join with business to filter by seasonal categories\n# Explode categories to match each one individually\nbiz_seasonal = business \\\n    .select(\"business_id\", \"name\",\n            F.explode(F.split(\"categories\", \",\")).alias(\"category\")) \\\n    .withColumn(\"category\", F.trim(F.col(\"category\"))) \\\n    .filter(F.col(\"category\").isin(SEASONAL_CATEGORIES))\n\n# Step 3: Join and aggregate by category and month\nseasonality = checkin_seasonal \\\n    .join(biz_seasonal.select(\"business_id\", \"category\"),\n          \"business_id\", \"inner\") \\\n    .groupBy(\"category\", \"month\") \\\n    .agg(F.sum(\"checkin_count\").alias(\"total_checkins\")) \\\n    .withColumn(\"month_name\",\n        F.when(F.col(\"month\") == 1,  \"01-Jan\")\n        .when(F.col(\"month\") == 2,  \"02-Feb\")\n        .when(F.col(\"month\") == 3,  \"03-Mar\")\n        .when(F.col(\"month\") == 4,  \"04-Apr\")\n        .when(F.col(\"month\") == 5,  \"05-May\")\n        .when(F.col(\"month\") == 6,  \"06-Jun\")\n        .when(F.col(\"month\") == 7,  \"07-Jul\")\n        .when(F.col(\"month\") == 8,  \"08-Aug\")\n        .when(F.col(\"month\") == 9,  \"09-Sep\")\n        .when(F.col(\"month\") == 10, \"10-Oct\")\n        .when(F.col(\"month\") == 11, \"11-Nov\")\n        .when(F.col(\"month\") == 12, \"12-Dec\")\n    ) \\\n    .select(\"category\", \"month_name\", \"total_checkins\") \\\n    .orderBy(\"category\", \"month_name\")\n\nprint(\"--- Seasonality: Ice Cream vs Soup ---\")\nz.show(seasonality)","user":"anonymous","dateUpdated":"2026-03-24T15:31:47+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"1":{"graph":{"mode":"lineChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"month_name","index":1,"aggr":"sum"}],"groups":[{"name":"category","index":0,"aggr":"sum"}],"values":[{"name":"total_checkins","index":2,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=74"},{"jobUrl":"http://node-master:4040/jobs/job?id=75"},{"jobUrl":"http://node-master:4040/jobs/job?id=76"},{"jobUrl":"http://node-master:4040/jobs/job?id=77"},{"jobUrl":"http://node-master:4040/jobs/job?id=78"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774335260552_1001233229","id":"paragraph_1774335260552_1001233229","dateCreated":"2026-03-24T14:54:20+0800","status":"FINISHED","focus":false,"dateFinished":"2026-03-24T14:57:19+0800","dateStarted":"2026-03-24T14:57:11+0800","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"--- Seasonality: Ice Cream vs Soup ---\n"},{"type":"TABLE","data":"category\tmonth_name\ttotal_checkins\nSoup\t01-Jan\t17899\nSoup\t02-Feb\t16657\nSoup\t03-Mar\t18432\nSoup\t04-Apr\t17132\nSoup\t05-May\t17739\nSoup\t06-Jun\t17164\nSoup\t07-Jul\t18307\nSoup\t08-Aug\t18456\nSoup\t09-Sep\t16956\nSoup\t10-Oct\t17796\nSoup\t11-Nov\t16689\nSoup\t12-Dec\t17613\n"}]}},{"text":"%pyspark\n","user":"anonymous","dateUpdated":"2026-03-24T14:57:11+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774335431278_1982509506","id":"paragraph_1774335431278_1982