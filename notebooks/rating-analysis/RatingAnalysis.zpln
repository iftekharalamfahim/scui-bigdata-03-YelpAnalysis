{"paragraphs":[{"text":"%pyspark\r\nfrom pyspark.sql import functions as F\r\nfrom pyspark.sql.window import Window\r\n\r\n# Load all tables from Hive\r\nbusiness = spark.table(\"yelp.business\")\r\nreview   = spark.table(\"yelp.review\")\r\ncheckin  = spark.table(\"yelp.checkin\")\r\nusers    = spark.table(\"yelp.users\")\r\n\r\n# Register as temp views\r\nbusiness.createOrReplaceTempView(\"business\")\r\nreview.createOrReplaceTempView(\"review\")\r\ncheckin.createOrReplaceTempView(\"checkin\")\r\nusers.createOrReplaceTempView(\"users\")\r\n\r\nprint(\"=== Row Counts ===\")\r\nprint(\"business :\", business.count())\r\nprint(\"review   :\", review.count())\r\nprint(\"checkin  :\", checkin.count())\r\nprint(\"users    :\", users.count())\r\n\r\nprint(\"\\n=== Review Sample ===\")\r\nreview.show(3)","user":"anonymous","dateUpdated":"2026-03-23T17:26:58+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"=== Row Counts ===\nbusiness : 150346\nreview   : 131930\ncheckin  : 131930\nusers    : 1987897\n\n=== Review Sample ===\n+---------+-----------+--------------------+---------+----------+---------+--------+--------+--------------------+----------+\n|review_id|rev_user_id|     rev_business_id|rev_stars|rev_useful|rev_funny|rev_cool|rev_text|       rev_timestamp|  rev_date|\n+---------+-----------+--------------------+---------+----------+---------+--------+--------+--------------------+----------+\n|     NULL|       NULL|---kPU91CF4Lq2-Wl...|     NULL|      NULL|     NULL|    NULL|    NULL|2020-03-13 21:10:...|2020-03-13|\n|     NULL|       NULL|--0iUa4sNDFiZFrAd...|     NULL|      NULL|     NULL|    NULL|    NULL|2010-09-13 21:43:...|2010-09-13|\n|     NULL|       NULL|--30_8IhuyMHbSOcN...|     NULL|      NULL|     NULL|    NULL|    NULL|2013-06-14 23:29:...|2013-06-14|\n+---------+-----------+--------------------+---------+----------+---------+--------+--------+--------------------+----------+\nonly showing top 3 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=91"},{"jobUrl":"http://node-master:4040/jobs/job?id=92"},{"jobUrl":"http://node-master:4040/jobs/job?id=93"},{"jobUrl":"http://node-master:4040/jobs/job?id=94"},{"jobUrl":"http://node-master:4040/jobs/job?id=95"},{"jobUrl":"http://node-master:4040/jobs/job?id=96"},{"jobUrl":"http://node-master:4040/jobs/job?id=97"},{"jobUrl":"http://node-master:4040/jobs/job?id=98"},{"jobUrl":"http://node-master:4040/jobs/job?id=99"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774253392811_523556808","id":"paragraph_1774253392811_523556808","dateCreated":"2026-03-23T16:09:52+0800","dateStarted":"2026-03-23T17:26:58+0800","dateFinished":"2026-03-23T17:27:21+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n\n# Task 1: Analyze the distribution of ratings (1-5 stars)\n\nrating_dist = review.groupBy(\"rev_stars\") \\\n    .count() \\\n    .withColumnRenamed(\"rev_stars\", \"star_rating\") \\\n    .withColumnRenamed(\"count\", \"review_count\") \\\n    .withColumn(\"percentage\",\n        F.round(F.col(\"review_count\") * 100.0 /\n        review.count(), 2)) \\\n    .orderBy(\"star_rating\")\n\nrating_dist.show()\nz.show(rating_dist)","user":"anonymous","dateUpdated":"2026-03-23T20:03:40+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":262.9451599121094,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"star_rating","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}},"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"star_rating","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-----------+------------+----------+\n|star_rating|review_count|percentage|\n+-----------+------------+----------+\n|          1|     1069561|      15.3|\n|          2|      544240|      7.79|\n|          3|      691934|       9.9|\n|          4|     1452918|     20.78|\n|          5|     3231627|     46.23|\n+-----------+------------+----------+\n\n"},{"type":"TABLE","data":"star_rating\treview_count\tpercentage\n1\t1069561\t15.3\n2\t544240\t7.79\n3\t691934\t9.9\n4\t1452918\t20.78\n5\t3231627\t46.23\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=147"},{"jobUrl":"http://node-master:4040/jobs/job?id=148"},{"jobUrl":"http://node-master:4040/jobs/job?id=149"},{"jobUrl":"http://node-master:4040/jobs/job?id=150"},{"jobUrl":"http://node-master:4040/jobs/job?id=151"},{"jobUrl":"http://node-master:4040/jobs/job?id=152"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774253442079_1654643558","id":"paragraph_1774253442079_1654643558","dateCreated":"2026-03-23T16:10:42+0800","dateStarted":"2026-03-23T20:01:24+0800","dateFinished":"2026-03-23T20:02:29+0800","status":"FINISHED"},{"text":"%pyspark\n\n# Task 2: Analyze the weekly rating frequency (Monday to Sunday)\n\nweekly_rating = review \\\n    .withColumn(\"day_of_week\",\n        F.when(F.dayofweek(\"rev_date\") == 2, \"1-Mon\")\n        .when(F.dayofweek(\"rev_date\") == 3, \"2-Tue\")\n        .when(F.dayofweek(\"rev_date\") == 4, \"3-Wed\")\n        .when(F.dayofweek(\"rev_date\") == 5, \"4-Thu\")\n        .when(F.dayofweek(\"rev_date\") == 6, \"5-Fri\")\n        .when(F.dayofweek(\"rev_date\") == 7, \"6-Sat\")\n        .when(F.dayofweek(\"rev_date\") == 1, \"7-Sun\")\n    ) \\\n    .filter(F.col(\"rev_date\").isNotNull()) \\\n    .groupBy(\"day_of_week\") \\\n    .agg(\n        F.count(\"*\")                    .alias(\"review_count\"),\n        F.round(F.avg(\"rev_stars\"), 3)  .alias(\"avg_rating\")\n    ) \\\n    .orderBy(\"day_of_week\")\n\nz.show(weekly_rating)","user":"anonymous","dateUpdated":"2026-03-23T20:50:42+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"day_of_week","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"day_of_week\treview_count\tavg_rating\n1-Mon\t1030129\t3.72\n2-Tue\t943417\t3.753\n3-Wed\t945565\t3.77\n4-Thu\t917648\t3.778\n5-Fri\t942156\t3.767\n6-Sat\t1065456\t3.751\n7-Sun\t1145909\t3.712\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=157"},{"jobUrl":"http://node-master:4040/jobs/job?id=158"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774253672794_113633948","id":"paragraph_1774253672794_113633948","dateCreated":"2026-03-23T16:14:32+0800","dateStarted":"2026-03-23T20:50:42+0800","dateFinished":"2026-03-23T20:51:09+0800","status":"FINISHED"},{"text":"%pyspark\n# Task 3: Identify the top businesses with the most five-star ratings\n\ntop_five_star = review \\\n    .filter(F.col(\"rev_stars\") == 5) \\\n    .join(business, review.rev_business_id == business.business_id) \\\n    .groupBy(F.substring(business.name, 1, 20).alias(\"business_name\")) \\\n    .agg(F.count(\"review_id\").alias(\"five_star_count\")) \\\n    .orderBy(F.col(\"five_star_count\").desc()) \\\n    .limit(20)\n\nz.show(top_five_star)","user":"anonymous","dateUpdated":"2026-03-23T21:24:06+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"five_star_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"business_name\tfive_star_count\nStarbucks\t5877\nFirst Watch\t4550\nReading Terminal Mar\t4019\nOceana Grill\t4012\nAcme Oyster House\t3979\nHattie B’s Hot Chick\t3958\nLos Agaves\t3496\nChick-fil-A\t3473\nRuby Slipper Cafe\t3360\nCommander's Palace\t3095\nRuby Slipper - New O\t3075\nPappy's Smokehouse\t2675\nCochon Butcher\t2625\nCochon\t2434\nPeg's Glorified Ham \t2375\nLuke\t2365\nSabrina's Café\t2317\nZahav\t2282\nBiscuit Love: Gulch\t2272\nEnterprise Rent-A-Ca\t2269\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=175"},{"jobUrl":"http://node-master:4040/jobs/job?id=176"},{"jobUrl":"http://node-master:4040/jobs/job?id=177"},{"jobUrl":"http://node-master:4040/jobs/job?id=178"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774253853555_1914216467","id":"paragraph_1774253853555_1914216467","dateCreated":"2026-03-23T16:17:33+0800","dateStarted":"2026-03-23T21:21:40+0800","dateFinished":"2026-03-23T21:22:11+0800","status":"FINISHED"},{"text":"%pyspark\n# Task 4: Identify the top 10 cities with the highest ratings\n\ntop_cities = business \\\n    .filter(F.col(\"city\").isNotNull() & F.col(\"stars\").isNotNull()) \\\n    .groupBy(\"city\") \\\n    .agg(\n        F.round(F.avg(\"stars\"), 3)  .alias(\"avg_rating\"),\n        F.count(\"business_id\")      .alias(\"merchant_count\")\n    ) \\\n    .filter(F.col(\"merchant_count\") >= 50) \\\n    .orderBy(F.col(\"avg_rating\").desc()) \\\n    .limit(10)\n\nz.show(top_cities)","user":"anonymous","dateUpdated":"2026-03-23T21:29:55+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":309.7039489746094,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"city","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"avg_rating","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"city\tavg_rating\tmerchant_count\nMontecito\t4.156\t93\nSafety Harbor\t4.129\t139\nSanta Barbara\t4.051\t3829\nSaint Pete Beach\t4.026\t57\nCarpinteria\t4.017\t298\nGulfport\t4.0\t115\nLambertville\t3.984\t124\nWebster Groves\t3.937\t111\nTampa Bay\t3.936\t141\nCollingswood\t3.926\t169\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=179"},{"jobUrl":"http://node-master:4040/jobs/job?id=180"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774255101232_1356690189","id":"paragraph_1774255101232_1356690189","dateCreated":"2026-03-23T16:38:21+0800","dateStarted":"2026-03-23T21:25:49+0800","dateFinished":"2026-03-23T21:25:53+0800","status":"FINISHED"},{"text":"%pyspark\n# Task 5: Calculate the rating differential\n# Algorithm: Window Function (AVG OVER PARTITION BY city, cuisine)\n\nCUISINE_LIST = [\n    'American', 'Mexican', 'Italian', 'Japanese', 'Chinese', 'Thai',\n    'Mediterranean', 'French', 'Vietnamese', 'Greek', 'Indian',\n    'Korean', 'Hawaiian', 'African', 'Spanish', 'Middle Eastern'\n]\n\n# Step 1: Explode categories so each cuisine gets its own row per business\nbiz_exploded = business \\\n    .filter(\n        F.col(\"categories\").isNotNull() &\n        F.col(\"stars\").isNotNull() &\n        F.col(\"city\").isNotNull()\n    ) \\\n    .select(\n        \"business_id\",\n        F.substring(\"name\", 1, 25).alias(\"business_name\"),\n        \"city\",\n        \"state\",\n        \"stars\",\n        F.explode(F.split(\"categories\", \",\")).alias(\"cuisine\")\n    ) \\\n    .withColumn(\"cuisine\", F.trim(F.col(\"cuisine\"))) \\\n    .filter(F.col(\"cuisine\").isin(CUISINE_LIST))\n\n# Step 2: Compute each merchant's actual average from review table\nmerchant_avg = review \\\n    .groupBy(\"rev_business_id\") \\\n    .agg(F.round(F.avg(\"rev_stars\"), 3).alias(\"merchant_avg_rating\"))\n\n# Step 3: Join merchant avg ratings with exploded business cuisine data\nbiz_with_avg = biz_exploded.join(\n    merchant_avg,\n    biz_exploded.business_id == merchant_avg.rev_business_id,\n    \"left\"\n).drop(\"rev_business_id\")\n\n# Step 4: Window function — compute overall cuisine average within each city\nwindow = Window.partitionBy(\"city\", \"cuisine\")\n\nrating_diff = biz_with_avg \\\n    .withColumn(\n        \"city_cuisine_avg\",\n        F.round(F.avg(\"merchant_avg_rating\").over(window), 3)\n    ) \\\n    .withColumn(\n        \"rating_differential\",\n        F.round(F.col(\"merchant_avg_rating\") - F.avg(\"merchant_avg_rating\").over(window), 3)\n    ) \\\n    .select(\n        \"business_name\",\n        \"cuisine\",\n        \"city\",\n        \"state\",\n        F.round(\"merchant_avg_rating\", 2).alias(\"merchant_avg_stars\"),\n        \"city_cuisine_avg\",\n        \"rating_differential\"\n    ) \\\n    .filter(F.col(\"merchant_avg_rating\").isNotNull()) \\\n    .orderBy(F.col(\"rating_differential\").desc()) \\\n    .limit(30)\n\nz.show(rating_diff)","user":"anonymous","dateUpdated":"2026-03-23T21:51:45+0800","progress":0,"config":{"lineNumbers":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"fontSize":9,"title":false,"results":{"0":{"graph":{"mode":"multiBarChart","height":412.7251434326172,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[{"name":"cuisine","index":1,"aggr":"sum"}],"values":[{"name":"city","index":1,"aggr":"sum"}]}},"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"cuisine","index":1,"aggr":"sum"}]}}},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"--- Top 30 Merchants ABOVE their City/Cuisine Average ---\n"},{"type":"TABLE","data":"business_name\tcuisine\tcity\tstate\tmerchant_avg_stars\tcity_cuisine_avg\trating_differential\nEl Checo Mexican Food\tMexican\tSahuarita\tAZ\t5.0\t2.99\t2.01\nOlive Branch Cafe\tItalian\tMarrero\tLA\t4.17\t2.236\t1.933\nAngelo's Picnic Pizza & I\tItalian\tAntioch\tTN\t4.38\t2.582\t1.799\nAntonella's Italian Kitch\tItalian\tRosemont\tPA\t4.69\t2.901\t1.79\nSabroso Cocina Mexicana\tMexican\tSaint Ann\tMO\t5.0\t3.231\t1.769\nIl Forno\tItalian\tNashville\tTN\t5.0\t3.255\t1.745\nD'Mexican\tMexican\tSaint Petersburg\tFL\t4.78\t3.068\t1.71\nTwo Guys Cookin\tMexican\tMeridian\tID\t4.83\t3.126\t1.707\nNapoletano Brothers\tItalian\tSpringfield\tPA\t4.84\t3.135\t1.704\nEl Jarocho Mexican Store \tMexican\tValley Park\tMO\t4.93\t3.235\t1.698\nInn Between\tMexican\tGranite City\tIL\t4.6\t2.903\t1.697\nRed Oven Wood Fired Pizza\tItalian\tFlorissant\tMO\t4.71\t3.022\t1.692\nPortofino\tItalian\tIndianapolis\tIN\t5.0\t3.317\t1.683\nTaco De Oro\tMexican\tLutz\tFL\t4.9\t3.217\t1.679\nMama Yang and Daughter\tChinese\tNashville\tTN\t4.9\t3.219\t1.676\nTaco Station\tMexican\tSmyrna\tTN\t5.0\t3.325\t1.675\nCafe Ditali's\tItalian\tHarvey\tLA\t4.6\t2.931\t1.669\nMawi Tortillerias\tMexican\tMetairie\tLA\t4.71\t3.044\t1.668\ntaqueria la cañada\tMexican\tBrandon\tFL\t4.82\t3.168\t1.656\nLilly's Panaderia\tMexican\tSaint Louis\tMO\t4.92\t3.275\t1.642\nLa Michoacána\tMexican\tMetairie\tLA\t4.68\t3.044\t1.638\nTacos Mobile Primo\tMexican\tBoise\tID\t5.0\t3.373\t1.627\nBronco Tacos\tMexican\tBoise\tID\t5.0\t3.373\t1.627\nWetos Locos\tMexican\tBoise\tID\t5.0\t3.373\t1.627\nLos Reyes De La Torta\tMexican\tBoise\tID\t5.0\t3.373\t1.627\nSi Señor Mexican Bar and \tMexican\tArnold\tMO\t4.42\t2.796\t1.624\nFrida Urban Taqueria\tMexican\tEdmonton\tAB\t4.89\t3.277\t1.612\nTaqueria el Pollito Expre\tMexican\tLa Vergne\tTN\t4.75\t3.139\t1.611\nTaqueria Luna's\tMexican\tHermitage\tTN\t4.88\t3.274\t1.607\nThe Cafe\tMexican\tLanghorne\tPA\t4.09\t2.483\t1.604\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=185"},{"jobUrl":"http://node-master:4040/jobs/job?id=186"},{"jobUrl":"http://node-master:4040/jobs/job?id=187"},{"jobUrl":"http://node-master:4040/jobs/job?id=188"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774255544559_1686464909","id":"paragraph_1774255544559_1686464909","dateCreated":"2026-03-23T16:45:44+0800","dateStarted":"2026-03-23T21:47:41+0800","dateFinished":"2026-03-23T21:48:23+0800","status":"FINISHED","focus":false},{"text":"%pyspark\n# Task 6: Compare weekend vs weekday satisfaction for the Nightlife category\n# Weekend = Saturday(7) and Sunday(1) in Spark dayofweek function\n\n# Step 1: Filter Nightlife businesses\nnightlife_biz = business.filter(F.col(\"categories\").like(\"%Nightlife%\"))\n\n# Step 2: Join with reviews\nnightlife_reviews = review \\\n    .join(nightlife_biz, review.rev_business_id == nightlife_biz.business_id) \\\n    .filter(F.col(\"rev_date\").isNotNull())\n\n# Part A: Weekend vs Weekday summary\nnightlife_summary = nightlife_reviews \\\n    .withColumn(\"day_type\",\n        F.when(F.dayofweek(\"rev_date\").isin(1, 7), \"Weekend\")\n        .otherwise(\"Weekday\")) \\\n    .groupBy(\"day_type\") \\\n    .agg(\n        F.count(\"review_id\")            .alias(\"review_count\"),\n        F.round(F.avg(\"rev_stars\"), 3)  .alias(\"avg_rating\")\n    ) \\\n    .orderBy(\"day_type\")\n\nprint(\"--- Weekend vs Weekday ---\")\nz.show(nightlife_summary)\n\n# Part B: Daily breakdown\nnightlife_daily = nightlife_reviews \\\n    .withColumn(\"day_of_week\",\n        F.when(F.dayofweek(\"rev_date\") == 2, \"1-Mon\")\n        .when(F.dayofweek(\"rev_date\") == 3, \"2-Tue\")\n        .when(F.dayofweek(\"rev_date\") == 4, \"3-Wed\")\n        .when(F.dayofweek(\"rev_date\") == 5, \"4-Thu\")\n        .when(F.dayofweek(\"rev_date\") == 6, \"5-Fri\")\n        .when(F.dayofweek(\"rev_date\") == 7, \"6-Sat\")\n        .when(F.dayofweek(\"rev_date\") == 1, \"7-Sun\")\n    ) \\\n    .groupBy(\"day_of_week\") \\\n    .agg(\n        F.count(\"review_id\")            .alias(\"review_count\"),\n        F.round(F.avg(\"rev_stars\"), 3)  .alias(\"avg_rating\")\n    ) \\\n    .orderBy(\"day_of_week\")\n\nprint(\"--- Daily Breakdown ---\")\nz.show(nightlife_daily)","user":"anonymous","dateUpdated":"2026-03-23T22:34:53+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"scatterChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"scatterChart":{},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"business_name","index":0,"aggr":"sum"}],"groups":[],"values":[]}},"1":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"day_type","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}},"3":{"graph":{"mode":"lineChart","height":300,"optionOpen":false,"setting":{"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"day_of_week","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"review_count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"--- Weekend vs Weekday ---\n"},{"type":"TABLE","data":"day_type\treview_count\tavg_rating\nWeekday\t1012962\t3.825\nWeekend\t526795\t3.728\n"},{"type":"TEXT","data":"\n--- Daily Breakdown ---\n"},{"type":"TABLE","data":"day_of_week\treview_count\tavg_rating\n1-Mon\t235534\t3.77\n2-Tue\t197381\t3.837\n3-Wed\t195633\t3.846\n4-Thu\t188810\t3.851\n5-Fri\t195604\t3.834\n6-Sat\t240849\t3.764\n7-Sun\t285946\t3.698\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://node-master:4040/jobs/job?id=189"},{"jobUrl":"http://node-master:4040/jobs/job?id=190"},{"jobUrl":"http://node-master:4040/jobs/job?id=191"},{"jobUrl":"http://node-master:4040/jobs/job?id=192"},{"jobUrl":"http://node-master:4040/jobs/job?id=193"},{"jobUrl":"http://node-master:4040/jobs/job?id=194"},{"jobUrl":"http://node-master:4040/jobs/job?id=195"},{"jobUrl":"http://node-master:4040/jobs/job?id=196"},{"jobUrl":"http://node-master:4040/jobs/job?id=197"},{"jobUrl":"http://node-master:4040/jobs/job?id=198"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774255763808_410070804","id":"paragraph_17742557638